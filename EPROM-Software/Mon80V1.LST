Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
M72-80  Z80

    1                   	.Z80
    2                   ;---------------------------------------------------------------
    3                   ;Monitor fuer MC-Computer Platine SYS-80 und SYS-80s
    4                   ;Assembliert mit Z80ASM von SLR Systems wegen der langen
    5                   ;Label die mit einigen anderen Assemblern nicht moeglich sind.
    6                   ;
    7                   ;Erstellt 05/2026 von U. Haumann
    8                   ;Enthaelt weitgehend Routinen aus RDK Monitor 1.1 850129
    9                   ;V7.2 851216, sowie Teile aus dem Monitor von Donn Stewart 
   10                   ;fuer den "CPU-Ville" Z80 Computer.
   11                   ;Treiber fuer Serielle Schnittstelle auf CPU-Platine mit UART 8251
   12                   ;implementiert.
   13                   ;Flo1 und Flo2 waehlber auf Hardware Basis Adresse 0C0h.
   14                   ;Der Mointor erwartet 64KB Ram Memory. Er darf selbst nicht
   15                   ;groesser als 4KB werden, es sein denn man schiebt die MON_ADR
   16                   ;und CCP weiter nach unten. Der CPM Bereich verkleinert sich dann.
   17                   ;Der Monitor kopiert sich nach Reset an das Speicherende
   18                   ;auf den Wert in MON_ADR und gibt den unteren RAM Bereich frei.
   19                   ;Dies wird auf der SYS CPU Platine mit einem Lesebefehl auf
   20                   ;Adresse 7000h erreicht. Das Eprom ist dann ausgeblendet.
   21                   ;Somit steht der Speicher durchgaengig ab 0000h bis zu MON_ADR
   22                   ;zur Verfuehgung.
   23                   ;Das CPM BIOS fuer den MC-Computer ueberschreibt den Monitorbereich
   24                   ;ab FC00h. Alle relevanten Teile f|r den Betrieb des Rechners 
   25                   ;muessen vor FC00h plaziert werden.
   26                   ;----------------------------------------------------------------
   27                   ;
   28         0000      					org 0000h
   29                   					; IM ROM AUF ADRESSE 0
   30 0000              BEGINN:
   31 0000  31 FFFF     	LD SP,0FFFFH 		;DUMMY-LOAD 
   32 0003  3E C9       	LD A,0C9H 			;ABLAGE RET-BEFEHL
   33 0005  32 F000     	LD (0F000H),A 		;AUF ZIELADRESSE
   34 0008  CD F000     	CALL 0F000H 		;FESTSTELLEN
   35 000B              ANF:					;DER EIGENEN ADRESSE,
   36 000B  3B          	DEC SP  			;UM START VON BELIEBIGER
   37 000C  3B          	DEC SP  			;STELLE AUS ZU ERMOEGLICHEN
   38 000D  D1          	POP DE  			;FUER TESTS SEHR GUT
   39 000E  21 0012     	LD HL,HAUPTP-ANF
   40 0011  19          	ADD HL,DE
   41 0012  11 F000     	LD DE,0F000H 		;TRANSPORT ALLER ZELLEN
   42 0015  01 0FFF     	LD BC,0FFFH 		;4K TRANSFER
   43 0018  ED B0       	LDIR  			;EIGENTLICH ZUVIEL,ABER
   44 001A  C3 F000     	JP 0F000H 			;STOERT NICHT WEITER
   45                   
   46 001D              HAUPTP:				;DISTANZ-MERKER
   47                   
   48                   	.PHASE 0F000H 		;START DES MONITORS
   49                   					;CODE DENOCH HINTER BOOT BEREICH
   50                   
   51                   		; --- START DES EIGENTLICHEN MONITORS ---
   52                   
   53         000D      	CR 	EQU 0DH
   54         000A      	LF 	EQU 0AH
   55         0007      	BELL	EQU 7
   56         00FF      	RUB 	EQU 0FFH
   57         0000      	FIL 	EQU 0
   58         0007      	MAX	EQU 7
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
M72-80  Z80

   59         001B      	ESC	EQU 1BH
   60                   
   61         0038      	RST7 EQU 38H
   62                   					; ANFANG VERSCHIEBBAR
   63                   					; der Vektor RST7 wird fuer Breakpoints gebraucht
   64                   	;
   65                   ;Adressen des Seriell Port MC Computer OUT SIO/PIO Karte
   66                   ;
   67         00F0      	sa_dat	EQU 0F0H			;SIO A Daten
   68         00F1      	sa_sts	EQU 0F1H			;SIO A Control
   69         00F2      	sb_dat	EQU 0F2H			;SIO B Daten
   70         00F3      	sb_sts	EQU 0F3H			;SIO B Control
   71         0001      	s_rxb		EQU 01h			;SIO RX Ready Bit
   72         0004      	s_txb		EQU 04h			;SIO TX Ready Bit
   73                   ;
   74                   ;Adressen des Seriell Port UART 8251 auf SYS-80s CPU Karte
   75                   ;bei SYS-1 oder SYS-80 sind die entsprechenden Daten der
   76                   ;SIO A einzutragen, siehe Auskommentierung
   77                   ;
   78                   ;	u_dat		EQU sa_dat			;SIO A Daten
   79                   ;	u_sts		EQU sa_sts			;SIO A Control
   80                   ;	u_rxb		EQU s_rxb			;RX Ready Bit SIO-A
   81                   ;	u_txb		EQU s_txb			;TX Ready Bit SIO-A
   82                   ;
   83                   ; Serieller Port A ist auf den UART SYS-80s umgeleitet
   84                   ;
   85         0020      	u_dat		EQU 020H			;UART 8251 Daten
   86         0021      	u_sts		EQU 021H			;UART 8251 Control
   87         0002      	u_rxb		EQU 002h			;RX Ready Bit UART 8251
   88         0001      	u_txb		EQU 001h			;TX Ready Bit UART 8251
   89                   ;
   90                   ;Adressen IDE Port CF-80 Karte
   91                   ;
   92         0018      	IDEDATA	EQU 018h			;IDE Daten Register
   93         001A      	SECCND	EQU 01ah			;Sector Count Register
   94         001B      	LBA7		EQU 01bh			;LBA Bits 0-7
   95         001C      	LBA15		EQU 01ch			;LBA Bits 8-15
   96         001D      	LBA23		EQU 01dh			;LBA Bits 16-23
   97         001E      	IDEHEAD	EQU 01eh			;IDE Drive Head Register
   98         001F      	IDESTAT	EQU 01fh			;IDE Command/Status Register
   99                   ;
  100                   
  101                   
  102                   		;* VEKTOR TABELLE *
  103                   		; CSTS 0FFH IN A, FALLS ZEICHEN DA
  104                   		; IOCHK IN A AKTUELLE IO-KONFIGURATION
  105                   		; IOSET VERAENDERN, IO IN C-REG
  106                   		; MEMCK IN B HIGH IN A LOW MEMORY
  107                   		; TRAP/BREAKPOINT ENTRY
  108                   
  109                   
  110                   		; --- START DES MONITORPROGRAMMS ---
