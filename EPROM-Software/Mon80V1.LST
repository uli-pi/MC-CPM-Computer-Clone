  204 F09F  FE 04       	CP 00000100B 
  205 F0A1  C2 F13D     	JP NZ,USERRI
  206 F0A4              LXLPI:		;AR=P
  207 F0A4  DB F3       	IN A,(sb_sts)
  208 F0A6  E6 01       	AND s_rxb
  209 F0A8  28 FA       	JR Z,LXLPI
  210 F0AA  DB F2       	IN A,(sb_dat)
  211 F0AC  C9          	RET
