  952                   ;
  953                   ; +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  954                   ;
  955                   ;Subroutine to read one IDE/ATA Disk sector (256 bytes)
  956                   ;Address to place data passed in HL
  957                   ;LBA bits 0 to 7 passed in C, bits 8 to 15 passed in B
  958                   ;LBA bits 16 to 23 passed in E
  959                   ;
  960 F588              ide_read:
  961 F588  DB 1F       rd_status_loop_1:	in	a,(IDESTAT)	;check status
  962 F58A  E6 80       			and	80h				;check BSY bit
  963 F58C  C2 F588     			jp	nz,rd_status_loop_1	;loop until not busy
  964 F58F  DB 1F       rd_status_loop_2:	in	a,(IDESTAT)	;check	status
  965 F591  E6 40       			and	40h				;check DRDY bit
  966 F593  CA F58F     			jp	z,rd_status_loop_2	;loop until ready
  967 F596  3E 01       			ld	a,01h				;number of sectors = 1
  968 F598  D3 1A       			out	(SECCND),a			;sector count register
  969 F59A  79          			ld	a,c
  970 F59B  D3 1B       			out	(LBA7),a			;lba bits 0 - 7
  971 F59D  78          			ld	a,b
  972 F59E  D3 1C       			out	(LBA15),a			;lba bits 8 - 15
  973 F5A0  7B          			ld	a,e
  974 F5A1  D3 1D       			out	(LBA23),a			;lba bits 16 - 23
  975 F5A3  3E E0       			ld	a,11100000b		;LBA mode, select drive 0
  976 F5A5  D3 1E       			out	(IDEHEAD),a			;drive/head register
  977 F5A7  3E 20       			ld	a,20h				;Read sector command
  978 F5A9  D3 1F       			out	(IDESTAT),a
  979 F5AB  DB 1F       rd_wait_for_DRQ_set:	in	a,(IDESTAT)	;read status
  980 F5AD  E6 08       			and	08h				;DRQ bit
  981 F5AF  CA F5AB     			jp	z,rd_wait_for_DRQ_set	;loop until bit set
  982 F5B2  DB 1F       rd_wait_for_BSY_clear:	in	a,(IDESTAT)
  983 F5B4  E6 80       			and	80h
  984 F5B6  C2 F5B2     			jp	nz,rd_wait_for_BSY_clear
  985 F5B9  DB 1F       			in	a,(IDESTAT)		;clear INTRQ
  986 F5BB  DB 18       read_loop:		in	a,(IDEDATA)		;get data
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  18
