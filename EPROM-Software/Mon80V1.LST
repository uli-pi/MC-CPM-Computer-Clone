  570 F20D  3E FF       	ld a,0ffh
  571 F20F  32 F403     	ld (drvat),a 		; Drive ungueltig
  572 F212  C9          	ret 
  573                   ;
  574         0038      	intvek equ 38h 		; Interruptziel
