  532                   ;
  533                   		; FLO4    als Leseport
  534                   		;
  535                   		; 7 6 5 4 3 2 1 0
  536                   		;
  537                   		; DRQ   INTRQ   headld x      x x x x
  538                   		; 0=request
  539                   		;      0=request
  540                   		;  1=head down
  541                   		;
  542                   
  543                   
  544                   		; FLO4    als Schreibport
  545                   		;
  546                   		; 7 6 5 4 3 2 1 0
  547                   		;
  548                   		; sso moton mini dense d c b a
  549                   		;
  550                   		; 1=Seite 1
  551                   		; 0=Motor an
  552                   		;  1=Minilaufwerk
  553                   		;   1=Single Dense
  554                   		;    -------------------------
  555                   		;                                      1=Laufwerk an
  556                   		;
  557                   
  558                   		; Bei einem Interrupt wird an diese Stelle gesprungen
  559                   		; Der Interrupt erfolgt vom Floppy-Controller
  560                   
  561 F202              intex:				; Das INT-Program arbeitet nicht als Unterprogramm
  562 F202  F1          	pop af  			; alte Ret-Adresse vernichten
  563 F203  DB C0       	in a,(flo) 		; Status lesen und INT loeschen
  564 F205  FB          	ei  				; Interrupt wieder freigeben
  565 F206  ED 4D       	reti  			; zurueck zum vorherigen Aufrufer
  566                   
