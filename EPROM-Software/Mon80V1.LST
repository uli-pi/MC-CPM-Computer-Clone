  525                   ;
  526         00C0      	flo equ 0c0h 		; Basisadresse Floppy-Controller
  527         00C0      	flo0 equ 0c0h   	
  528         00C1      	flo1 equ 0c1h
  529         00C2      	flo2 equ 0c2h
  530         00C3      	flo3 equ 0c3h
