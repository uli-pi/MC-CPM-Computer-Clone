  990 F5C1  E6 08       			and	08h				;DRQ bit
  991 F5C3  C2 F5BB     			jp	nz,read_loop		;loop until cleared
  992 F5C6  C9          			ret
  993                   ;
  994                   ;Subroutine to write one IDE/ATA Disk sector (256 bytes)
  995                   ;Address of data to write to disk passed in HL
  996                   ;LBA bits 0 to 7 passed in C, bits 8 to 15 passed in B
  997                   ;LBA bits 16 to 23 passed in E
  998                   ;
  999 F5C7              ide_write:
 1000 F5C7              wr_status_loop_1:	
 1001 F5C7  DB 1F       			in	a,(IDESTAT)		;check status
 1002 F5C9  E6 80       			and	80h				;check BSY bit
 1003 F5CB  C2 F5C7     			jp	nz,wr_status_loop_1	;loop until not busy
 1004 F5CE              wr_status_loop_2:
 1005 F5CE  DB 1F       			in	a,(IDESTAT)		;check status
 1006 F5D0  E6 40       			and	40h				;check DRDY bit
 1007 F5D2  CA F5CE     			jp	z,wr_status_loop_2	;loop until ready
 1008 F5D5  3E 01       			ld	a,01h				;number of sectors = 1
 1009 F5D7  D3 1A       			out	(SECCND),a			;sector count register
 1010 F5D9  79          			ld	a,c
 1011 F5DA  D3 1B       			out	(LBA7),a			;lba bits 0 - 7
 1012 F5DC  78          			ld	a,b
 1013 F5DD  D3 1C       			out	(LBA15),a			;lba bits 8 - 15
 1014 F5DF  7B          			ld	a,e
 1015 F5E0  D3 1D       			out	(LBA23),a			;lba bits 16 - 23
 1016 F5E2  3E E0       			ld	a,11100000b		;LBA mode, select drive 0
 1017 F5E4  D3 1E       			out	(IDEHEAD),a		;drive/head register
 1018 F5E6  3E 30       			ld	a,30h				;Write sector command
 1019 F5E8  D3 1F       			out	(IDESTAT),a
 1020 F5EA              wr_wait_for_DRQ_set:
 1021 F5EA  DB 1F       			in	a,(IDESTAT)		;read status
 1022 F5EC  E6 08       			and	08h				;DRQ bit
 1023 F5EE  CA F5EA     			jp	z,wr_wait_for_DRQ_set	;loop until bit set			
 1024 F5F1              write_loop:	
 1025 F5F1  7E          			ld	a,(hl)
 1026 F5F2  D3 18       			out	(IDEDATA),a		;write data
 1027 F5F4  23          			inc	hl
 1028 F5F5  DB 1F       			in	a,(IDESTAT)		;read status
 1029 F5F7  E6 08       			and	08h				;check DRQ bit
 1030 F5F9  C2 F5F1     			jp	nz,write_loop		;write until bit cleared
 1031 F5FC              wr_wait_for_BSY_clear:
 1032 F5FC  DB 1F       			in	a,(IDESTAT)
 1033 F5FE  E6 80       			and	80h
 1034 F600  C2 F5FC     			jp	nz,wr_wait_for_BSY_clear
 1035 F603  DB 1F       			in	a,(IDESTAT)		;clear INTRQ
 1036 F605  C9          			ret
