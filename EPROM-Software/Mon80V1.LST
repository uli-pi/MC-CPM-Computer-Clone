  140                   ; --- Sprungtabelle, um mit FLOMON kompatibel zu sein(NDR-Computer).
  141                   ;
  142 F03F    000D      	defs 13 	; f033,34,35,36,37,38,39,3a,3b,3c,3d,3e,3f
  143                   					; BASIS F040h
  144 F04C  C3 F06A     	jp illegal 		; loeschen alle seiten
  145 F04F  C3 F06A     	jp illegal     		; loeschen unsichtbar
  146 F052  C3 F06A     	jp illegal 		; moveto hl=x de=y
  147 F055  C3 F06A     	jp illegal 		; drawto hl=x de=y
  148 F058  C3 F06A     	jp illegal 		; c=schreibseite 0,1,2,3
  149 F05B  C3 F06A     	jp illegal 		; c=leseseite    0,1,2,3
  150 F05E  C3 F06A     	jp illegal      	; c=rmwmode      0=norm 1=rmw
  151 F061  C3 F06A     	jp illegal 		; warten bis gdp fertig
  152 F064  C3 F06A     	jp illegal        	; c=befehl fuer gdp  ACHTUNG in C-Register nicht A
  153 F067  C3 F06A     	jp illegal 		; hl=quelle,de=ziel,c=bank quelle, b=bank ziel
  154                   					; carry wenn bankram auf f000h nicht da ist
  155                   ; --- Ende Sprungtabelle ---
  156                   
  157 F06A              illegal:
  158 F06A  3E FF       	ld a,0ffh
  159 F06C  37          	scf
  160 F06D  C9          	ret  				; Mit Fehler beenden
  161                   ;
  162 F06E              RESTA1:
  163 F06E  C3 FCF1     	JP RESTA 			;kann kurzgeschlossen werden
  164                   ;					;nach freemem ueberschreibung
  165 F071              BEGIN:
  166 F071  C3 F693     	JP BEGIN1 			;kurzschliessen ggf.
  167                   ;					;ende fixed gebiet
  168                   ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  169                   ; IO Routinen
  170                   ;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  171                   ; write_string gibt einen 0 terminierten string aus
  172                   ; String Adresse wird in HL uebergeben
  173 F074              write_string:		
  174 F074  DB 21       	in 	a,(u_sts)		;read status
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
M72-80  Z80

  175 F076  E6 01       	and 	u_txb			;check TxRDY bit
  176 F078  CA F074     	jp 	z,write_string	;loop if not set
  177 F07B  7E          	ld 	a,(hl)		;get char from string
  178 F07C  A7          	and 	a			;check if 0
  179 F07D  C8          	ret 	z			;alles ausgegeben, dann zurueck
  180 F07E  D3 20       	out 	(u_dat),a		;no, write char to output
  181 F080  23          	inc 	hl			;next char in string
  182 F081  C3 F074     	jp 	write_string	;start over
  183                   ;
  184                   ; --- CI MAIN ROUTINE ---
  185 F084              CI:
  186 F084  3A F14C     	LD A,(IOBYT)
  187 F087  E6 03       	AND 3 			;CONSOLMASKE
  188 F089  20 09       	JR NZ,CI1 			;ANDERE DEVICES
  189 F08B              TTYIN:
  190 F08B  DB 21       	IN A,(u_sts)
  191 F08D  E6 02       	AND u_rxb
  192 F08F  28 FA       	JR Z,TTYIN
  193 F091  DB 20       	IN A,(u_dat)
  194 F093  C9          	RET
  195                   
  196 F094              CI1:
  197 F094  C3 F13A     	JP USERCI  		;DORT SPRUNG MOEGLICH
  198                   ;
  199                   ; --- RI ROUTINE ---
