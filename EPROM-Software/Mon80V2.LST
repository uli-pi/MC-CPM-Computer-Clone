  531                    
  532                   ; bei Maxi wird die Seite 1 mit Seitenpruefung auf 0
  533                   ; angesprochen, bei Mini mit Seitenpruefung auf 1.
  534                   ; nur fuer SD
  535                   
  536                   ; c=0,1,2,3
  537                   ; 	0,2 gekoppelt  1,3 gekoppelt					
  538                   
  539 F1A9  CD F1AF     MAXI:	CALL SCODA	; coding 1
  540 F1AC  C3 F213     	JP FLOP		; sso-flag auf 0 setzen, jedoch stepflag
  541                   			; gueltig wenn bit 7 gesetzt.
  542                   
  543                   ;------------------------------------------------------------------------------
  544                   ; Maxi Disk recoding of drive and side for Special Register 4
  545                   ; 0 -> 11 (drive 1, side 0, Maxi)
  546                   ; 1 -> 91 (drive 1, side 1, Maxi)
  547                   ; 2 -> 12 (drive 2, side 0, Maxi)
  548                   ; 3 -> 92 (drive 2, side 1, Maxi)
  549                   
  550 F1AF  79          SCODA:	LD A,C  	; SD MAXI
  551 F1B0  E6 03       	AND 3  		; muss Bereich 0..3 sein
  552 F1B2  FE 00       	CP 0  		; 0 seite 0
  553 F1B4  20 03       	JR NZ,SCODA1
  554                   	
  555 F1B6  0E 11       	LD C,00010001B 	; LW 1
  556 F1B8  C9          	RET
  557                   
  558 F1B9  FE 01       SCODA1:	CP 1
  559 F1BB  20 03       	JR NZ,SCODA2
  560                   	
  561 F1BD  0E 12       	LD C,00010010B 	; LW 2 seite 0
  562 F1BF  C9          	RET
  563                   
  564 F1C0  FE 02       SCODA2:	CP 2
  565 F1C2  20 03       	JR NZ,SCODA3
  566                   	
  567 F1C4  0E 91       	LD C,10010001B 	; LW 1 seite 1
  568 F1C6  C9          	RET
  569                   
  570 F1C7  0E 92       SCODA3:	LD C,10010010B 	; LW 2 seite 1
  571 F1C9  C9          	RET
  572                   
  573                   ;------------------------------------------------------------------------------
  574                   ; Mini Disk recoding of drive and side for Special Register 4
  575                   ; 0 -> 01 (drive 1, side 0, Mini)
  576                   ; 1 -> 81 (drive 1, side 1, Mini)
  577                   ; 2 -> 02 (drive 2, side 0, Mini)
  578                   ; 3 -> 82 (drive 2, side 1, Mini)
  579                   
  580                   ; hier ist eine Erweiterung f|r Laufwerke C und D notwendig
  581                   
  582 F1CA  E6 03       SCODB:	AND 3  		; 0,1,2,3 erlaubt
  583 F1CC  FE 00       	CP 0
  584 F1CE  20 03       	JR NZ,SCODB1
  585                   	
  586 F1D0  0E 01       	LD C,00000001B 	; LW 1 seite 0
  587 F1D2  C9          	RET
  588                   
