 1088                   ;------------------------------------------------------------------------------
 1089                   ; Write one IDE/CF-card sector (256 bytes)
 1090                   ;
 1091                   ; Address of data in HL
 1092                   ; LBA bits 0 to 7 passed in C
 1093                   ; LBA bits 8 to 15 passed in B
 1094                   ; LBA bits 16 to 23 passed in E
 1095                   
 1096 F5C7              IDEWR:
 1097 F5C7  DB 1F       IDEWR1:	IN	A,(IDESTAT)	; check status
 1098 F5C9  E6 80       	AND	80H		; check BSY bit
 1099 F5CB  C2 F5C7     	JP	NZ,IDEWR1	; loop until not busy
 1100                   
 1101 F5CE  DB 1F       IDEWR2:	IN	A,(IDESTAT)	; check status
 1102 F5D0  E6 40       	AND	40H		; check DRDY bit
 1103 F5D2  CA F5CE     	JP	Z,IDEWR2	; loop until ready
 1104                   
 1105 F5D5  3E 01       	LD	A,01H		; number of sectors = 1
 1106 F5D7  D3 1A       	OUT	(SECCND),A	; sector count register
 1107 F5D9  79          	LD	A,C
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  20
