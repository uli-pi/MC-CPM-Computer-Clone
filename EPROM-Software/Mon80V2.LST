  556                   ;==============================================================================
  557                   ; Floppy-Unterprogramme fuer FLO2
  558                   ; verwendet 1797 als Controller
  559                   ; Version 1.0   840506
  560                   ; Rolf-Dieter Klein (C) 1984 Muenchen
  561                   ;
  562                   ; Die Routinen ermoeglichen sowohl den Anschluss von Mini-,Mikro- als auch
  563                   ; von Maxi-Laufwerken. Die Routinen muessen im RAM stehen, da die Buffer
  564                   ; am Ende stehen. Alle Buffer sind jedoch gesammelt.
  565                   
  566                   ; FLO4    als Leseport
  567                   ;
  568                   ; 7 6 5 4 3 2 1 0
  569                   ;
  570                   ; DRQ   INTRQ   headld x      x x x x
  571                   ; 0=request
  572                   ;      0=request
  573                   ;  1=head down
  574                   ;
  575                   
  576                   ; FLO4    als Schreibport
  577                   ;
  578                   ; 7 6 5 4 3 2 1 0
  579                   ;
  580                   ; sso moton mini dense d c b a
  581                   ;
  582                   ; 1=Seite 1
  583                   ; 0=Motor an
  584                   ;  1=Minilaufwerk
  585                   ;   1=Single Dense
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  11
MON80V2 Z80

  586                   ;    -------------------------
  587                   ;      1=Laufwerk an
  588                   
  589         00C0      FLO	EQU 0C0H 		; Basisadresse Floppy-Controller
  590                   ;FLO0	EQU 0C0H   	
  591                   ;FLO1	EQU 0C1H
  592                   ;FLO2	EQU 0C2H
  593                   ;FLO3	EQU 0C3H
  594                   ;FLO4	EQU 0C4H 		; Port fuer Zusatzstatus etc.
  595                   
  596                   	; Bei einem Interrupt wird an diese Stelle gesprungen
  597                   	; Der Interrupt erfolgt vom Floppy-Controller
  598                   
  599 F202              intex:	; Das INT-Program arbeitet nicht als Unterprogramm
  600 F202  F1          	POP AF  		; alte Ret-Adresse vernichten
  601 F203  DB C0       	IN A,(FLO) 		; Status lesen und INT loeschen
  602 F205  FB          	EI  			; Interrupt wieder freigeben
  603 F206  ED 4D       	RETI  			; zurueck zum vorherigen Aufrufer
  604                   
  605                   ;------------------------------------------------------------------------------
  606                   
  607 F208              iniflp:				; Floppy Routinen Init
  608 F208  3E 02       	LD A,2  		; 3= langsamste Steprate
  609 F20A  32 F3FA     	LD (STEPRATE),A		; einstellen, kein SSO
  610 F20D  3E FF       	LD A,0FFH
  611 F20F  32 F403     	LD (DRVAT),A 		; Drive ungueltig
  612 F212  C9          	RET 
  613                   
  614                   ;------------------------------------------------------------------------------
  615                   
  616         0038      intvek	EQU 38h 		; Interruptziel
  617                   
  618 F213              flop:				; Haupteingang der Floppy-Routinen
  619 F213  AF          	XOR A  			; sso-Flag auf 0 setzen
  620 F214              flop1:				; a=sso flag, nur 2 zunlaessig
  621 F214  32 F3FB     	LD (SSOFLAG),A 		; ok setzen hier moeglich
  622                   				; hl = Ziel oder Quelladresse
  623                   				; E= Sektor D= Track
  624                   				; C= Laufwerkscode+Dichtecode+Seite
  625                   				; B= 0 dann Steprate setzen+SSO-Flag
  626                   				;  = 1 dann lesen
  627                   				;  = 2 dann schreiben
  628                   
  629 F217  F5          cflo1:	PUSH AF			; entscheiden FLO1 oder FLO2
  630 F218  3A F587     	LD A,(FLOC0)
  631                   	; IF A=1 -> FLO1
  632 F21B  FE 01       	CP 1  
  633 F21D  C2 F226     	JP NZ,CFLO2
  634                   	
  635                   	; FLO1
  636 F220  79          	LD A,C
  637 F221  E6 BF       	AND 10111111B 		; kein autowait 
  638 F223  EE 10       	XOR 10H 		; invertieren Dichtebit fuer FLO1
  639 F225  4F          	LD C,A
  640                   	; ENDIF
  641                   
  642 F226  F1          cflo2:	POP AF
  643 F227  ED 73 F3FC  	LD (SP0),SP 		; Stack umsetzen, da Tiefe ggf zu gross
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  12
MON80V2 Z80

  644 F22B  31 F478     	LD SP,TSTACK 		; fuer BDOS
  645                   
  646 F22E  3E D0       	LD A,0D0H
  647 F230  D3 C0       	OUT (FLO),A 		; Floppy-Controller ruecksetzen
  648 F232  3A 0038     	LD A,(INTVEK)
  649 F235  32 F3FE     	LD (LOCINT),A
  650 F238  3E C3       	LD A,0C3H 		; JP-Befehl
  651 F23A  32 0038     	LD (INTVEK),A
  652 F23D  E5          	PUSH HL 		; Ziel, Quelladresse
  653 F23E  2A 0039     	LD HL,(INTVEK+1)
  654 F241  22 F3FF     	LD (LOCINT+1),HL
  655 F244  21 F202     	LD HL,INTEX 		; JP INTEX ablegen auf intvek
  656 F247  22 0039     	LD (INTVEK+1),HL
  657 F24A  E1          	POP HL
  658 F24B  DB C0       	IN A,(FLO)		; Status - Port
  659 F24D  ED 56       	IM 1  			; Mode 1 einstellen
  660 F24F  FB          	EI  			; Interrupt freigeben
  661 F250  CD F2FB     	CALL SOFTEX
  662 F253  F3          	DI  			; Sperren Int
  663 F254  F5          	PUSH AF 		; Status
  664 F255  3A F3FE     	LD A,(LOCINT)
  665 F258  32 0038     	LD (INTVEK),A 		; zurueckspeichern
  666 F25B  E5          	PUSH HL
  667 F25C  2A F3FF     	LD HL,(LOCINT+1)
  668 F25F  22 0039     	LD (INTVEK+1),HL
  669 F262  E1          	POP HL
  670 F263  F1          	POP AF
  671 F264  ED 7B F3FC  	LD SP,(SP0) 		; und wieder user-stack verwenden
  672 F268  C9          	RET
