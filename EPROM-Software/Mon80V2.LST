 1073                   ;==============================================================================
 1074                   ; IDE/CF card interface
 1075                   ;
 1076                   ; Read one IDE/CF card sector (256 bytes)
 1077                   ;
 1078                   ; Address for data in HL
 1079                   ; LBA bits 0 to 7 passed in C
 1080                   ; LBA bits 8 to 15 passed in B
 1081                   ; LBA bits 16 to 23 passed in E
 1082                   
 1083 F588              IDERD:
 1084 F588  DB 1F       IDERD1:	IN	A,(IDESTAT)	; check status
 1085 F58A  E6 80       	AND	80H		; check BSY bit
 1086 F58C  C2 F588     	JP	NZ,IDERD1	; loop until not busy
 1087                   
 1088 F58F  DB 1F       IDERD2:	IN	A,(IDESTAT)	; check	status
 1089 F591  E6 40       	AND	40H		; check DRDY bit
 1090 F593  CA F58F     	JP	Z,IDERD2	; loop until ready
 1091                   
 1092 F596  3E 01       	LD	A,01H		; number of sectors = 1
 1093 F598  D3 1A       	OUT	(SECCND),A	; sector count register
 1094 F59A  79          	LD	A,C
 1095 F59B  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1096 F59D  78          	LD	A,B
 1097 F59E  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1098 F5A0  7B          	LD	A,E
 1099 F5A1  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1100 F5A3  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1101 F5A5  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1102 F5A7  3E 20       	LD	A,20H		; Read sector command
 1103 F5A9  D3 1F       	OUT	(IDESTAT),A
 1104                   
 1105 F5AB              IDERD3:	; wait for drq set
 1106 F5AB  DB 1F       	IN	A,(IDESTAT)	; read status
 1107 F5AD  E6 08       	AND	08H		; DRQ bit
 1108 F5AF  CA F5AB     	JP	Z,IDERD3	; loop until bit set
 1109                   	
 1110 F5B2              IDERD4:	; wait for busy clear
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  20
MON80V2 Z80

 1111 F5B2  DB 1F       	IN	A,(IDESTAT)
 1112 F5B4  E6 80       	AND	80H
 1113 F5B6  C2 F5B2     	JP	NZ,IDERD4
 1114                   	
 1115 F5B9  DB 1F       	IN	A,(IDESTAT)	; clear INTRQ
 1116                   
 1117 F5BB              IDERD5: ; read loop
 1118 F5BB  DB 18       	IN	A,(IDEDATA)	; get data
 1119 F5BD  77          	LD	(HL),A
