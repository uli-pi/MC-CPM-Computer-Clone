  488                   ; nur fuer bestehende BIOS-Routinen gedacht
  489                    
  490                   ; bei Maxi wird die Seite 1 mit Seitenpruefung auf 0
  491                   ; angesprochen, bei Mini mit Seitenpruefung auf 1.
  492                   ; nur fuer SD
  493                   
  494                   ; c=0,1,2,3
  495                   ; 	0,2 gekoppelt  1,3 gekoppelt					
  496                   
  497 F1A9  CD F1AF     MAXI:	CALL SCODA	; coding 1
  498 F1AC  C3 F213     	JP FLOP		; sso-flag auf 0 setzen, jedoch stepflag
  499                   			; gueltig wenn bit 7 gesetzt.
  500                   
  501                   ;------------------------------------------------------------------------------
  502                   
  503 F1AF  79          SCODA:	LD A,C  	; SD MAXI
  504 F1B0  E6 03       	AND 3  		; muss Bereich 0..3 sein
  505 F1B2  FE 00       	CP 0  		; 0 seite 0
  506 F1B4  20 03       	JR NZ,SCODA1
  507                   	
  508 F1B6  0E 11       	LD C,00010001B 	; LW 1
  509 F1B8  C9          	RET
  510                   
  511 F1B9  FE 01       SCODA1:	CP 1
  512 F1BB  20 03       	JR NZ,SCODA2
  513                   	
  514 F1BD  0E 12       	LD C,00010010B 	; LW 2 seite 0
  515 F1BF  C9          	RET
  516                   
  517 F1C0  FE 02       SCODA2:	CP 2
  518 F1C2  20 03       	JR NZ,SCODA3
  519                   	
  520 F1C4  0E 91       	LD C,10010001B 	; LW 1 seite 1
  521 F1C6  C9          	RET
  522                   
  523 F1C7  0E 92       SCODA3:	LD C,10010010B 	; LW 2 seite 1
  524 F1C9  C9          	RET
  525                   
  526                   ;------------------------------------------------------------------------------
  527                   
  528 F1CA  E6 03       SCODB:	AND 3  		; 0,1,2,3 erlaubt
  529 F1CC  FE 00       	CP 0
  530 F1CE  20 03       	JR NZ,SCODB1
