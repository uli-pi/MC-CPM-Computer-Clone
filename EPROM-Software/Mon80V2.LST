  589 F1D3  FE 01       SCODB1:	CP 1
  590 F1D5  20 03       	JR NZ,SCODB2
  591                   	
  592 F1D7  0E 81       	LD C,10000001B 	; LW 1 seite 1
  593 F1D9  C9          	RET
  594                   
  595 F1DA  FE 02       SCODB2:	CP 2
  596 F1DC  20 03       	JR NZ,SCODB3
  597                   	
  598 F1DE  0E 02       	LD C,00000010B 	; LW 2 seite 0
  599 F1E0  C9          	RET
