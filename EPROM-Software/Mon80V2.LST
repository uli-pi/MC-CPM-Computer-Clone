Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
MON80V2 Z80

    1                   	.Z80
    2                   ;---------------------------------------------------------------
    3                   ;Monitor fuer MC-Computer Platine SYS-80 und SYS-80s
    4                   ;Assembliert mit Z80ASM von SLR Systems wegen der langen
    5                   ;Label die mit einigen anderen Assemblern nicht moeglich sind.
    6                   ;
    7                   ;Erstellt 05/2026 von U. Haumann
    8                   ;Enthaelt weitgehend Routinen aus RDK Monitor 1.1 850129
    9                   ;V7.2 851216, sowie Teile aus dem Monitor von Donn Stewart 
   10                   ;fuer den "CPU-Ville" Z80 Computer.
   11                   ;Treiber fuer Serielle Schnittstelle auf CPU-Platine mit UART 8251
   12                   ;implementiert.
   13                   ;Flo1 und Flo2 waehlber auf Hardware Basis Adresse 0C0h.
   14                   ;Der Mointor erwartet 64KB Ram Memory. Er darf selbst nicht
   15                   ;groesser als 4KB werden, es sein denn man schiebt die MON_ADR
   16                   ;und CCP weiter nach unten. Der CPM Bereich verkleinert sich dann.
   17                   ;Der Monitor kopiert sich nach Reset an das Speicherende
   18                   ;auf den Wert in MON_ADR und gibt den unteren RAM Bereich frei.
   19                   ;Dies wird auf der SYS CPU Platine mit einem Lesebefehl auf
   20                   ;Adresse 7000h erreicht. Das Eprom ist dann ausgeblendet.
   21                   ;Somit steht der Speicher durchgaengig ab 0000h bis zu MON_ADR
   22                   ;zur Verfuehgung.
   23                   ;Das CPM BIOS fuer den MC-Computer ueberschreibt den Monitorbereich
   24                   ;ab FC00h. Alle relevanten Teile f|r den Betrieb des Rechners 
   25                   ;muessen vor FC00h plaziert werden.
   26                   
   27                   ;------------------------------------------------------------------------------
   28                   
   29         0000      	ORG 0000h		; Im ROM auf Adresse 0
   30                   
   31                   	; Kopieren des ROMs von ROMSTRT nach F000
   32                   
   33 0000  31 FFFF     BEGIN:	LD SP,0FFFFH 		; Stack auf Speicherende
   34 0003  3E C9       	LD A,0C9H 		; RET-Befehl auf F000h speichern
   35 0005  32 F000     	LD (0F000H),A 		; 
   36 0008  CD F000     	CALL 0F000H 		; eigene Speicheradresse ermitteln
   37                   
   38 000B  3B          ANF:	DEC SP  		; Um kopieren von beliebiger Adresse zu
   39 000C  3B          	DEC SP  		; ermoeglichen (fuer Tests)
   40 000D  D1          	POP DE
   41 000E  21 0012     	LD HL,ROMSTRT-ANF
   42 0011  19          	ADD HL,DE		; Quelladresse in HL
   43 0012  11 F000     	LD DE,0F000H 		; Zieladresse in DE
   44 0015  01 0FFF     	LD BC,0FFFH 		; Laenge in BC (4KB - 1)
   45 0018  ED B0       	LDIR  			; 
   46 001A  C3 F000     	JP 0F000H 		; Monitor im ROM aufrufen
   47                   
   48                   ;------------------------------------------------------------------------------
   49                   ; START DES EIGENTLICHEN MONITORS
   50                   
   51 001D              ROMSTRT:	; Start address of Monitor in ROM, before .PHASE!!!
   52                   
   53                   	.PHASE 0F000H
   54                   
   55         000D      CR 	EQU 0DH
   56         000A      LF 	EQU 0AH
   57         0007      BELL	EQU 7
   58         00FF      RUB 	EQU 0FFH
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
MON80V2 Z80

   59         0000      FIL 	EQU 0
   60         0007      MAX	EQU 7
   61         001B      ESC	EQU 1BH
   62                   
   63         0038      RST7	EQU 38H		; der Vektor RST7 wird fuer Breakpoints gebraucht
   64                   
   65                   	; Adressen des seriell Port MC Computer OUT SIO/PIO Karte
   66                   
   67         00F0      SA_DAT	EQU 0F0H	; SIO A Daten
   68         00F1      SA_STS	EQU 0F1H	; SIO A Control
   69         00F2      SB_DAT	EQU 0F2H	; SIO B Daten
   70         00F3      SB_STS	EQU 0F3H	; SIO B Control
   71         0001      S_RXB	EQU 01h		; SIO RX Ready Bit
   72         0004      S_TXB	EQU 04h		; SIO TX Ready Bit
   73                   	
   74                   	; Adressen des Seriell Port UART 8251 auf SYS-80s CPU Karte
   75                   	; bei SYS-1 oder SYS-80 sind die entsprechenden Daten der
   76                   	; SIO A einzutragen, siehe Auskommentierung
   77         0000      	IF 0
   82                   	ENDIF
   83                   
   84                   	; Serial Port A is redirected to UART on SYS-80s
   85                   
   86         0020      U_DAT	EQU 020H	; UART 8251 Daten
   87         0021      U_STS	EQU 021H	; UART 8251 Control
   88         0002      U_RXB	EQU 002h	; RX Ready Bit UART 8251
   89         0001      U_TXB	EQU 001h	; TX Ready Bit UART 8251
   90                   
   91                   	; Address of IDE Port CF-80 card
   92                   
   93         0018      IDEDATA	EQU 018h	; IDE Daten Register
   94         001A      SECCND	EQU 01ah	; Sector Count Register
   95         001B      LBA7	EQU 01bh	; LBA Bits 0-7
   96         001C      LBA15	EQU 01ch	; LBA Bits 8-15
   97         001D      LBA23	EQU 01dh	; LBA Bits 16-23
   98         001E      IDEHEAD	EQU 01eh	; IDE Drive Head Register
   99         001F      IDESTAT	EQU 01fh	; IDE Command/Status Register
  100                   
  101                   ;------------------------------------------------------------------------------
  102                   ; Start of Monitor program, ROM address 0F000h
  103                   
  104 F000  C3 F071     	JP INIT
  105 F003  C3 F084     	JP CI		; Console in
  106 F006  C3 F097     	JP RI		; Reader In
  107 F009  C3 F0AD     	JP CO		; Console Out
  108 F00C  C3 F0C1     	JP POO		; Punch Out
  109 F00F  C3 F0D8     	JP LO		; List Out
  110 F012  C3 F0EF     	JP CSTS		; main status routine, 0FFH IN A, FALLS ZEICHEN DA
  111 F015  C3 F102     	JP IOGET	; get iobyte, IN A AKTUELLE IO-KONFIGURATION
  112 F018  C3 F106     	JP IOSET	; set iobyte, VERAENDERN, IO IN C-REG
  113 F01B  C3 F10B     	JP MEMCK	; IN B HIGH IN A LOW MEMORY
  114                   
  115 F01E              TRAP:	; trap/breakpoint entry
  116                   
  117 F01E  C3 F06E     	JP RSTRT
  118 F021  C3 F213     	JP FLOP	 	; neue Floppy-Schnittstelle rev 1.0
  119 F024  C3 F1A9     	JP MAXI		; FLOPPY EXEC VEKTOR SOFT (alt)
  120 F027  C3 F1E4     	JP MINI		; FLOPPY EXEC VEKTOR MINI (alt)
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
MON80V2 Z80

  121 F02A  C3 F588     	JP IDERD	; IDE Sektor lesen
  122 F02D  C3 F5C7     	JP IDEWR	; IDE Sektor schreiben
  123 F030  C3 F6CA     	JP COLD		; Monitor Cold Start (no Hardware init)
  124 F033  C3 F6FB     	JP WARM		; Monitor Warm Start
  125 F036  C3 F074     	JP WRSTR	; gibt mit 0 terminierten String aus
  126                   
  127 F039  F13A        	DEFW TABSTART 	; TABELLEN-START, USER-BEREICH SPRUNGTABELLE,
  128                   			; IMMER INDIREKT VERWENDEN
  129 F03B  FE30        	DEFW LASTMON 	; ADRESSE LETZTE BELEGTE ZELLE
  130                   			; DES MONITORS DANACH PATCH FREI
  131 F03D  F606        	DEFW FREEMEM 	; Lade-Adresse hinter IO-Gebiet
  132                   
  133                   	; Sprungtabelle, um mit FLOMON kompatibel zu sein (NDR-Computer)
  134                   	
  135 F03F    000D      	DEFS 13 	; f033,34,35,36,37,38,39,3a,3b,3c,3d,3e,3f
  136                   			; BASIS F040h
  137 F04C  C3 F06A     	JP ILLEGAL 	; loeschen alle seiten
  138 F04F  C3 F06A     	JP ILLEGAL     	; loeschen unsichtbar
  139 F052  C3 F06A     	JP ILLEGAL 	; moveto hl=x de=y
  140 F055  C3 F06A     	JP ILLEGAL 	; drawto hl=x de=y
  141 F058  C3 F06A     	JP ILLEGAL 	; c=schreibseite 0,1,2,3
  142 F05B  C3 F06A     	JP ILLEGAL 	; c=leseseite    0,1,2,3
  143 F05E  C3 F06A     	JP ILLEGAL      ; c=rmwmode      0=norm 1=rmw
  144 F061  C3 F06A     	JP ILLEGAL 	; warten bis gdp fertig
  145 F064  C3 F06A     	JP ILLEGAL      ; c=befehl fuer gdp  ACHTUNG in C-Register nicht A
  146 F067  C3 F06A     	JP ILLEGAL 	; hl=quelle,de=ziel,c=bank quelle, b=bank ziel
  147                   			; carry wenn bankram auf f000h nicht da ist
  148                   
  149                   	; --- Ende Sprungtabelle ---
  150                   
  151                   ;------------------------------------------------------------------------------
  152                   
  153 F06A              ILLEGAL:
  154 F06A  3E FF       	LD A,0FFh
  155 F06C  37          	SCF
  156 F06D  C9          	RET  		; return with error
  157                   
  158                   ;------------------------------------------------------------------------------
  159                   
  160 F06E  C3 FCF1     RSTRT:	JP RSTRTB 	; kann kurzgeschlossen werden
  161                   			; nach freemem ueberschreibung
  162 F071  C3 F693     INIT:	JP INIT1 	; kurzschliessen ggf.
  163                   			; ende fixed gebiet
  164                   
  165                   ;==============================================================================
  166                   ; IO Routinen
  167                   ;==============================================================================
  168                   ; output 0-terminated string, address in HL
  169                   
  170 F074  DB 21       WRSTR:	IN  A,(U_STS)	; read status
  171 F076  E6 01       	AND U_TXB	; check TxRDY bit
  172 F078  CA F074     	JP Z,WRSTR	; loop if not set
  173 F07B  7E          	LD A,(HL)	; get char from string
  174 F07C  A7          	AND A		; check if 0
  175 F07D  C8          	RET Z		; alles ausgegeben, dann zurueck
  176 F07E  D3 20       	OUT (U_DAT),A	; no, write char to output
  177 F080  23          	INC HL		; next char in string
  178 F081  C3 F074     	JP WRSTR	; start over
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
