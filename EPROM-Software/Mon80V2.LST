  282 F0B6  E6 01       	AND CO_TXB
  283 F0B8  28 FA       	JR Z,CONO1
  284                   	
  285 F0BA  79          	LD A,C
  286 F0BB  D3 20       	OUT (CO_DAT),A
  287 F0BD  C9          	RET
  288                   
  289 F0BE  C3 F140     CONO2:	JP USERCO		; user device
