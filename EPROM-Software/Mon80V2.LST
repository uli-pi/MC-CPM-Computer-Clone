  974 F327  09          	ADD HL,BC
  975 F328  DB C1       	IN A,(FLO+1) 		; Tracknr
  976 F32A  77          	LD (HL),A 		; und dort ablegen
  977 F32B  C1          	POP BC
  978 F32C  E1          	POP HL
  979                   
