  310                   ; prueft den Speicherbereich und gibt die hoechste verfuegbare Zelle an
  311                   ; MEMCHK IN B HIGH IN A LOW MEMORY
  312                   
  313 F10B  E5          MEMCHK:	PUSH HL
  314 F10C  CD F118     	CALL MEMSIZ
  315 F10F  7D          	LD A,L
  316 F110  D6 3C       	SUB 3CH
  317 F112  30 01       	JR NC,MEMCK1
  318                   
  319 F114  25          	DEC H
  320                   	
  321 F115  44          MEMCK1:	LD B,H
  322 F116  E1          	POP HL
  323 F117  C9          	RET
  324                   
