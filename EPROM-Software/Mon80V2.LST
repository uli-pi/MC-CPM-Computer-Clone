  674                   ;------------------------------------------------------------------------------
  675                   ; Diverse Unterprogramme
  676                   
  677 F269              setup:				; testet ob der Kopf noch
  678                   				; geladen ist und setzt die
  679 F269  06 00       	LD B,0  		; Flag fuer SSO-Bit
  680 F26B  3A F402     	LD A,(CCODE) 		; wenn Bit 7 gesetzt, dann abfragen
  681 F26E  E6 80       	AND 80H
  682 F270  28 11       	JR Z,SET2UP 		; Seite 0, immer mit SSO=0
  683 F272  3A F3FA     	LD A,(STEPRATE) 	; jetzt pruefen ob flags da
  684 F275  E6 80       	AND 80H 		; <>0, dann SSO setzen, wenn seite 1
  685 F277  28 04       	JR Z,SET1UP 		; =0, dann code 0, oder SSOFLAG
  686 F279  06 02       	LD B,2  		; SSO setzen 
  687 F27B  18 06       	JR SET2UP
  688 F27D              set1up:				; pruefen ob SSO-Flag
  689 F27D  3A F3FB     	LD A,(SSOFLAG) 		; ok, 2=Flag
  690 F280  E6 02       	AND 2  			; SSO-Bit
  691 F282  47          	LD B,A  		; 0,2 erlaubt 
  692 F283              set2up:		
  693                   				; entsprechenden Bits
  694 F283  DB C4       	IN A,(FLO+4) 		; Status Port
  695 F285  E6 20       	AND 20H 		; Head-Load Bit
  696 F287  20 04       	JR NZ,NOSET 		; =1 dann Kopf auf Diskette
  697 F289  78          	LD A,B
  698 F28A  F6 04       	OR 4  			; sonst Bitmaske fuer headdown
  699 F28C  C9          	RET
  700 F28D              noset:
  701 F28D  78          	LD A,B
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  13
