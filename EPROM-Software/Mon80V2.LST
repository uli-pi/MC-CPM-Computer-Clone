    2                   	
    3                   	.Z80
    4                   ;---------------------------------------------------------------
    5                   ; Monitor fuer MC-Computer Platine SYS-80 und SYS-80s
    6                   ; Assembliert mit Z80ASM von SLR Systems wegen der langen
    7                   ; Label die mit einigen anderen Assemblern nicht moeglich sind.
    8                   ;
    9                   ; Erstellt 05/2026 von U. Haumann
   10                   ; Enthaelt weitgehend Routinen aus RDK Monitor 1.1 850129
   11                   ; V7.2 851216, sowie Teile aus dem Monitor von Donn Stewart 
   12                   ; fuer den "CPU-Ville" Z80 Computer.
   13                   ; Treiber fuer Serielle Schnittstelle auf CPU-Platine mit UART 8251
   14                   ; implementiert.
   15                   ; Flo1 und Flo2 waehlber auf Hardware Basis Adresse 0C0h.
   16                   ; Der Mointor erwartet 64KB Ram Memory. Er darf selbst nicht
   17                   ; groesser als 4KB werden, es sein denn man schiebt die MON_ADR
   18                   ; und CCP weiter nach unten. Der CPM Bereich verkleinert sich dann.
   19                   ; Der Monitor kopiert sich nach Reset an das Speicherende
   20                   ; auf den Wert in MON_ADR und gibt den unteren RAM Bereich frei.
   21                   ; Dies wird auf der SYS CPU Platine mit einem Lesebefehl auf
   22                   ; Adresse 7000h erreicht. Das Eprom ist dann ausgeblendet.
   23                   ; Somit steht der Speicher durchgaengig ab 0000h bis zu MON_ADR
   24                   ; zur Verfuehgung.
   25                   ; Das CPM BIOS fuer den MC-Computer ueberschreibt den Monitorbereich
   26                   ; ab FC00h. Alle relevanten Teile f|r den Betrieb des Rechners 
   27                   ; muessen vor FC00h plaziert werden.
   28                   
   29                   ; 06/2026 Ueberarbeitet von Detlef Gerhardt
   30                   ; komplette Ueberarbeitung der Labels und sukzessive Kommentierung des Quellcodes.
   31                   ; um nach und nach moeglichst viele Routinen zu verstehen.
   32                   ; Diese Version ist bis auf die Versionsnummer noch binaerkompatibel zu Version 8.0v1
   33                   ; --- Work in progress ---
   34                   
   35                   ;------------------------------------------------------------------------------
   36                   
   37         000D      CR 	EQU 0DH
   38         000A      LF 	EQU 0AH
   39         0007      BELL	EQU 7
   40         00FF      RUB 	EQU 0FFH
   41         0000      FIL 	EQU 0
   42         0007      MAX	EQU 7
   43         001B      ESC	EQU 1BH
   44                   
   45         0038      RST7	EQU 38H		; der Vektor RST7 wird fuer Breakpoints gebraucht
   46                   
   47                   	; Adressen des seriell Port MC Computer OUT SIO/PIO Karte
   48                   
   49         00F0      SA_DAT	EQU 0F0H	; SIO A Daten
   50         00F1      SA_STS	EQU 0F1H	; SIO A Control
   51         00F2      SB_DAT	EQU 0F2H	; SIO B Daten
   52         00F3      SB_STS	EQU 0F3H	; SIO B Control
   53         0001      S_RXB	EQU 01h		; SIO RX Ready Bit
   54         0004      S_TXB	EQU 04h		; SIO TX Ready Bit
   55                   	
   56                   	; Adressen des Seriell Port UART 8251 auf SYS-80s CPU Karte
   57                   	; bei SYS-1 oder SYS-80 sind die entsprechenden Daten der
   58                   	; SIO A einzutragen, siehe Auskommentierung
   59         0000      	IF 0
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page   2
MON80V2 Z80

   64                   	ENDIF
   65                   
   66                   	; Serial Port A is redirected to UART on SYS-80s
   67                   
   68         0020      U_DAT	EQU 020H	; UART 8251 Daten
   69         0021      U_STS	EQU 021H	; UART 8251 Control
   70         0002      U_RXB	EQU 002h	; RX Ready Bit UART 8251
   71         0001      U_TXB	EQU 001h	; TX Ready Bit UART 8251
   72                   
   73                   	; Address of IDE Port CF-80 card
   74                   
   75         0018      IDEDATA	EQU 018h	; IDE Data Register
   76         001A      SECCND	EQU 01Ah	; Sector Count Register
   77         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
   78         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
   79         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
   80         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
   81         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
   82                   
   83                   ;------------------------------------------------------------------------------
   84                   
   85         0000      	ORG 0000h		; start address in ROM
   86                   
   87                   	; Copy Monitor from address ROMSRT in ROM to address F000 in RAM
   88                   
   89 0000  31 FFFF     BEGIN:	LD SP,0FFFFh 		; set Stack to end of memory
   90 0003  3E C9       	LD A,0C9h 		; place RET command at F000h
   91 0005  32 F000     	LD (0F000h),A 		; 
   92 0008  CD F000     	CALL 0F000h 		; and call it
   93                   
   94 000B  3B          BEG:	DEC SP  		; get return address from Stack to calculate
   95 000C  3B          	DEC SP  		; Monitor location in ROM
   96 000D  D1          	POP DE
   97 000E  21 0012     	LD HL,ROMSRT-BEG	; offset from BEG to ROMSRT
   98 0011  19          	ADD HL,DE		; actual Montor address in ROM as source address in HL
   99 0012  11 F000     	LD DE,0F000h 		; dest address in DE
  100 0015  01 0FFF     	LD BC,0FFFh 		; length in BC (4KB - 1)
  101 0018  ED B0       	LDIR  			; copy
  102 001A  C3 F000     	JP 0F000h 		; jump to Monitor in RAM
  103                   
  104                   ;------------------------------------------------------------------------------
  105                   ; Start of Monitor program, ROM address 0F000h
  106                   
  107 001D              ROMSRT:	; Start address of Monitor in ROM
  108                   	; label must be located before .PHASE
  109                   
  110                   	.PHASE 0F000H	; monitor start address in RAM
  111                   
  112 F000  C3 F071     	JP INIT
  113 F003  C3 F084     	JP CONIN	; Console In
  114 F006  C3 F097     	JP READIN	; Reader In (<- SIO B)
  115 F009  C3 F0AD     	JP CONOUT	; Console Out
  116 F00C  C3 F0C1     	JP PUNOUT	; Punch Out (-> SIO B)
  117 F00F  C3 F0D8     	JP LSTOUT	; List Out (-> SIO B)
  118 F012  C3 F0EF     	JP CONSTS	; Get console status, 0FFh in A, if character available
  119 F015  C3 F102     	JP IOGET	; Get iobyte, current configuration in A
  120 F018  C3 F106     	JP IOSET	; Set iobyte, new configuration in C
  121 F01B  C3 F10B     	JP MEMCHK	; High memory in B, low memory in A
