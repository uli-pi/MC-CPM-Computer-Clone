 1071 F5CB  C2 F5C7     	JP	NZ,IDEWR1	; loop until not busy
 1072                   
 1073 F5CE  DB 1F       IDEWR2:	IN	A,(IDESTAT)	; check status
 1074 F5D0  E6 40       	AND	40H		; check DRDY bit
 1075 F5D2  CA F5CE     	JP	Z,IDEWR2	; loop until ready
 1076                   
 1077 F5D5  3E 01       	LD	A,01H		; number of sectors = 1
 1078 F5D7  D3 1A       	OUT	(SECCND),A	; sector count register
 1079 F5D9  79          	LD	A,C
 1080 F5DA  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1081 F5DC  78          	LD	A,B
 1082 F5DD  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1083 F5DF  7B          	LD	A,E
 1084 F5E0  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1085 F5E2  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1086 F5E4  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1087 F5E6  3E 30       	LD	A,30H		; Write sector command
 1088 F5E8  D3 1F       	OUT	(IDESTAT),A
 1089                   	
 1090 F5EA              IDEWR3:	; WAIT FOR DRQ SET
 1091 F5EA  DB 1F       	IN	A,(IDESTAT)	; read status
 1092 F5EC  E6 08       	AND	08H		; DRQ bit
 1093 F5EE  CA F5EA     	JP	Z,IDEWR3	; loop until bit set			
 1094                   
 1095 F5F1              IDEWR4:	; WRITE LOOP
 1096 F5F1  7E          	LD	A,(HL)
 1097 F5F2  D3 18       	OUT	(IDEDATA),A	; write data
 1098 F5F4  23          	INC	HL
 1099 F5F5  DB 1F       	IN	A,(IDESTAT)	; read status
 1100 F5F7  E6 08       	AND	08H		; check DRQ bit
 1101 F5F9  C2 F5F1     	JP	NZ,IDEWR4	; write until bit cleared
 1102                   
