  556                   ;==============================================================================
  557                   ; Floppy-Unterprogramme fuer FLO2
  558                   ; verwendet 1797 als Controller
  559                   ; Version 1.0   840506
  560                   ; Rolf-Dieter Klein (C) 1984 Muenchen
  561                   ;
  562                   ; Die Routinen ermoeglichen sowohl den Anschluss von Mini-,Mikro- als auch
  563                   ; von Maxi-Laufwerken. Die Routinen muessen im RAM stehen, da die Buffer
  564                   ; am Ende stehen. Alle Buffer sind jedoch gesammelt.
  565                   
  566                   ; FLO4    als Leseport
  567                   ;
  568                   ; 7 6 5 4 3 2 1 0
  569                   ;
  570                   ; DRQ   INTRQ   headld x      x x x x
  571                   ; 0=request
  572                   ;      0=request
  573                   ;  1=head down
  574                   ;
  575                   
  576                   ; FLO4    als Schreibport
  577                   ;
  578                   ; 7 6 5 4 3 2 1 0
  579                   ;
  580                   ; sso moton mini dense d c b a
  581                   ;
  582                   ; 1=Seite 1
  583                   ; 0=Motor an
  584                   ;  1=Minilaufwerk
  585                   ;   1=Single Dense
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  11
MON80V2 Z80

  586                   ;    -------------------------
  587                   ;      1=Laufwerk an
  588                   
  589         00C0      FLO	EQU 0C0H 		; Basisadresse Floppy-Controller
  590                   ;FLO0	EQU 0C0H   	
  591                   ;FLO1	EQU 0C1H
  592                   ;FLO2	EQU 0C2H
  593                   ;FLO3	EQU 0C3H
  594                   ;FLO4	EQU 0C4H 		; Port fuer Zusatzstatus etc.
  595                   
  596                   ;------------------------------------------------------------------------------
  597                   ; Bei einem Interrupt wird an diese Stelle gesprungen
  598                   ; Der Interrupt erfolgt vom Floppy-Controller
  599                   
  600 F202              INTEX:	; Das INT-Program arbeitet nicht als Unterprogramm
  601 F202  F1          	POP AF  		; alte Ret-Adresse vernichten
  602 F203  DB C0       	IN A,(FLO) 		; Status lesen und INT loeschen
  603 F205  FB          	EI  			; Interrupt wieder freigeben
  604 F206  ED 4D       	RETI  			; zurueck zum vorherigen Aufrufer
  605                   
  606                   ;------------------------------------------------------------------------------
  607                   
  608 F208              iniflp:				; Floppy Routinen Init
  609 F208  3E 02       	LD A,2  		; 3= langsamste Steprate
  610 F20A  32 F3FA     	LD (STEPRATE),A		; einstellen, kein SSO
  611 F20D  3E FF       	LD A,0FFH
  612 F20F  32 F403     	LD (CURDRV),A 		; Drive ungueltig
  613 F212  C9          	RET 
  614                   
  615                   ;------------------------------------------------------------------------------
  616                   
  617         0038      INTVEK	EQU 38h 		; Interruptziel
  618                   
  619 F213              FLOP:				; Haupteingang der Floppy-Routinen
  620 F213  AF          	XOR A  			; sso-Flag auf 0 setzen
  621 F214              flop1:				; a=sso flag, nur 2 zulaessig
  622 F214  32 F3FB     	LD (SSOFLAG),A 		; ok setzen hier moeglich
  623                   				; HL = Ziel oder Quelladresse
  624                   				; E = Sektor D= Track
  625                   				; C = Laufwerkscode + Dichtecode + Seite
  626                   				; B = 0 dann Steprate setzen + SSO-Flag
  627                   				;   = 1 dann lesen
  628                   				;   = 2 dann schreiben
  629                   
  630 F217  F5          cflo1:	PUSH AF			; entscheiden FLO1 oder FLO2
  631 F218  3A F587     	LD A,(FLOC0)
  632 F21B  FE 01       	CP 1  
  633 F21D  C2 F226     	JP NZ,CFLO2		; -> FLO2
  634                   	
  635                   	; FLO1
  636 F220  79          	LD A,C
  637 F221  E6 BF       	AND 10111111B 		; kein autowait 
  638 F223  EE 10       	XOR 10H 		; invertieren Dichtebit fuer FLO1
  639 F225  4F          	LD C,A
  640                   
  641 F226  F1          CFLO2:	POP AF
  642 F227  ED 73 F3FC  	LD (SP0),SP 		; save user-stack, maybe to deep for BDOS
  643 F22B  31 F478     	LD SP,TSTACK 		;
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  12
MON80V2 Z80

  644                   
  645 F22E  3E D0       	LD A,0D0H
  646 F230  D3 C0       	OUT (FLO),A 		; reset floppy controller
  647                   	
  648                   	; set interrupt vector to INTEX
  649 F232  3A 0038     	LD A,(INTVEK)
  650 F235  32 F3FE     	LD (SAVINT),A
  651 F238  3E C3       	LD A,0C3H 		; JP-Befehl
  652 F23A  32 0038     	LD (INTVEK),A
  653 F23D  E5          	PUSH HL
  654 F23E  2A 0039     	LD HL,(INTVEK+1)
  655 F241  22 F3FF     	LD (SAVINT+1),HL
  656 F244  21 F202     	LD HL,INTEX 		; set to JP INTEX
  657 F247  22 0039     	LD (INTVEK+1),HL
  658 F24A  E1          	POP HL
  659                   	
  660 F24B  DB C0       	IN A,(FLO)		; Status - Port
  661 F24D  ED 56       	IM 1  			; set interrupt mode 1 ->  execure at 38h
  662 F24F  FB          	EI  			; Interrupt freigeben
  663 F250  CD F2FB     	CALL SOFTEX
  664 F253  F3          	DI  			; disable interrupt
  665                   	
  666                   	; restore interrupt vector
  667 F254  F5          	PUSH AF 		; Status
  668 F255  3A F3FE     	LD A,(SAVINT)
  669 F258  32 0038     	LD (INTVEK),A 		; zurueckspeichern
  670 F25B  E5          	PUSH HL
  671 F25C  2A F3FF     	LD HL,(SAVINT+1)
  672 F25F  22 0039     	LD (INTVEK+1),HL
  673 F262  E1          	POP HL
  674 F263  F1          	POP AF
  675 F264  ED 7B F3FC  	LD SP,(SP0) 		; restore user-stack
  676                   	
  677 F268  C9          	RET
  678                   
  679                   ;------------------------------------------------------------------------------
  680                   ; Diverse Unterprogramme
  681                   
  682 F269              setup:				; testet ob der Kopf noch
  683                   				; geladen ist und setzt die
  684 F269  06 00       	LD B,0  		; Flag fuer SSO-Bit
  685 F26B  3A F402     	LD A,(DRVCOD) 		; wenn Bit 7 gesetzt, dann abfragen
  686 F26E  E6 80       	AND 80H
  687 F270  28 11       	JR Z,SET2UP 		; Seite 0, immer mit SSO=0
  688 F272  3A F3FA     	LD A,(STEPRATE) 	; jetzt pruefen ob flags da
  689 F275  E6 80       	AND 80H 		; <>0, dann SSO setzen, wenn seite 1
  690 F277  28 04       	JR Z,SET1UP 		; =0, dann code 0, oder SSOFLAG
  691 F279  06 02       	LD B,2  		; SSO setzen 
  692 F27B  18 06       	JR SET2UP
  693 F27D              set1up:				; pruefen ob SSO-Flag
  694 F27D  3A F3FB     	LD A,(SSOFLAG) 		; ok, 2=Flag
  695 F280  E6 02       	AND 2  			; SSO-Bit
  696 F282  47          	LD B,A  		; 0,2 erlaubt 
  697 F283              set2up:		
  698                   				; entsprechenden Bits
  699 F283  DB C4       	IN A,(FLO+4) 		; Status Port
  700 F285  E6 20       	AND 20H 		; Head-Load Bit
  701 F287  20 04       	JR NZ,NOSET 		; =1 dann Kopf auf Diskette
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  13
MON80V2 Z80

  702 F289  78          	LD A,B
  703 F28A  F6 04       	OR 4  			; sonst Bitmaske fuer headdown
  704 F28C  C9          	RET
  705 F28D              noset:
  706 F28D  78          	LD A,B
  707 F28E  C9          	RET 			; Code belassen
  708                   	
  709                   ;------------------------------------------------------------------------------
  710                   
  711 F28F              rdflp:				; einen Sektor lesen
  712                   				; e=sektor nr
  713 F28F  79          	LD A,C
  714 F290  D3 C4       	OUT (FLO+4),A 		; erst mal Dichtecode setzen und Seite
  715 F292  7B          	LD A,E
  716 F293  D3 C2       	OUT (FLO+2),A 		; ins Sektorregister
  717 F295  0E C3       	LD C,FLO+3 		; Adresse Datenport dann nach c
  718 F297  CD F269     	CALL SETUP 		; Register A vorbereiten
  719 F29A  C6 88       	ADD A,88H 		; Lese-Befehl, sidesel=0
  720 F29C  D3 C0       	OUT (FLO),A 		; Befehl ausfuehren
  721 F29E              rd1:
  722 F29E  DB C4       	IN A,(FLO+4) 		; DRQ schon da ?
  723 F2A0  07          	RLCA  			; bit7 = drq bit6 = int
  724 F2A1  D2 F29E     	JP NC,RD1 		; bis drq=1 da ist
  725 F2A4  ED A2       	INI  			; dann Transport moeglich
  726 F2A6  C3 F29E     	JP RD1  		; und alles wiederholen bis INT
  727                   
  728                   ;------------------------------------------------------------------------------
  729                   
  730 F2A9              wrflp:				; Floppy-Sektor schreiben
  731 F2A9  79          	LD A,C
  732 F2AA  D3 C4       	OUT (FLO+4),A 		; erst mal Seite anwaehlen und Dichte
  733 F2AC  7B          	LD A,E  		; Sektorregister setzen
  734 F2AD  D3 C2       	OUT (FLO+2),A
  735 F2AF  0E C3       	LD C,FLO+3		; Adresse Datenport laden
  736 F2B1  CD F269     	CALL SETUP		; E-Code in A laden
  737 F2B4  C6 A8       	ADD A,0A8H		; Befehl Schreibe-Sektor
  738 F2B6  D3 C0       	OUT (FLO),A 		; und Befehl ausfuehren
  739 F2B8              wr1:
  740 F2B8  DB C4       	IN A,(FLO+4)		; warten bis DRQ da
  741 F2BA  07          	RLCA
  742 F2BB  D2 F2B8     	JP NC,WR1 		; dann Wert ausgeben
  743 F2BE  ED A3       	OUTI  			; mit Blockbefehl
  744 F2C0  C3 F2B8     	JP WR1  		; verlassen nur durch INT
  745                   
  746                   ;------------------------------------------------------------------------------
  747                   ; delay: 4 ms at 4 MHz
  748                   
  749 F2C3  C5          WAWA:	PUSH BC 		; pro Schleife ca 6us bei 4MHz
  750 F2C4  01 01F4     	LD BC,500 		; 500*6us Dauer
  751 F2C7  CD F2CC     	CALL DELAY
  752 F2CA  C1          	POP BC
  753 F2CB  C9          	RET
  754                   
  755                   ;------------------------------------------------------------------------------
  756                   ; delay: 6 microseconds at 4 MHz
  757                   
  758 F2CC  0B          DELAY:	DEC BC
  759 F2CD  78          	LD A,B
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  14
MON80V2 Z80

  760 F2CE  B1          	OR C
  761 F2CF  C2 F2CC     	JP NZ,DELAY
  762 F2D2  C9          	RET
  763                   
  764                   ;------------------------------------------------------------------------------
  765                   
  766 F2D3              seek:				; Spur anfahren C=Drive D=Spur E=Sektor
  767 F2D3  CD F2C3     	CALL WAWA 		; short delay
  768 F2D6  79          	LD A,C
  769 F2D7  D3 C4       	OUT (FLO+4),A 		; Drive-Code und Dichte sowie Seite
  770 F2D9  7B          	LD A,E
  771 F2DA  D3 C2       	OUT (FLO+2),A 		; Sektor
  772 F2DC  7A          	LD A,D
  773 F2DD  D3 C3       	OUT (FLO+3),A 		; Spur
  774 F2DF  06 1C       	LD B,1CH 		; Seek-Befehl
  775 F2E1  3A F3FA     	LD A,(STEPRATE)
  776 F2E4  E6 03       	AND 3  			; 0,1,2,3  zulaessig
  777 F2E6  B0          	OR B  			; Seek Befehl zusammen mit Steprate
  778 F2E7  D3 C0       	OUT (FLO),A 		; als Befehl ausgeben
  779 F2E9  76          	HALT  			; warten bis INT
  780                   
  781                   ;------------------------------------------------------------------------------
  782                   ; Kopf auf Spur 0 stellen
  783                   			
  784 F2EA  CD F2C3     RSTORE:	CALL WAWA		; short delay
  785                   
  786 F2ED  79          	LD A,C  		; Laufwerkscode (drive)
  787 F2EE  D3 C4       	OUT (FLO+4),A 		; mit Dichtecode etc. ausgeben
  788                   	
  789 F2F0  06 08       	LD B,8  		; nur Head-load, kein verify
  790 F2F2  3A F3FA     	LD A,(STEPRATE)
  791 F2F5  E6 03       	AND 3  			; 0,1,2,3 zulaessig
  792 F2F7  B0          	OR B  			; als Befehl kombiniert
  793 F2F8  D3 C0       	OUT (FLO),A 		; und ausfuehren
  794                   	
  795 F2FA  76          	HALT  			; wait for INT
  796                   
  797                   ;------------------------------------------------------------------------------
  798                   ; Floppy-Kernroutinen
  799                   
  800                   ; HL=address, d=track e=sector
  801                   ; b=Befehl (0=Steprate setzen, 1=read, 2=write)
  802                   ; c=Laufwerkscode
  803                   ;   aufgebaut wie Statusregister
  804                   ;   7    6    5    4    3    2    1    0
  805                   ;   sso  mot  min  dens d    d    d    d
  806                   ;   sso  = seitenauswahl (1=seite 1)
  807                   ;   mot  = motor on code (std=0)
  808                   ;   min  = 1 bei Minilaufwerken
  809                   ;   dens = 1 bei Single Dense Aufzeichnung
  810                   ; d=binaerer Laufwerkscode
  811                   ;   normalerweise nur 1,2,4,8 moeglich
  812                   ;   Kombinationen moeglich, wenn binaere
  813                   ;   Dekodierung beim Laufwerk verwendet wird
  814                   
  815 F2FB  78          SOFTEX:	LD A,B			; B = steprate
  816 F2FC  B7          	OR A
  817 F2FD  20 08       	JR NZ,SOFT1
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  15
MON80V2 Z80

  818                   
  819                   	; new set steprate (0..3 in D, SSO in bit 7)
  820 F2FF  7A          	LD A,D   		; (+80h =SSO verwenden und pruefen).
  821 F300  E6 83       	AND 83h  		; Bit 7=SSO-Flag bei Zugriffen wichtig
  822 F302  32 F3FA     	LD (STEPRATE),A		; die die zweite Seite verwenden.
  823 F305  AF          	XOR A
  824 F306  C9          	RET
  825                   
  826 F307  AF          SOFT1:	XOR A
  827 F308  32 F401     	LD (ERRCNT),A 		; Fehlerzahl 0
  828 F30B  79          	LD A,C
  829 F30C  32 F402     	LD (DRVCOD),A 		; Drive-Code
  830 F30F  E6 0F       	AND 0FH 		; fuer Vergleich
  831 F311  4F          	LD C,A  		; wieder zurueck
  832 F312  3A F403     	LD A,(CURDRV)
  833 F315  FE FF       	CP 0FFH 		; ungueltig, dann setzen noetig
  834 F317  28 14       	JR Z,NOTDEF
  835                   	
  836 F319  E6 0F       	AND 0FH 		; nur Laufwerksnummer relevant
  837 F31B  B9          	CP C  			; Vergleich ob Laufwerkewechsel
  838 F31C  CA F35B     	JP Z,NURSEEK 		; nur Seek noetig
  839 F31F  E5          	PUSH HL
  840 F320  C5          	PUSH BC
  841 F321  21 F404     	LD HL,DRVTAB 		; Basisadresse
  842 F324  4F          	LD C,A
  843 F325  06 00       	LD B,0  		; alten Laufwerktrack merken
  844 F327  09          	ADD HL,BC
  845 F328  DB C1       	IN A,(FLO+1) 		; Tracknr
  846 F32A  77          	LD (HL),A 		; und dort ablegen
  847 F32B  C1          	POP BC
  848 F32C  E1          	POP HL
  849                   
  850 F32D              notdef:				; Drive nur laden
  851 F32D  E5          	PUSH HL
  852 F32E  C5          	PUSH BC
  853 F32F  3A F402     	LD A,(DRVCOD) 		; neues Laufwerk
  854 F332  E6 0F       	AND 0FH 		; nur Laufwerkscode
  855 F334  4F          	LD C,A
  856 F335  06 00       	LD B,0
  857 F337  21 F404     	LD HL,DRVTAB 		; Tabellenstart
  858 F33A  09          	ADD HL,BC 		; hl zeigt auf Laufwerkstrack
  859 F33B  7E          	LD A,(HL)
  860 F33C  D3 C1       	OUT (FLO+1),A 		; und ins Register des FDs
  861 F33E  C1          	POP BC
  862 F33F  E1          	POP HL
  863 F340  3A F402     	LD A,(DRVCOD)
  864 F343  32 F403     	LD (CURDRV),A 		; ist nun neues Laufwerk
  865 F346  C5          	PUSH BC
  866 F347  01 00FA     	LD BC,1000*3/12		; ca 1ms warten
  867 F34A  CD F2CC     	CALL DELAY
  868 F34D  3A F402     	LD A,(DRVCOD) 		; Dann neues Laufwerk ansprechen
  869 F350  D3 C4       	OUT (FLO+4),A
  870 F352  01 0B65     	LD BC,2917		; ca 35ms .. 15ms
  871 F355  CD F2CC     	CALL DELAY		; um head-load-Zeit zu beruecksichtigen 
  872 F358  C1          	POP BC  		; alte Codes zurueck
  873 F359  18 06       	JR NUR1 		; Immer auf ready pruefen, da
  874                   				; head down sein kann und dennoch
  875                   				; nicht ready
