  234                   ; IO Routines
  235                   ;==============================================================================
  236                   ; Output 0-terminated string, address in HL
  237                   
  238 F074  DB 21       WRSTR:	IN  A,(CO_STS)	; read status
  239 F076  E6 01       	AND CO_TXB	; check TxRDY bit
  240 F078  CA F074     	JP Z,WRSTR	; wait if not set
