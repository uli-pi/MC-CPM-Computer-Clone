  148 F05B  C3 F06A     	JP ILLEGAL 	; c=leseseite    0,1,2,3
  149 F05E  C3 F06A     	JP ILLEGAL      ; c=rmwmode      0=norm 1=rmw
  150 F061  C3 F06A     	JP ILLEGAL 	; warten bis gdp fertig
  151 F064  C3 F06A     	JP ILLEGAL      ; c=befehl fuer gdp  ACHTUNG in C-Register nicht A
  152 F067  C3 F06A     	JP ILLEGAL 	; hl=quelle,de=ziel,c=bank quelle, b=bank ziel
  153                   			; carry wenn bankram auf f000h nicht da ist
