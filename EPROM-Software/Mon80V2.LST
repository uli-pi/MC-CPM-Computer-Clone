  181                   ; Console In main routine
  182                   
  183 F084  3A F14C     CI:	LD A,(IOBYT)
  184 F087  E6 03       	AND 3 			; console mask
  185 F089  20 09       	JR NZ,CI2		; other device
  186                   
  187 F08B  DB 21       CI1:	IN A,(U_STS)
  188 F08D  E6 02       	AND U_RXB
  189 F08F  28 FA       	JR Z,CI1
  190 F091  DB 20       	IN A,(U_DAT)
  191 F093  C9          	RET
  192                   
  193 F094  C3 F13A     CI2:	JP USERCI  		; user CI
  194                   
  195                   ;------------------------------------------------------------------------------
  196                   ; Reader In routine
  197                   
  198 F097  3A F14C     RI:	LD A,(IOBYT)
  199 F09A  E6 0C       	AND 00001100B
  200 F09C  CA F084     	JP Z,CI  	; AR=T
  201 F09F  FE 04       	CP 00000100B 
  202 F0A1  C2 F13D     	JP NZ,USERRI
  203                   	
  204 F0A4              RI1:	;AR = P
  205 F0A4  DB F3       	IN A,(SB_STS)
  206 F0A6  E6 01       	AND S_RXB
  207 F0A8  28 FA       	JR Z,RI1
  208 F0AA  DB F2       	IN A,(SB_DAT)
  209 F0AC  C9          	RET
  210                   
