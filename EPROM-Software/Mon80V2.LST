  892 F370  FE FF       	CP 0FFH 		; nicht definiert
  893 F372  28 0F       	JR Z,TRY1 		; dann zuerst RESTORE
  894 F374  BA          	CP D  			; oder schon auf dem Track
  895 F375  CA F3A2     	JP Z,RDWR 		; ja dann nur lesen,schreiben
  896 F378              	TRY:  			; SEEK ausfuehren
  897 F378  3A F402     	LD A,(DRVCOD)
  898 F37B  4F          	LD C,A
