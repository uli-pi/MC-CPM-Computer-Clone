  193                   ;==============================================================================
  194                   ; IO Routinen
  195                   ;==============================================================================
  196                   ; Output 0-terminated string, address in HL
  197                   
  198 F074  DB 21       WRSTR:	IN  A,(U_STS)	; read status
  199 F076  E6 01       	AND U_TXB	; check TxRDY bit
  200 F078  CA F074     	JP Z,WRSTR	; wait if not set
  201                   	
  202 F07B  7E          	LD A,(HL)	; get char from string
  203 F07C  A7          	AND A		; check if 0
  204 F07D  C8          	RET Z		; -> send of string
  205                   	
  206 F07E  D3 20       	OUT (U_DAT),A	; write char to output
  207 F080  23          	INC HL		; next char in string
  208 F081  C3 F074     	JP WRSTR	; start over
  209                   
