 1053 F5BD  77          	LD	(HL),A
 1054 F5BE  23          	INC	HL
 1055 F5BF  DB 1F       	IN	A,(IDESTAT)	; check status
 1056 F5C1  E6 08       	AND	08H		; DRQ bit
 1057 F5C3  C2 F5BB     	JP	NZ,IDERD5	; loop until cleared
