  413                   ; get1fl
  414                   
  415 F186  3A F587     get1fl:	LD A,(FLOC0)
  416 F189  FE 01       	CP 1  		; if a=1 -> FLO1 
  417 F18B  C2 F194     	JP NZ,GET1FL1
  418                   	
  419 F18E  79          	LD A,C
  420 F18F  EE 10       	XOR 10H		;wenn Flo1 dann invertieren Dichtebit
  421 F191  C3 F195     	JP GET1FL2
