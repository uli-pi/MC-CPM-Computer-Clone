  614                   ;------------------------------------------------------------------------------
  615                   
  616                   ; Old MINI routine
  617                   
  618                   ; Routinen fuer MC-Kompatibilitaet
  619                   ; wie floppy, jedoch Drive-Codierung anders
  620                   ; nur fuer bestehende BIOS-Routinen gedacht
  621                   ;
  622                   ; HL = block buffer address
  623                   ; B = 0=set step-rate and SSO, 1=read, 2=write
  624                   ; C = bit0=drive 0/1 (A/B), bit1=side 0/1, bit6=density
  625                   ; D = track
  626                   ; E = physical sector
  627                   
  628 F1E4  79          MINI:	LD A,C		; drive code
  629 F1E5  E6 7F       	AND 7FH 	; bit 7 interessiert nicht
  630 F1E7  4F          	LD C,A		; C value is used and overwritten by SCODB
  631                   
  632                   	; value for REG4-Latch -> C
  633 F1E8  F5          	PUSH AF
  634 F1E9  CD F1CA     	CALL SCODB 	; drive-code + side A -> C (value for REG4-Latch)
  635 F1EC  F1          	POP AF
  636 F1ED  E6 40       	AND 40H 	; density
  637 F1EF  C2 F1F9     	JP NZ,MINI1
  638                   	
  639                   	; single-density
  640 F1F2  79          	LD A,C
  641 F1F3  F6 30       	OR 00110000B 	; Bit5=Mini, Bit4=density (0=DD)
  642 F1F5  4F          	LD C,A
  643 F1F6  C3 F1FD     	JP MINI2
  644                   
  645 F1F9              MINI1:	; double-density
  646 F1F9  79          	LD A,C
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  12
MON80V2 Z80

  647 F1FA  F6 20       	OR 00100000B 	; Bit5=Mini, Bit4=density (0=DD)
  648 F1FC  4F          	LD C,A
  649                   
  650 F1FD  3E 02       MINI2:	LD A,2  	; set SSO flag
  651 F1FF  C3 F214     	JP FLOP1 	; ok ausfuehren
  652                   
  653                   ;==============================================================================
  654                   ; Floppy-Unterprogramme fuer FLO2
  655                   ; verwendet 1797 als Controller
  656                   ; Version 1.0   840506
  657                   ; Rolf-Dieter Klein (C) 1984 Muenchen
  658                   ;
  659                   ; Die Routinen ermoeglichen sowohl den Anschluss von Mini-,Mikro- als auch
  660                   ; von Maxi-Laufwerken. Die Routinen muessen im RAM stehen, da die Buffer
  661                   ; am Ende stehen. Alle Buffer sind jedoch gesammelt.
  662                   
  663                   ; FLO4    als Leseport
  664                   ;
  665                   ; 7 6 5 4 3 2 1 0
  666                   ;
  667                   ; DRQ   INTRQ   headld x      x x x x
  668                   ; 0=request
  669                   ;      0=request
  670                   ;  1=head down
  671                   ;
  672                   
  673                   ; FLO4    als Schreibport
  674                   ;
  675                   ; 7 6 5 4 3 2 1 0
  676                   ;
  677                   ; sso moton mini dense d c b a
  678                   ;
  679                   ; 1=Seite 1
  680                   ; 0=Motor an
  681                   ;  1=Minilaufwerk
  682                   ;   1=Single Dense
  683                   ;    -------------------------
  684                   ;      1=Laufwerk an
  685                   
  686         00C0      FLO	EQU 0C0H 		; Basisadresse Floppy-Controller
  687                   ;FLO0	EQU 0C0H   	
  688                   ;FLO1	EQU 0C1H
  689                   ;FLO2	EQU 0C2H
  690                   ;FLO3	EQU 0C3H
  691                   ;FLO4	EQU 0C4H 		; Port fuer Zusatzstatus etc.
  692                   				; write REG4-Latch
  693                   				; read REG4-Status
  694                   
  695                   ;------------------------------------------------------------------------------
  696                   ; Bei einem Interrupt wird an diese Stelle gesprungen
  697                   ; Der Interrupt erfolgt vom Floppy-Controller
  698                   
  699 F202              INTEX:	; Das INT-Program arbeitet nicht als Unterprogramm
  700 F202  F1          	POP AF  		; alte Ret-Adresse vernichten
  701 F203  DB C0       	IN A,(FLO) 		; Status lesen und INT loeschen
  702 F205  FB          	EI  			; Interrupt wieder freigeben
  703 F206  ED 4D       	RETI  			; zurueck zum vorherigen Aufrufer
  704                   
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  13
MON80V2 Z80

  705                   ;------------------------------------------------------------------------------
  706                   ; Floppy Routinen Init
  707                   
  708 F208  3E 02       INIFLP:	LD A,2  		; 3 = langsamste Steprate, kein SSO
  709 F20A  32 F3FA     	LD (STEPRATE),A
  710                   	
  711 F20D  3E FF       	LD A,0FFH
  712 F20F  32 F403     	LD (CURDRV),A 		; no current drive
  713 F212  C9          	RET 
  714                   
  715                   ;------------------------------------------------------------------------------
  716                   
  717         0038      INTVEK	EQU 38h 		; Interruptziel
  718                   
  719                   ;------------------------------------------------------------------------------
  720                   ; Haupteingang der Floppy-Routinen
  721                   ; HL = Ziel oder Quelladresse
  722                   ; E = Sektor D= Track
  723                   ; C = Laufwerkscode + Dichtecode + Seite (siehe EXFLO)
  724                   ;   7    6    5    4    3    2    1    0
  725                   ;   sso  mot  min  dens d    d    d    d
  726                   ;   sso  = seitenauswahl (0=side 0, 1=side 1)
  727                   ;   mot  = motor on code (std=0)
  728                   ;   min  = 1 bei Minilaufwerken
  729                   ;   dens = 1 bei Single Dense Aufzeichnung
  730                   ;   d = binary drive code
  731                   ;     normalerweise nur 1,2,4,8 moeglich
  732                   ;     Kombinationen moeglich, wenn binaere
  733                   ;     Dekodierung beim Laufwerk verwendet wird
  734                   ; B = 0 dann Steprate setzen + SSO-Flag
  735                   ;   = 1 dann lesen
  736                   ;   = 2 dann schreiben
  737                   
  738                   ; Entry SSO = 0
  739                   
  740 F213  AF          FLOP:	XOR A  			; SSO-Flag auf 0 setzen
  741                   
  742                   ; Entry SSO in A
  743                   ; called only from Old MINI routine
  744                   
  745 F214              FLOP1:	; SSO flag in A, only 0 and 2 allowed
  746 F214  32 F3FB     	LD (SSOFLAG),A
  747                   
  748 F217  F5          	PUSH AF
  749 F218  3A F587     	LD A,(FLOTYP)
  750 F21B  FE 01       	CP 1  
  751 F21D  C2 F226     	JP NZ,FLOP2		; -> FLO2
  752                   	
  753                   	; FLO1
  754 F220  79          	LD A,C
  755 F221  E6 BF       	AND 10111111B 		; kein autowait 
  756 F223  EE 10       	XOR 10H 		; invertieren Dichtebit fuer FLO1
  757 F225  4F          	LD C,A
  758                   
  759 F226  F1          FLOP2:	POP AF
  760 F227  ED 73 F3FC  	LD (SP0),SP 		; save user-stack, maybe to deep for BDOS
  761 F22B  31 F478     	LD SP,TSTACK 		;
  762                   
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  14
MON80V2 Z80

  763 F22E  3E D0       	LD A,11010000B		; Command "Force interrupt"
  764 F230  D3 C0       	OUT (FLO),A 		; reset floppy controller
  765                   	
  766                   	; set interrupt vector to INTEX
  767 F232  3A 0038     	LD A,(INTVEK)
  768 F235  32 F3FE     	LD (SAVINT),A
  769 F238  3E C3       	LD A,0C3H 		; JP-Befehl
  770 F23A  32 0038     	LD (INTVEK),A
  771 F23D  E5          	PUSH HL
  772 F23E  2A 0039     	LD HL,(INTVEK+1)
  773 F241  22 F3FF     	LD (SAVINT+1),HL
  774 F244  21 F202     	LD HL,INTEX 		; set to JP INTEX
  775 F247  22 0039     	LD (INTVEK+1),HL
  776 F24A  E1          	POP HL
  777                   	
  778 F24B  DB C0       	IN A,(FLO)		; Status - Port
  779 F24D  ED 56       	IM 1  			; set interrupt mode 1 ->  execure at 38h
  780 F24F  FB          	EI  			; Interrupt freigeben
  781 F250  CD F2FB     	CALL EXFLO
  782 F253  F3          	DI  			; disable interrupt
  783                   	
  784                   	; restore interrupt vector
  785 F254  F5          	PUSH AF 		; Status
  786 F255  3A F3FE     	LD A,(SAVINT)
  787 F258  32 0038     	LD (INTVEK),A 		; zurueckspeichern
  788 F25B  E5          	PUSH HL
  789 F25C  2A F3FF     	LD HL,(SAVINT+1)
  790 F25F  22 0039     	LD (INTVEK+1),HL
  791 F262  E1          	POP HL
  792 F263  F1          	POP AF
  793                   	
  794 F264  ED 7B F3FC  	LD SP,(SP0) 		; restore user-stack
  795 F268  C9          	RET
  796                   
  797                   ;------------------------------------------------------------------------------
  798                   ; Diverse Unterprogramme
  799                   ;------------------------------------------------------------------------------
  800                   ; Prepare command byte for floppy controller
  801                   
  802 F269              SETCMD:				; testet ob der Kopf noch
  803                   				; geladen ist und setzt die
  804 F269  06 00       	LD B,0  		; Flag fuer SSO-Bit
  805 F26B  3A F402     	LD A,(DRVCOD) 		; wenn Bit 7 gesetzt, dann abfragen
  806 F26E  E6 80       	AND 80H
  807 F270  28 11       	JR Z,SETC2 		; Seite 0, immer mit SSO=0
  808                   	
  809 F272  3A F3FA     	LD A,(STEPRATE) 	; jetzt pruefen ob flags da
  810 F275  E6 80       	AND 80H 		; <>0, dann SSO setzen, wenn seite 1
  811 F277  28 04       	JR Z,SETC1 		; =0, dann code 0, oder SSOFLAG
  812                   	
  813 F279  06 02       	LD B,2  		; SSO setzen 
  814 F27B  18 06       	JR SETC2
  815                   
  816 F27D              SETC1:	; pruefen ob SSO-Flag
  817 F27D  3A F3FB     	LD A,(SSOFLAG) 		; ok, 2=Flag
  818 F280  E6 02       	AND 2  			; SSO-Bit
  819 F282  47          	LD B,A  		; 0,2 erlaubt 
  820                   
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  15
MON80V2 Z80

  821 F283              SETC2:	; entsprechenden Bits
  822 F283  DB C4       	IN A,(FLO+4) 		; REG4-Status
  823 F285  E6 20       	AND 20H 		; Head-Load Bit
  824 F287  20 04       	JR NZ,SETC3 		; =1 dann Kopf auf Diskette
  825                   	
  826 F289  78          	LD A,B
  827 F28A  F6 04       	OR 04h 			; sonst Bitmaske fuer headdown
  828 F28C  C9          	RET
  829                   
  830 F28D              SETC3:	; noset
  831 F28D  78          	LD A,B
  832 F28E  C9          	RET 			; Code belassen
  833                   
  834                   ;------------------------------------------------------------------------------
  835                   ; Read one sector
  836                   ; sector number in E
  837                   ; buffer addr in HL
  838                   
  839 F28F  79          RDFLP:	LD A,C
  840 F290  D3 C4       	OUT (FLO+4),A 		; density + side -> REG4-Latch
  841 F292  7B          	LD A,E
  842 F293  D3 C2       	OUT (FLO+2),A 		; ins Sektorregister
  843 F295  0E C3       	LD C,FLO+3 		; Adresse Datenport dann nach C
  844 F297  CD F269     	CALL SETCMD 		; Register A vorbereiten
  845 F29A  C6 88       	ADD A,10001000B		; Command "Read Sector", without SSO
  846 F29C  D3 C0       	OUT (FLO),A 		; Befehl ausfuehren
  847                   
  848 F29E              RDFLP1:	; wait for DRQ = 1
  849 F29E  DB C4       	IN A,(FLO+4) 		; DRQ schon da ?
  850 F2A0  07          	RLCA  			; bit7 = DRQ, bit6 = int
  851 F2A1  D2 F29E     	JP NC,RDFLP1 		; -> DRQ = 0
  852                   	
  853 F2A4  ED A2       	INI  			; IN (C) -> (HL), HL++, B--
  854 F2A6  C3 F29E     	JP RDFLP1  		; verlassen nur durch INT
  855                   
  856                   ;------------------------------------------------------------------------------
  857                   ; Write one sector
  858                   
  859 F2A9  79          WRFLP:	LD A,C
  860 F2AA  D3 C4       	OUT (FLO+4),A 		; density + side -> REG4-Latch
  861 F2AC  7B          	LD A,E  		; Sektorregister setzen
  862 F2AD  D3 C2       	OUT (FLO+2),A
  863 F2AF  0E C3       	LD C,FLO+3		; Adresse Datenport laden
  864 F2B1  CD F269     	CALL SETCMD		; E-Code in A laden
  865 F2B4  C6 A8       	ADD A,0A8H		; Befehl Schreibe-Sektor
  866 F2B6  D3 C0       	OUT (FLO),A 		; und Befehl ausfuehren
  867                   
  868 F2B8              WRFLP1:	; wait for DRQ = 1
  869 F2B8  DB C4       	IN A,(FLO+4) 		; DRQ schon da ?
  870 F2BA  07          	RLCA  			; bit7 = DRQ, bit6 = int
  871 F2BB  D2 F2B8     	JP NC,WRFLP1
  872                   	
  873 F2BE  ED A3       	OUTI  			; (HL) -> OUT (C), HL++, B--
  874 F2C0  C3 F2B8     	JP WRFLP1  		; verlassen nur durch INT
  875                   
  876                   ;------------------------------------------------------------------------------
  877                   ; delay: 4 ms at 4 MHz
  878                   
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  16
MON80V2 Z80

  879 F2C3  C5          WAWA:	PUSH BC 		; pro Schleife ca 6us bei 4MHz
  880 F2C4  01 01F4     	LD BC,500 		; 500*6us Dauer
  881 F2C7  CD F2CC     	CALL DELAY
  882 F2CA  C1          	POP BC
  883 F2CB  C9          	RET
  884                   
  885                   ;------------------------------------------------------------------------------
  886                   ; delay: 6 microseconds at 4 MHz
  887                   
  888 F2CC  0B          DELAY:	DEC BC
  889 F2CD  78          	LD A,B
  890 F2CE  B1          	OR C
  891 F2CF  C2 F2CC     	JP NZ,DELAY
  892                   	
  893 F2D2  C9          	RET
  894                   
  895                   ;------------------------------------------------------------------------------
  896                   ; Seek to track
  897                   ; C=Drive D=Track E=Sector
  898                   
  899 F2D3  CD F2C3     SEEK:	CALL WAWA 		; short delay (4 ms)
  900                   
  901 F2D6  79          	LD A,C
  902 F2D7  D3 C4       	OUT (FLO+4),A 		; drive code, density and side -> REG4-Latch
  903 F2D9  7B          	LD A,E
  904 F2DA  D3 C2       	OUT (FLO+2),A 		; Sector
  905 F2DC  7A          	LD A,D
  906 F2DD  D3 C3       	OUT (FLO+3),A 		; track
  907 F2DF  06 1C       	LD B,1CH 		; seek command
  908 F2E1  3A F3FA     	LD A,(STEPRATE)
  909 F2E4  E6 03       	AND 3  			; 0,1,2,3 zulaessig
  910 F2E6  B0          	OR B  			; 
  911 F2E7  D3 C0       	OUT (FLO),A 		; execute Seek together with steprate
  912                   
  913 F2E9  76          	HALT  			; wait for INT
  914                   
  915                   ;------------------------------------------------------------------------------
  916                   ; Kopf auf Spur 0 stellen
  917                   			
  918 F2EA  CD F2C3     RSTORE:	CALL WAWA		; short delay (4 ms)
  919                   
  920 F2ED  79          	LD A,C  		; Laufwerkscode (drive)
  921 F2EE  D3 C4       	OUT (FLO+4),A 		; mit Dichtecode etc. ausgeben -> REG4-Latch
  922                   
  923                   	; Command "Restore" 0000hvrr, h=head load, v=verify, rr=steprate
  924 F2F0  06 08       	LD B,00001000B 		; only head load, no verify
  925 F2F2  3A F3FA     	LD A,(STEPRATE)
  926 F2F5  E6 03       	AND 3  			; 0..3
  927 F2F7  B0          	OR B  			; als Befehl kombiniert
  928 F2F8  D3 C0       	OUT (FLO),A 		; und ausfuehren
  929                   
  930 F2FA  76          	HALT  			; wait for INT
  931                   
  932                   ;------------------------------------------------------------------------------
  933                   ; Floppy Kernal Routines
  934                   
  935                   ; HL=Address, d=Track e=Sector
  936                   ; b=Command (0=set steprate+SSO, 1=read, 2=write)
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  17
MON80V2 Z80

  937                   ; c=drive code
  938                   ;   aufgebaut wie Special Register 4
  939                   ;   7    6    5    4    3    2    1    0
  940                   ;   sso  mot  min  dens d    d    d    d
  941                   ;   sso  = seitenauswahl (1=seite 1)
  942                   ;   mot  = motor on code (std=0)
  943                   ;   min  = 1 bei Minilaufwerken
  944                   ;   dens = 1 bei Single Dense Aufzeichnung
  945                   ; d=binary drive code
  946                   ;   normalerweise nur 1,2,4,8 moeglich
  947                   ;   Kombinationen moeglich, wenn binaere
  948                   ;   Dekodierung beim Laufwerk verwendet wird
  949                   
  950 F2FB  78          EXFLO:	LD A,B			; B = command
  951 F2FC  B7          	OR A
  952 F2FD  20 08       	JR NZ,EXFL1
  953                   
  954                   	;---------------------------------------------------------------------
  955                   	; B=0: set steprate and SSO
  956                   	; steprate in D, Bit0/1=steprate, bit7=SSO
  957                   	
  958 F2FF  7A          	LD A,D   		; (+80h =SSO verwenden und pruefen).
  959 F300  E6 83       	AND 83h  		; Bit 7=SSO-Flag bei Zugriffen wichtig
  960 F302  32 F3FA     	LD (STEPRATE),A		; die die zweite Seite verwenden.
  961 F305  AF          	XOR A
  962 F306  C9          	RET
  963                   
  964                   	;---------------------------------------------------------------------
  965                   
  966 F307  AF          EXFL1:	XOR A
  967 F308  32 F401     	LD (ERRCNT),A 		; Fehlerzahl 0
  968 F30B  79          	LD A,C
  969 F30C  32 F402     	LD (DRVCOD),A 		; drive-code
  970 F30F  E6 0F       	AND 0FH 		; in bit 0..3
  971 F311  4F          	LD C,A
  972 F312  3A F403     	LD A,(CURDRV)
  973 F315  FE FF       	CP 0FFH 		; current drive invalid -> set
  974 F317  28 14       	JR Z,EXFL2
  975                   	
  976                   	; check if drive change
  977 F319  E6 0F       	AND 0FH 		; bit 0..3
  978 F31B  B9          	CP C
  979 F31C  CA F35B     	JP Z,EXFL3 		; -> no change, nur Seek noetig
  980                   
  981 F31F  E5          	PUSH HL
  982 F320  C5          	PUSH BC
  983 F321  21 F404     	LD HL,DRVTAB 		; Basisadresse
  984 F324  4F          	LD C,A
  985 F325  06 00       	LD B,0  		; alten Laufwerktrack merken
  986 F327  09          	ADD HL,BC
  987 F328  DB C1       	IN A,(FLO+1) 		; Tracknr
  988 F32A  77          	LD (HL),A 		; und dort ablegen
  989 F32B  C1          	POP BC
  990 F32C  E1          	POP HL
  991                   
  992 F32D  E5          EXFL2:	PUSH HL
  993 F32E  C5          	PUSH BC
  994 F32F  3A F402     	LD A,(DRVCOD) 		; neues Laufwerk
