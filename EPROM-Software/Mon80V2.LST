  316                   ;------------------------------------------------------------------------------
  317                   ; The IOBYTE is used to switch from physical to logical device. It has the
  318                   ; same meaning as in the CP/M BIOS.
  319                   
  320 F102  3A F14C     IOGET:	LD A,(IOBYT)
  321 F105  C9          	RET
  322                   
  323                   ;------------------------------------------------------------------------------
  324                   ; IOSET, can be set in BIOS
  325                   
  326 F106  79          IOSET:	LD A,C
  327 F107  32 F14C     	LD (IOBYT),A
  328 F10A  C9          	RET
  329                   	
  330                   ;------------------------------------------------------------------------------
  331                   ; prueft den Speicherbereich und gibt die hoechste verfuegbare Zelle an
  332                   ; MEMCHK IN B HIGH IN A LOW MEMORY
  333                   
  334 F10B  E5          MEMCHK:	PUSH HL
  335 F10C  CD F118     	CALL MEMSIZ
  336 F10F  7D          	LD A,L
  337 F110  D6 3C       	SUB 3CH
  338 F112  30 01       	JR NC,MEMCK1
  339                   
  340 F114  25          	DEC H
  341                   	
  342 F115  44          MEMCK1:	LD B,H
  343 F116  E1          	POP HL
  344 F117  C9          	RET
  345                   
  346                   ;------------------------------------------------------------------------------
  347                   ; Detect end of memory from 0000h to EFFFh
  348                   
  349 F118  C5          MEMSIZ:	PUSH BC
  350                   
  351                   	; Einsprung
  352 F119              MEMSIZB:
  353 F119  21 FFFF     	LD HL,-1
  354                   
  355 F11C  24          MEMS1:	INC H
  356 F11D  7E          	LD A,(HL)
