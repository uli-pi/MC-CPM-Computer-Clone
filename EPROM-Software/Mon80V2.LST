  219 F0B6  E6 01       	AND U_TXB
  220 F0B8  28 FA       	JR Z,CO1
  221                   	
  222 F0BA  79          	LD A,C
  223 F0BB  D3 20       	OUT (U_DAT),A
  224 F0BD  C9          	RET
