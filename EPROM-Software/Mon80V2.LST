  232 F0C1  3A F14C     POO:	LD A,(IOBYT)
  233 F0C4  E6 30       	AND 00110000B
  234 F0C6  CA F0AD     	JP Z,CO  			; AP=T
  235                   	
  236 F0C9  FE 10       	CP 00010000B
