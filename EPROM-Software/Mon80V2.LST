 1184                   
 1185                   ;==============================================================================
 1186                   ; IDE/CF card interface
 1187                   ;
 1188                   ; Read one IDE/CF card sector (256 bytes)
 1189                   ;
 1190                   ; Address for data in HL
 1191                   ; LBA bits 0 to 7 passed in C
 1192                   ; LBA bits 8 to 15 passed in B
 1193                   ; LBA bits 16 to 23 passed in E
 1194                   
 1195 F588              IDERD:
 1196 F588  DB 1F       IDERD1:	IN	A,(IDESTAT)	; check status
 1197 F58A  E6 80       	AND	80H		; check BSY bit
 1198 F58C  C2 F588     	JP	NZ,IDERD1	; loop until not busy
 1199                   
 1200 F58F  DB 1F       IDERD2:	IN	A,(IDESTAT)	; check	status
 1201 F591  E6 40       	AND	40H		; check DRDY bit
 1202 F593  CA F58F     	JP	Z,IDERD2	; loop until ready
 1203                   
 1204 F596  3E 01       	LD	A,01H		; number of sectors = 1
 1205 F598  D3 1A       	OUT	(SECCND),A	; sector count register
 1206 F59A  79          	LD	A,C
 1207 F59B  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1208 F59D  78          	LD	A,B
 1209 F59E  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1210 F5A0  7B          	LD	A,E
 1211 F5A1  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1212 F5A3  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1213 F5A5  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1214 F5A7  3E 20       	LD	A,20H		; Read sector command
 1215 F5A9  D3 1F       	OUT	(IDESTAT),A
 1216                   
 1217 F5AB              IDERD3:	; wait for drq set
 1218 F5AB  DB 1F       	IN	A,(IDESTAT)	; read status
 1219 F5AD  E6 08       	AND	08H		; DRQ bit
 1220 F5AF  CA F5AB     	JP	Z,IDERD3	; loop until bit set
 1221                   	
 1222 F5B2              IDERD4:	; wait for busy clear
 1223 F5B2  DB 1F       	IN	A,(IDESTAT)
 1224 F5B4  E6 80       	AND	80H
 1225 F5B6  C2 F5B2     	JP	NZ,IDERD4
 1226                   	
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  22
MON80V2 Z80

 1227 F5B9  DB 1F       	IN	A,(IDESTAT)	; clear INTRQ
 1228                   
