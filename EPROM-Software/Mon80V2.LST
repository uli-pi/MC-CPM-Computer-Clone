  180                   	
  181 F07B  7E          	LD A,(HL)	; get char from string
  182 F07C  A7          	AND A		; check if 0
  183 F07D  C8          	RET Z		; -> send of string
  184                   	
  185 F07E  D3 20       	OUT (U_DAT),A	; write char to output
  186 F080  23          	INC HL		; next char in string
  187 F081  C3 F074     	JP WRSTR	; start over
