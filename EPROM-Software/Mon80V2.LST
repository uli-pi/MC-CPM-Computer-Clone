  372                   ;------------------------------------------------------------------------------
  373                   ; prueft den Speicherbereich und gibt die hoechste verfuegbare Zelle an
  374                   ; MEMCHK IN B HIGH IN A LOW MEMORY
  375                   
  376 F10B  E5          MEMCHK:	PUSH HL
  377 F10C  CD F118     	CALL MEMSIZ
  378 F10F  7D          	LD A,L
  379 F110  D6 3C       	SUB 3CH
  380 F112  30 01       	JR NC,MEMCK1
  381                   
  382 F114  25          	DEC H
  383                   	
  384 F115  44          MEMCK1:	LD B,H
  385 F116  E1          	POP HL
  386 F117  C9          	RET
  387                   
  388                   ;------------------------------------------------------------------------------
  389                   ; Detect end of memory from 0000h to EFFFh
  390                   
  391 F118  C5          MEMSIZ:	PUSH BC
  392                   
  393                   	; entry point
  394 F119              MEMSIZB:
  395 F119  21 FFFF     	LD HL,-1
  396                   
  397 F11C  24          MEMS1:	INC H
  398 F11D  7E          	LD A,(HL)
  399 F11E  2F          	CPL
  400 F11F  77          	LD (HL),A
  401 F120  BE          	CP (HL)
  402 F121  2F          	CPL
  403 F122  77          	LD (HL),A
  404 F123  20 F7       	JR NZ,MEMS1
  405                   
  406 F125  24          MEMS2:	INC H
  407 F126  7C          	LD A,H
