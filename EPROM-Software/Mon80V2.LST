  335 F11D  7E          	LD A,(HL)
  336 F11E  2F          	CPL
  337 F11F  77          	LD (HL),A
  338 F120  BE          	CP (HL)
  339 F121  2F          	CPL
  340 F122  77          	LD (HL),A
  341 F123  20 F7       	JR NZ,MEMS1
