  299                   ; prueft den Speicherbereich und gibt die hoechste verfuegbare Zelle an
  300                   ; MEMCK IN B HIGH IN A LOW MEMORY
  301                   
  302 F10B  E5          MEMCK:	PUSH HL
  303 F10C  CD F118     	CALL MEMSIZ
  304 F10F  7D          	LD A,L
  305 F110  D6 3C       	SUB 3CH
  306 F112  30 01       	JR NC,MEMCK1
  307                   	
  308 F114  25          	DEC H
  309                   	
  310 F115  44          MEMCK1:	LD B,H
  311 F116  E1          	POP HL
  312 F117  C9          	RET
  313                   
  314                   ;------------------------------------------------------------------------------
  315                   ; Detect end of memory from 0000h to EFFFh
  316                   
  317 F118  C5          MEMSIZ:	PUSH BC
  318                   
  319                   	; Einsprung
  320 F119              MEMSIZ1:
  321 F119  21 FFFF     	LD HL,-1
  322                   
  323 F11C  24          MEMS1:	INC H
  324 F11D  7E          	LD A,(HL)
  325 F11E  2F          	CPL
  326 F11F  77          	LD (HL),A
  327 F120  BE          	CP (HL)
  328 F121  2F          	CPL
  329 F122  77          	LD (HL),A
  330 F123  20 F7       	JR NZ,MEMS1
  331                   
  332 F125  24          MEMS2:	INC H
  333 F126  7C          	LD A,H
  334 F127  FE F0       	CP 0F0H		; ALL RAM
  335 F129  28 08       	JR Z,MEMS3 	; READY 0F000H
  336                   	
  337 F12B  7E          	LD A,(HL) 	; max 0F000h, da dort Monitor startet
  338 F12C  2F          	CPL
  339 F12D  77          	LD (HL),A
  340 F12E  BE          	CP (HL)
  341 F12F  2F          	CPL
  342 F130  77          	LD (HL),A
  343 F131  28 F2       	JR Z,MEMS2
  344                   
  345 F133  25          MEMS3:	DEC H
  346 F134  01 FFDD     	LD BC,EXIT-ENDX
  347 F137  09          	ADD HL,BC
  348 F138  C1          	POP BC
  349 F139  C9          	RET
