  389                   ; FLO2 floppy routines
  390                   
  391                   ; Autobestimmung des Formats
  392                   ; in C ist danach der gueltige ; Laufwerkscode,
  393                   ; Vorgabe ist in C die Laufwerksnummer und ggf. Seite.
  394                   ; testet mini,sd =11
  395                   ;        mini,dd =10
  396                   ;        maxi,sd =01
  397                   ;        maxi,dd =00
  398                   
  399 F156  F3          getfl:	DI  		; ohne Interrupts
  400 F157  3E D0       	LD A,0D0H
  401 F159  D3 C0       	OUT (FLO),A 	; Stop Controller
  402 F15B  DB C0       	IN A,(FLO) 	; Ints loeschen
  403 F15D  79          	LD A,C
  404 F15E  E6 8F       	AND 8FH 	; nur Drivecode ok
  405 F160  4F          	LD C,A
  406 F161  CD F2C3     	CALL WAWA
  407 F164  79          	LD A,C
  408 F165  F6 30       	OR 00110000B	; mini sd vorgeben		
  409 F167  4F          	LD C,A
  410 F168  CD F186     	CALL GET1FL
  411 F16B  D0          	RET NC  	; kein Fehler, no carry
