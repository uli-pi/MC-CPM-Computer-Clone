  534                   ;==============================================================================
  535                   ; Floppy Interface Paket Rev 1.0   841031
  536                   ; (C) 1984 Muenchen, Rolf-Dieter Klein
  537                   
  538                   ; Routinen fuer MC-Kompatibilitaet
  539                   ; wie floppy, jedoch Drive-Codierung anders
  540                   ; nur fuer bestehende BIOS-Routinen gedacht
  541                    
  542                   ; bei Maxi wird die Seite 1 mit Seitenpruefung auf 0
  543                   ; angesprochen, bei Mini mit Seitenpruefung auf 1.
  544                   ; nur fuer SD
  545                   
  546                   ; c=0,1,2,3
  547                   ; 	0,2 gekoppelt  1,3 gekoppelt					
  548                   
  549 F1A9  CD F1AF     MAXI:	CALL SCODA	; coding 1
  550 F1AC  C3 F213     	JP FLOP		; sso-flag auf 0 setzen, jedoch stepflag
  551                   			; gueltig wenn bit 7 gesetzt.
  552                   
  553                   ;------------------------------------------------------------------------------
  554                   ; Maxi Disk recoding of drive and side for Special Register 4
  555                   ; 0 -> 11 (drive 1, side 0, Maxi)
  556                   ; 1 -> 91 (drive 1, side 1, Maxi)
  557                   ; 2 -> 12 (drive 2, side 0, Maxi)
  558                   ; 3 -> 92 (drive 2, side 1, Maxi)
  559                   
  560 F1AF  79          SCODA:	LD A,C  	; SD MAXI
  561 F1B0  E6 03       	AND 3  		; muss Bereich 0..3 sein
  562 F1B2  FE 00       	CP 0  		; 0 seite 0
  563 F1B4  20 03       	JR NZ,SCODA1
  564                   	
  565 F1B6  0E 11       	LD C,00010001B 	; LW 1
  566 F1B8  C9          	RET
  567                   
  568 F1B9  FE 01       SCODA1:	CP 1
  569 F1BB  20 03       	JR NZ,SCODA2
  570                   	
  571 F1BD  0E 12       	LD C,00010010B 	; LW 2 seite 0
  572 F1BF  C9          	RET
  573                   
  574 F1C0  FE 02       SCODA2:	CP 2
  575 F1C2  20 03       	JR NZ,SCODA3
  576                   	
  577 F1C4  0E 91       	LD C,10010001B 	; LW 1 seite 1
  578 F1C6  C9          	RET
  579                   
  580 F1C7  0E 92       SCODA3:	LD C,10010010B 	; LW 2 seite 1
  581 F1C9  C9          	RET
  582                   
  583                   ;------------------------------------------------------------------------------
  584                   ; Mini Disk recoding of drive and side for Special Register 4
  585                   ; 0 -> 01 (drive 1, side 0, Mini)
  586                   ; 1 -> 81 (drive 1, side 1, Mini)
  587                   ; 2 -> 02 (drive 2, side 0, Mini)
  588                   ; 3 -> 82 (drive 2, side 1, Mini)
