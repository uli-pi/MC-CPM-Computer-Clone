  236 F0A4  DB F3       	IN A,(SB_STS)
  237 F0A6  E6 01       	AND S_RXB
  238 F0A8  28 FA       	JR Z,READI1
  239                   	
  240 F0AA  DB F2       	IN A,(SB_DAT)
