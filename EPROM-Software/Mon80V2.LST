  540                   ;==============================================================================
  541                   ; Floppy-Unterprogramme fuer FLO2
  542                   ; verwendet 1797 als Controller
  543                   ; Version 1.0   840506
  544                   ; Rolf-Dieter Klein (C) 1984 Muenchen
  545                   ;
  546                   ; Die Routinen ermoeglichen sowohl den Anschluss von Mini-,Mikro- als auch
  547                   ; von Maxi-Laufwerken. Die Routinen muessen im RAM stehen, da die Buffer
  548                   ; am Ende stehen. Alle Buffer sind jedoch gesammelt.
  549                   
  550                   ; FLO4    als Leseport
  551                   ;
  552                   ; 7 6 5 4 3 2 1 0
  553                   ;
  554                   ; DRQ   INTRQ   headld x      x x x x
  555                   ; 0=request
  556                   ;      0=request
  557                   ;  1=head down
  558                   ;
  559                   
  560                   ; FLO4    als Schreibport
  561                   ;
  562                   ; 7 6 5 4 3 2 1 0
  563                   ;
  564                   ; sso moton mini dense d c b a
  565                   ;
  566                   ; 1=Seite 1
  567                   ; 0=Motor an
  568                   ;  1=Minilaufwerk
  569                   ;   1=Single Dense
  570                   ;    -------------------------
  571                   ;      1=Laufwerk an
  572                   
  573                   
  574                   
  575         00C0      FLO	EQU 0C0H 	; Basisadresse Floppy-Controller
  576         00C0      FLO0	EQU 0C0H   	
  577         00C1      FLO1	EQU 0C1H
  578         00C2      FLO2	EQU 0C2H
  579         00C3      FLO3	EQU 0C3H
  580         00C4      FLO4	EQU 0C4H 	; Port fuer Zusatzstatus etc.
  581                   
  582                   	; Bei einem Interrupt wird an diese Stelle gesprungen
  583                   	; Der Interrupt erfolgt vom Floppy-Controller
  584                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  11
MON80V2 Z80

  585 F202              intex:	; Das INT-Program arbeitet nicht als Unterprogramm
  586 F202  F1          	POP AF  	; alte Ret-Adresse vernichten
  587 F203  DB C0       	IN A,(FLO) 	; Status lesen und INT loeschen
  588 F205  FB          	EI  		; Interrupt wieder freigeben
  589 F206  ED 4D       	RETI  		; zurueck zum vorherigen Aufrufer
