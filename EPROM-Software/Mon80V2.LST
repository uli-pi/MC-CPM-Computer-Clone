 1108 F5DA  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1109 F5DC  78          	LD	A,B
 1110 F5DD  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1111 F5DF  7B          	LD	A,E
 1112 F5E0  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
