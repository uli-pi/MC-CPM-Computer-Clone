  995 F347  01 00FA     	LD BC,1000*3/12		; ca 1ms warten
  996 F34A  CD F2CC     	CALL DELAY
  997 F34D  3A F402     	LD A,(DRVCOD) 		; Dann neues Laufwerk ansprechen
  998 F350  D3 C4       	OUT (FLO+4),A		; -> REG4-Latch
  999 F352  01 0B65     	LD BC,2917		; ca 35ms .. 15ms
 1000 F355  CD F2CC     	CALL DELAY		; um headload-Zeit zu beruecksichtigen 
 1001 F358  C1          	POP BC  		; alte Codes zurueck
 1002 F359  18 06       	JR EXFL4 		; Immer auf ready pruefen, da
 1003                   				; head down sein kann und dennoch nicht ready
 1004                   
 1005 F35B              EXFL3:	; seek only
 1006 F35B  DB C4       	IN A,(FLO+4)
 1007 F35D  E6 20       	AND 20H
 1008 F35F  20 0D       	JR NZ,EXFL5		; -> head down, no dummy seek
 1009                   
 1010 F361              EXFL4:	; repeat seek command (ready test only)
 1011 F361  3A F402     	LD A,(DRVCOD)
 1012 F364  4F          	LD C,A
 1013 F365  CD F3F0     	CALL EXSEEK 		; seek select dummy nur fuer ready-test
 1014 F368  DB C0       	IN A,(FLO)		; test Status
 1015 F36A  E6 80       	AND 80H 		; fuer Ready
 1016 F36C  20 F3       	JR NZ,EXFL4		; repeat until ready
 1017                   
 1018 F36E              EXFL5:	; entry head down ok
 1019 F36E  DB C1       	IN A,(FLO+1) 		; nun pruefen ob Tracks gleich sind
 1020 F370  FE FF       	CP 0FFH 		; nicht definiert
 1021 F372  28 0F       	JR Z,EXFL7 		; dann zuerst RESTORE
 1022                   
 1023 F374  BA          	CP D  			; oder schon auf dem Track
 1024 F375  CA F3A2     	JP Z,EXFL9 		; -> ja dann nur lesen/schreiben
 1025                   
 1026 F378              EXFL6:	; loop seek
 1027 F378  3A F402     	LD A,(DRVCOD)
 1028 F37B  4F          	LD C,A
 1029 F37C  CD F3F0     	CALL EXSEEK 		; und Track anfahren Reg retten
 1030 F37F  E6 90       	AND 10010000B 		; Fehlermaske
 1031 F381  28 1F       	JR Z,EXFL9 		; -> ja dann R/W moeglich
 1032                   	
 1033 F383              EXFL7:	; Laufwerk normieren und RSTORE
 1034 F383  3A F402     	LD A,(DRVCOD)
 1035 F386  4F          	LD C,A
 1036 F387  E5          	PUSH HL
 1037 F388  D5          	PUSH DE
 1038 F389  C5          	PUSH BC
 1039 F38A  CD F2EA     	CALL RSTORE		; track 0
 1040 F38D  C1          	POP BC
 1041 F38E  D1          	POP DE
 1042 F38F  E1          	POP HL
 1043 F390  3A F401     	LD A,(ERRCNT) 		; Fehler erhoehen
 1044 F393  3C          	INC A
 1045 F394  32 F401     	LD (ERRCNT),A
 1046 F397  FE 0A       	CP 10  			; bei 10 Fatal-Fehler
 1047 F399  38 DD       	JR C,EXFL6 		; sonst nochmals mit SEEK probieren
 1048                   
 1049 F39B              EXFL8:	; fatal error
 1050 F39B  3E FF       	LD A,0FFH
 1051 F39D  B7          	OR A
 1052 F39E  37          	SCF  			; A=0ffh, carry as error flag
