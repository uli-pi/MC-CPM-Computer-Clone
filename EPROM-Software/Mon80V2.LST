 1142 F5D2  CA F5CE     	JP	Z,IDEWR2	; loop until ready
 1143                   
 1144 F5D5  3E 01       	LD	A,01H		; number of sectors = 1
 1145 F5D7  D3 1A       	OUT	(SECCND),A	; sector count register
 1146 F5D9  79          	LD	A,C
 1147 F5DA  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1148 F5DC  78          	LD	A,B
 1149 F5DD  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1150 F5DF  7B          	LD	A,E
 1151 F5E0  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1152 F5E2  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1153 F5E4  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1154 F5E6  3E 30       	LD	A,30H		; Write sector command
 1155 F5E8  D3 1F       	OUT	(IDESTAT),A
 1156                   	
 1157 F5EA              IDEWR3:	; wait for drq set
 1158 F5EA  DB 1F       	IN	A,(IDESTAT)	; read status
 1159 F5EC  E6 08       	AND	08H		; DRQ bit
 1160 F5EE  CA F5EA     	JP	Z,IDEWR3	; loop until bit set			
 1161                   
