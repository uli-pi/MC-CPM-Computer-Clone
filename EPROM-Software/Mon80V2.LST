  183 F030  C3 F6CA     	JP COLD		; Monitor Cold Start (no Hardware init)
  184 F033  C3 F6FB     	JP WARM		; Monitor Warm Start
  185 F036  C3 F074     	JP WRSTR	; gibt einen 0-terminierten String aus
  186                   
  187 F039  F13A        TABPTR:	DEFW TABSTART 	; Start of user jump table
  188 F03B  FE30        ENDPTR:	DEFW LASTMON 	; End address of Monitor
  189 F03D  F606        FREPTR:	DEFW FREEMEM 	; End of Monitor driver section. The area behind it can be overwritten by CP/M.
  190                   
  191                   	; Jump table for compatibility to FLOMON (NDR-Klein-Computer)
  192                   	
  193 F03F    000D      	DEFS 13 	; f033,34,35,36,37,38,39,3a,3b,3c,3d,3e,3f
  194                   			; BASIS F040h
  195 F04C  C3 F06A     	JP ILLEGAL 	; loeschen alle seiten
  196 F04F  C3 F06A     	JP ILLEGAL     	; loeschen unsichtbar
  197 F052  C3 F06A     	JP ILLEGAL 	; moveto hl=x de=y
  198 F055  C3 F06A     	JP ILLEGAL 	; drawto hl=x de=y
  199 F058  C3 F06A     	JP ILLEGAL 	; c=schreibseite 0,1,2,3
  200 F05B  C3 F06A     	JP ILLEGAL 	; c=leseseite    0,1,2,3
  201 F05E  C3 F06A     	JP ILLEGAL      ; c=rmwmode      0=norm 1=rmw
  202 F061  C3 F06A     	JP ILLEGAL 	; warten bis gdp fertig
  203 F064  C3 F06A     	JP ILLEGAL      ; c=befehl fuer gdp  ACHTUNG in C-Register nicht A
  204 F067  C3 F06A     	JP ILLEGAL 	; hl=quelle,de=ziel,c=bank quelle, b=bank ziel
  205                   			; carry wenn bankram auf f000h nicht da ist
  206                   
  207                   ; End of area of tables and fixed addresses, that are used by CP/M BIOS, UFORMAT etc.
  208                   
  209                   ;------------------------------------------------------------------------------
  210                   
  211 F06A              ILLEGAL:
  212 F06A  3E FF       	LD A,0FFh
  213 F06C  37          	SCF
  214 F06D  C9          	RET  		; return with error
  215                   
  216                   ;------------------------------------------------------------------------------
  217                   
  218 F06E  C3 FCF1     RSTRT:	JP RSTRTB 	; kann kurzgeschlossen werden
  219                   			; nach freemem ueberschreibung
  220 F071  C3 F693     INIT:	JP INIT1 	; kurzschliessen ggf.
  221                   			; ende fixed gebiet
  222                   
  223                   ;==============================================================================
  224                   ; IO Routines
  225                   ;==============================================================================
  226                   ; Output 0-terminated string, address in HL
  227                   
  228 F074  DB 21       WRSTR:	IN  A,(CO_STS)	; read status
  229 F076  E6 01       	AND CO_TXB	; check TxRDY bit
  230 F078  CA F074     	JP Z,WRSTR	; wait if not set
  231                   	
  232 F07B  7E          	LD A,(HL)	; get char from string
  233 F07C  A7          	AND A		; check if 0
  234 F07D  C8          	RET Z		; -> send of string
  235                   	
  236 F07E  D3 20       	OUT (CO_DAT),A	; write char to output
  237 F080  23          	INC HL		; next char in string
  238 F081  C3 F074     	JP WRSTR	; start over
  239                   
