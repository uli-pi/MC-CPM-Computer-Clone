  604                   ;------------------------------------------------------------------------------
  605                   
  606                   ; Old MINI routine
  607                   
  608                   ; Routinen fuer MC-Kompatibilitaet
  609                   ; wie floppy, jedoch Drive-Codierung anders
  610                   ; nur fuer bestehende BIOS-Routinen gedacht
  611                   ;
  612                   ; HL = block buffer address
  613                   ; B = 0=set step-rate and SSO, 1=read, 2=write
  614                   ; C = bit0=drive 0/1 (A/B), bit1=side 0/1, bit6=density
  615                   ; D = track
  616                   ; E = physical sector
  617                   
  618 F1E4  79          MINI:	LD A,C		; drive code
  619 F1E5  E6 7F       	AND 7FH 	; bit 7 interessiert nicht
  620 F1E7  4F          	LD C,A		; C value is used and overwritten by SCODB
  621                   
  622                   	; value for REG4-Latch -> C
  623 F1E8  F5          	PUSH AF
  624 F1E9  CD F1CA     	CALL SCODB 	; drive-code + side A -> C (value for REG4-Latch)
  625 F1EC  F1          	POP AF
  626 F1ED  E6 40       	AND 40H 	; density
  627 F1EF  C2 F1F9     	JP NZ,MINI1
  628                   	
  629                   	; single-density
  630 F1F2  79          	LD A,C
  631 F1F3  F6 30       	OR 00110000B 	; Bit5=Mini, Bit4=density (0=DD)
  632 F1F5  4F          	LD C,A
  633 F1F6  C3 F1FD     	JP MINI2
  634                   
  635 F1F9              MINI1:	; double-density
  636 F1F9  79          	LD A,C
  637 F1FA  F6 20       	OR 00100000B 	; Bit5=Mini, Bit4=density (0=DD)
  638 F1FC  4F          	LD C,A
  639                   
  640 F1FD  3E 02       MINI2:	LD A,2  	; set SSO flag
  641 F1FF  C3 F214     	JP FLOP1 	; ok ausfuehren
  642                   
  643                   ;==============================================================================
  644                   ; Floppy-Unterprogramme fuer FLO2
  645                   ; verwendet 1797 als Controller
  646                   ; Version 1.0   840506
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  12
MON80V2 Z80

  647                   ; Rolf-Dieter Klein (C) 1984 Muenchen
  648                   ;
  649                   ; Die Routinen ermoeglichen sowohl den Anschluss von Mini-,Mikro- als auch
  650                   ; von Maxi-Laufwerken. Die Routinen muessen im RAM stehen, da die Buffer
  651                   ; am Ende stehen. Alle Buffer sind jedoch gesammelt.
  652                   
  653                   ; FLO4    als Leseport
  654                   ;
  655                   ; 7 6 5 4 3 2 1 0
  656                   ;
  657                   ; DRQ   INTRQ   headld x      x x x x
  658                   ; 0=request
  659                   ;      0=request
  660                   ;  1=head down
  661                   ;
  662                   
  663                   ; FLO4    als Schreibport
  664                   ;
  665                   ; 7 6 5 4 3 2 1 0
  666                   ;
  667                   ; sso moton mini dense d c b a
  668                   ;
  669                   ; 1=Seite 1
  670                   ; 0=Motor an
  671                   ;  1=Minilaufwerk
  672                   ;   1=Single Dense
  673                   ;    -------------------------
  674                   ;      1=Laufwerk an
  675                   
  676         00C0      FLO	EQU 0C0H 		; Basisadresse Floppy-Controller
  677                   ;FLO0	EQU 0C0H   	
  678                   ;FLO1	EQU 0C1H
  679                   ;FLO2	EQU 0C2H
  680                   ;FLO3	EQU 0C3H
  681                   ;FLO4	EQU 0C4H 		; Port fuer Zusatzstatus etc.
  682                   				; write REG4-Latch
  683                   				; read REG4-Status
  684                   
  685                   ;------------------------------------------------------------------------------
  686                   ; Bei einem Interrupt wird an diese Stelle gesprungen
  687                   ; Der Interrupt erfolgt vom Floppy-Controller
  688                   
  689 F202              INTEX:	; Das INT-Program arbeitet nicht als Unterprogramm
  690 F202  F1          	POP AF  		; alte Ret-Adresse vernichten
  691 F203  DB C0       	IN A,(FLO) 		; Status lesen und INT loeschen
  692 F205  FB          	EI  			; Interrupt wieder freigeben
  693 F206  ED 4D       	RETI  			; zurueck zum vorherigen Aufrufer
  694                   
  695                   ;------------------------------------------------------------------------------
  696                   ; Floppy Routinen Init
  697                   
  698 F208  3E 02       INIFLP:	LD A,2  		; 3 = langsamste Steprate, kein SSO
  699 F20A  32 F3FA     	LD (STEPRATE),A
  700                   	
  701 F20D  3E FF       	LD A,0FFH
  702 F20F  32 F403     	LD (CURDRV),A 		; no current drive
  703 F212  C9          	RET 
  704                   
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  13
MON80V2 Z80

  705                   ;------------------------------------------------------------------------------
  706                   
  707         0038      INTVEK	EQU 38h 		; Interruptziel
  708                   
  709                   ;------------------------------------------------------------------------------
  710                   ; Haupteingang der Floppy-Routinen
  711                   ; HL = Ziel oder Quelladresse
  712                   ; E = Sektor D= Track
  713                   ; C = Laufwerkscode + Dichtecode + Seite (siehe EXFLO)
  714                   ;   7    6    5    4    3    2    1    0
  715                   ;   sso  mot  min  dens d    d    d    d
  716                   ;   sso  = seitenauswahl (0=side 0, 1=side 1)
  717                   ;   mot  = motor on code (std=0)
  718                   ;   min  = 1 bei Minilaufwerken
  719                   ;   dens = 1 bei Single Dense Aufzeichnung
  720                   ;   d = binary drive code
  721                   ;     normalerweise nur 1,2,4,8 moeglich
  722                   ;     Kombinationen moeglich, wenn binaere
  723                   ;     Dekodierung beim Laufwerk verwendet wird
  724                   ; B = 0 dann Steprate setzen + SSO-Flag
  725                   ;   = 1 dann lesen
  726                   ;   = 2 dann schreiben
  727                   
  728                   ; Entry SSO = 0
  729                   
  730 F213  AF          FLOP:	XOR A  			; SSO-Flag auf 0 setzen
  731                   
  732                   ; Entry SSO in A
  733                   ; called only from Old MINI routine
  734                   
  735 F214              FLOP1:	; SSO flag in A, only 0 and 2 allowed
  736 F214  32 F3FB     	LD (SSOFLAG),A
  737                   
  738 F217  F5          	PUSH AF
  739 F218  3A F587     	LD A,(FLOTYP)
  740 F21B  FE 01       	CP 1  
  741 F21D  C2 F226     	JP NZ,FLOP2		; -> FLO2
  742                   	
  743                   	; FLO1
  744 F220  79          	LD A,C
  745 F221  E6 BF       	AND 10111111B 		; kein autowait 
  746 F223  EE 10       	XOR 10H 		; invertieren Dichtebit fuer FLO1
  747 F225  4F          	LD C,A
  748                   
  749 F226  F1          FLOP2:	POP AF
  750 F227  ED 73 F3FC  	LD (SP0),SP 		; save user-stack, maybe to deep for BDOS
  751 F22B  31 F478     	LD SP,TSTACK 		;
  752                   
  753 F22E  3E D0       	LD A,0D0H		; ???
  754 F230  D3 C0       	OUT (FLO),A 		; reset floppy controller
  755                   	
  756                   	; set interrupt vector to INTEX
  757 F232  3A 0038     	LD A,(INTVEK)
  758 F235  32 F3FE     	LD (SAVINT),A
  759 F238  3E C3       	LD A,0C3H 		; JP-Befehl
  760 F23A  32 0038     	LD (INTVEK),A
  761 F23D  E5          	PUSH HL
  762 F23E  2A 0039     	LD HL,(INTVEK+1)
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  14
MON80V2 Z80

  763 F241  22 F3FF     	LD (SAVINT+1),HL
  764 F244  21 F202     	LD HL,INTEX 		; set to JP INTEX
  765 F247  22 0039     	LD (INTVEK+1),HL
  766 F24A  E1          	POP HL
  767                   	
  768 F24B  DB C0       	IN A,(FLO)		; Status - Port
  769 F24D  ED 56       	IM 1  			; set interrupt mode 1 ->  execure at 38h
  770 F24F  FB          	EI  			; Interrupt freigeben
  771 F250  CD F2FB     	CALL EXFLO
  772 F253  F3          	DI  			; disable interrupt
  773                   	
  774                   	; restore interrupt vector
  775 F254  F5          	PUSH AF 		; Status
  776 F255  3A F3FE     	LD A,(SAVINT)
  777 F258  32 0038     	LD (INTVEK),A 		; zurueckspeichern
  778 F25B  E5          	PUSH HL
  779 F25C  2A F3FF     	LD HL,(SAVINT+1)
  780 F25F  22 0039     	LD (INTVEK+1),HL
  781 F262  E1          	POP HL
  782 F263  F1          	POP AF
  783                   	
  784 F264  ED 7B F3FC  	LD SP,(SP0) 		; restore user-stack
  785 F268  C9          	RET
  786                   
  787                   ;------------------------------------------------------------------------------
  788                   ; Diverse Unterprogramme
  789                   ;------------------------------------------------------------------------------
  790                   ; Prepare command byte for floppy controller
  791                   
  792 F269              SETCMD:				; testet ob der Kopf noch
  793                   				; geladen ist und setzt die
  794 F269  06 00       	LD B,0  		; Flag fuer SSO-Bit
  795 F26B  3A F402     	LD A,(DRVCOD) 		; wenn Bit 7 gesetzt, dann abfragen
  796 F26E  E6 80       	AND 80H
  797 F270  28 11       	JR Z,SETC2 		; Seite 0, immer mit SSO=0
  798                   	
  799 F272  3A F3FA     	LD A,(STEPRATE) 	; jetzt pruefen ob flags da
  800 F275  E6 80       	AND 80H 		; <>0, dann SSO setzen, wenn seite 1
  801 F277  28 04       	JR Z,SETC1 		; =0, dann code 0, oder SSOFLAG
  802                   	
  803 F279  06 02       	LD B,2  		; SSO setzen 
  804 F27B  18 06       	JR SETC2
  805                   
  806 F27D              SETC1:	; pruefen ob SSO-Flag
  807 F27D  3A F3FB     	LD A,(SSOFLAG) 		; ok, 2=Flag
  808 F280  E6 02       	AND 2  			; SSO-Bit
  809 F282  47          	LD B,A  		; 0,2 erlaubt 
  810                   
  811 F283              SETC2:	; entsprechenden Bits
  812 F283  DB C4       	IN A,(FLO+4) 		; REG4-Status
  813 F285  E6 20       	AND 20H 		; Head-Load Bit
  814 F287  20 04       	JR NZ,SETC3 		; =1 dann Kopf auf Diskette
  815                   	
  816 F289  78          	LD A,B
  817 F28A  F6 04       	OR 04h 			; sonst Bitmaske fuer headdown
  818 F28C  C9          	RET
  819                   
  820 F28D              SETC3:	; noset
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  15
MON80V2 Z80

  821 F28D  78          	LD A,B
  822 F28E  C9          	RET 			; Code belassen
  823                   
  824                   ;------------------------------------------------------------------------------
  825                   ; Read one sector
  826                   ; sector number in E
  827                   
  828 F28F  79          RDFLP:	LD A,C
  829 F290  D3 C4       	OUT (FLO+4),A 		; erst mal Dichtecode setzen und Seite -> REG4-Latch
  830 F292  7B          	LD A,E
  831 F293  D3 C2       	OUT (FLO+2),A 		; ins Sektorregister
  832 F295  0E C3       	LD C,FLO+3 		; Adresse Datenport dann nach c
  833 F297  CD F269     	CALL SETCMD 		; Register A vorbereiten
  834 F29A  C6 88       	ADD A,88H 		; Lese-Befehl, sidesel=0
  835 F29C  D3 C0       	OUT (FLO),A 		; Befehl ausfuehren
  836                   
  837 F29E              RDFLP1:	; wait for DRQ
  838 F29E  DB C4       	IN A,(FLO+4) 		; DRQ schon da ?
  839 F2A0  07          	RLCA  			; bit7 = drq, bit6 = int
  840 F2A1  D2 F29E     	JP NC,RDFLP1 		; bis drq=1 da ist
  841                   	
  842 F2A4  ED A2       	INI  			; IN (C) -> (HL), HL++
  843 F2A6  C3 F29E     	JP RDFLP1  		; verlassen nur durch INT
  844                   
  845                   ;------------------------------------------------------------------------------
  846                   ; Write one sector
  847                   
  848 F2A9  79          WRFLP:	LD A,C
  849 F2AA  D3 C4       	OUT (FLO+4),A 		; erst mal Seite anwaehlen und Dichte -> REG4-Latch
  850 F2AC  7B          	LD A,E  		; Sektorregister setzen
  851 F2AD  D3 C2       	OUT (FLO+2),A
  852 F2AF  0E C3       	LD C,FLO+3		; Adresse Datenport laden
  853 F2B1  CD F269     	CALL SETCMD		; E-Code in A laden
  854 F2B4  C6 A8       	ADD A,0A8H		; Befehl Schreibe-Sektor
  855 F2B6  D3 C0       	OUT (FLO),A 		; und Befehl ausfuehren
  856                   
  857 F2B8              WRFLP1:	; wait for DRQ
  858 F2B8  DB C4       	IN A,(FLO+4)
  859 F2BA  07          	RLCA
  860 F2BB  D2 F2B8     	JP NC,WRFLP1
  861                   	
  862 F2BE  ED A3       	OUTI  			; (HL) -> OUT (C), HL++
  863 F2C0  C3 F2B8     	JP WRFLP1  		; verlassen nur durch INT
  864                   
  865                   ;------------------------------------------------------------------------------
  866                   ; delay: 4 ms at 4 MHz
  867                   
  868 F2C3  C5          WAWA:	PUSH BC 		; pro Schleife ca 6us bei 4MHz
  869 F2C4  01 01F4     	LD BC,500 		; 500*6us Dauer
  870 F2C7  CD F2CC     	CALL DELAY
  871 F2CA  C1          	POP BC
  872 F2CB  C9          	RET
  873                   
  874                   ;------------------------------------------------------------------------------
  875                   ; delay: 6 microseconds at 4 MHz
  876                   
  877 F2CC  0B          DELAY:	DEC BC
  878 F2CD  78          	LD A,B
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  16
MON80V2 Z80

  879 F2CE  B1          	OR C
  880 F2CF  C2 F2CC     	JP NZ,DELAY
  881                   	
  882 F2D2  C9          	RET
  883                   
  884                   ;------------------------------------------------------------------------------
  885                   ; Seek to track
  886                   ; C=Drive D=Track E=Sector
  887                   
  888 F2D3  CD F2C3     SEEK:	CALL WAWA 		; short delay
  889                   
  890 F2D6  79          	LD A,C
  891 F2D7  D3 C4       	OUT (FLO+4),A 		; drive code, density and side -> REG4-Latch
  892 F2D9  7B          	LD A,E
  893 F2DA  D3 C2       	OUT (FLO+2),A 		; Sector
  894 F2DC  7A          	LD A,D
  895 F2DD  D3 C3       	OUT (FLO+3),A 		; track
  896 F2DF  06 1C       	LD B,1CH 		; seek command
  897 F2E1  3A F3FA     	LD A,(STEPRATE)
  898 F2E4  E6 03       	AND 3  			; 0,1,2,3 zulaessig
  899 F2E6  B0          	OR B  			; 
  900 F2E7  D3 C0       	OUT (FLO),A 		; execute Seek together with steprate
  901                   
  902 F2E9  76          	HALT  			; wait for INT
  903                   
  904                   ;------------------------------------------------------------------------------
  905                   ; Kopf auf Spur 0 stellen
  906                   			
  907 F2EA  CD F2C3     RSTORE:	CALL WAWA		; short delay
  908                   
  909 F2ED  79          	LD A,C  		; Laufwerkscode (drive)
  910 F2EE  D3 C4       	OUT (FLO+4),A 		; mit Dichtecode etc. ausgeben -> REG4-Latch
  911                   	
  912 F2F0  06 08       	LD B,8  		; nur Head-load, kein verify
  913 F2F2  3A F3FA     	LD A,(STEPRATE)
  914 F2F5  E6 03       	AND 3  			; 0,1,2,3 zulaessig
  915 F2F7  B0          	OR B  			; als Befehl kombiniert
  916 F2F8  D3 C0       	OUT (FLO),A 		; und ausfuehren
  917                   	
  918 F2FA  76          	HALT  			; wait for INT
  919                   
  920                   ;------------------------------------------------------------------------------
  921                   ; Floppy Kernal Routines
  922                   
  923                   ; HL=Address, d=Track e=Sector
  924                   ; b=Command (0=set steprate+SSO, 1=read, 2=write)
  925                   ; c=drive code
  926                   ;   aufgebaut wie Special Register 4
  927                   ;   7    6    5    4    3    2    1    0
  928                   ;   sso  mot  min  dens d    d    d    d
  929                   ;   sso  = seitenauswahl (1=seite 1)
  930                   ;   mot  = motor on code (std=0)
  931                   ;   min  = 1 bei Minilaufwerken
  932                   ;   dens = 1 bei Single Dense Aufzeichnung
  933                   ; d=binary drive code
  934                   ;   normalerweise nur 1,2,4,8 moeglich
  935                   ;   Kombinationen moeglich, wenn binaere
  936                   ;   Dekodierung beim Laufwerk verwendet wird
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  17
MON80V2 Z80

  937                   
  938 F2FB  78          EXFLO:	LD A,B			; B = command
  939 F2FC  B7          	OR A
  940 F2FD  20 08       	JR NZ,EXFL1
  941                   
  942                   	;---------------------------------------------------------------------
  943                   	; B=0: set steprate and SSO
  944                   	; steprate in D, Bit0/1=steprate, bit7=SSO
  945                   	
  946 F2FF  7A          	LD A,D   		; (+80h =SSO verwenden und pruefen).
  947 F300  E6 83       	AND 83h  		; Bit 7=SSO-Flag bei Zugriffen wichtig
  948 F302  32 F3FA     	LD (STEPRATE),A		; die die zweite Seite verwenden.
  949 F305  AF          	XOR A
  950 F306  C9          	RET
  951                   
  952                   	;---------------------------------------------------------------------
  953                   
  954 F307  AF          EXFL1:	XOR A
  955 F308  32 F401     	LD (ERRCNT),A 		; Fehlerzahl 0
  956 F30B  79          	LD A,C
  957 F30C  32 F402     	LD (DRVCOD),A 		; drive-code
  958 F30F  E6 0F       	AND 0FH 		; in bit 0..3
  959 F311  4F          	LD C,A
  960 F312  3A F403     	LD A,(CURDRV)
  961 F315  FE FF       	CP 0FFH 		; current drive invalid -> set
  962 F317  28 14       	JR Z,EXFL2
