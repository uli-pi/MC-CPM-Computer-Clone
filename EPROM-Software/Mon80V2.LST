  774                   ;------------------------------------------------------------------------------
  775                   ; Floppy-Kernroutinen
  776                   
  777                   ; hl=adresse, d=track e=sektor
  778                   ; b=Befehl 0=Steprate setzen 1=read 2=write
  779                   ; c=Laufwerkscode
  780                   ;   aufgebaut wie Statusregister
  781                   ; 7    6    5    4    3    2    1    0
  782                   ; sso  mot  min  dens d    d    d    d
  783                   ; sso  = seitenauswahl 1=seite 1
  784                   ; mot  = motor on code std=0
  785                   ; min  = 1 bei Minilaufwerken
  786                   ; dens = 1 bei Single Dense Aufzeichnung
  787                   ; d=binaerer Laufwerkscode
  788                   ;   normalerweise nur 1,2,4,8 moeglich
  789                   ;   Kombinationen moeglich, wenn binaere
  790                   ;   Dekodierung beim Laufwerk verwendet wird
  791                   
  792 F2FB  78          softex:	LD A,B
  793 F2FC  B7          	OR A
  794 F2FD  20 08       	JR NZ, SOFT1  		; dann Steprate in Register D (0..3)
  795 F2FF  7A          	LD A,D   			;(+80h =SSO verwenden und pruefen).
  796 F300  E6 83       	AND 83H  			; Bit 7=SSO-Flag bei Zugriffen wichtig,
  797 F302  32 F3FA     	LD (STEPRATE),A		; die die zweite Seite verwenden.
  798 F305  AF          	XOR A
  799 F306  C9          	RET
  800                   
  801 F307  AF          soft1:	XOR A
  802 F308  32 F401     	LD (FEHZA),A 		; Fehlerzahl 0
  803 F30B  79          	LD A,C
