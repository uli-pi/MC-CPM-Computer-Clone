  125         0018      IDEDATA	EQU 018h	; IDE Data Register
  126         001A      SECCND	EQU 01Ah	; Sector Count Register
  127         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
  128         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
  129         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
  130         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
  131         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
  132                   
  133                   ;------------------------------------------------------------------------------
  134                   
  135         0000      	ORG 0000h		; start address in ROM
  136                   
  137                   	; Copy Monitor from address ROMSTRT in ROM to address F000 in RAM
  138                   
  139 0000  31 FFFF     BEGIN:	LD SP,0FFFFh 		; set Stack to end of memory
  140 0003  3E C9       	LD A,0C9h 		; place RET command at F000h
  141 0005  32 F000     	LD (0F000h),A 		; 
  142 0008  CD F000     	CALL 0F000h 		; and call it
  143                   
  144 000B  3B          OFFS:	DEC SP  		; get return address from Stack to calculate
  145 000C  3B          	DEC SP  		; Monitor location in ROM
  146 000D  D1          	POP DE
  147 000E  21 0012     	LD HL,ROMSTRT-OFFS	; offset from BEG to ROMSTRT
  148 0011  19          	ADD HL,DE		; actual Montor address in ROM as source address in HL
  149 0012  11 F000     	LD DE,0F000h 		; dest address in DE
  150 0015  01 0FFF     	LD BC,0FFFh 		; length in BC (4KB - 1)
  151 0018  ED B0       	LDIR  			; copy
  152 001A  C3 F000     	JP 0F000h 		; jump to Monitor in RAM
  153                   
  154                   ;------------------------------------------------------------------------------
  155                   ; Start of Monitor program, ROM address 0F000h
  156                   
  157 001D              ROMSTRT:
  158                   	; Start address of Monitor in ROM
  159                   	; label must be located before .PHASE
  160                   
  161                   	.PHASE 0F000H	; monitor start address in RAM
  162                   
  163 F000  C3 F071     	JP INIT
  164 F003  C3 F084     	JP CONIN	; Console In
  165 F006  C3 F097     	JP READIN	; Reader In (<- SIO B)
  166 F009  C3 F0AD     	JP CONOUT	; Console Out
  167 F00C  C3 F0C1     	JP PUNOUT	; Punch Out (-> SIO B)
  168 F00F  C3 F0D8     	JP LSTOUT	; List Out (-> SIO B)
  169 F012  C3 F0EF     	JP CONSTS	; Get console status, 0FFh in A, if character available
  170 F015  C3 F102     	JP IOGET	; Get iobyte, current configuration in A
  171 F018  C3 F106     	JP IOSET	; Set iobyte, new configuration in C
  172 F01B  C3 F10B     	JP MEMCHK	; High memory in B, low memory in A
  173                   
  174 F01E              TRAP:	; trap/breakpoint entry -> RSTRT
  175                   
  176 F01E  C3 F06E     	JP RSTRT
  177                   	
  178 F021  C3 F213     	JP FLOP	 	; new floppy interface rev 1.0
  179 F024  C3 F1A9     	JP MAXI		; FLOPPY EXEC VEKTOR SOFT (old)
  180 F027  C3 F1E4     	JP MINI		; FLOPPY EXEC VEKTOR MINI (old)
  181 F02A  C3 F588     	JP IDERD	; Read IDE sector
  182 F02D  C3 F5C7     	JP IDEWR	; Write IDE Sector
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page   4
