  983 F332  E6 0F       	AND 0FH 		; nur Laufwerkscode
  984 F334  4F          	LD C,A
  985 F335  06 00       	LD B,0
  986 F337  21 F404     	LD HL,DRVTAB 		; Tabellenstart
