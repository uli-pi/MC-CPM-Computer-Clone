  760 F2D3              seek:				; Spur anfahren C=Drive D=Spur E=Sektor
  761 F2D3  CD F2C3     	CALL WAWA 		; sicherheitshalber warten
  762 F2D6  79          	LD A,C
  763 F2D7  D3 C4       	OUT (FLO+4),A 		; Drive-Code und Dichte sowie Seite
  764 F2D9  7B          	LD A,E
  765 F2DA  D3 C2       	OUT (FLO+2),A 		; Sektor
  766 F2DC  7A          	LD A,D
  767 F2DD  D3 C3       	OUT (FLO+3),A 		; Spur
  768 F2DF  06 1C       	LD B,1CH 		; Seek-Befehl
  769 F2E1  3A F3FA     	LD A,(STEPRATE)
  770 F2E4  E6 03       	AND 3  			; 0,1,2,3  zulaessig
  771 F2E6  B0          	OR B  			; Seek Befehl zusammen mit Steprate
  772 F2E7  D3 C0       	OUT (FLO),A 		; als Befehl ausgeben
  773 F2E9  76          	HALT  			; warten bis INT
  774                   
  775                   ;------------------------------------------------------------------------------
  776                   
  777 F2EA              rstore:				; Kopf auf Spur 0 stellen
  778 F2EA  CD F2C3     	CALL WAWA
  779 F2ED  79          	LD A,C  		; Laufwerkscode (drive)
  780 F2EE  D3 C4       	OUT (FLO+4),A 		; mit Dichtecode etc. ausgeben
  781 F2F0  06 08       	LD B,8  		; nur Head-load, kein verify
  782 F2F2  3A F3FA     	LD A,(STEPRATE)
  783 F2F5  E6 03       	AND 3  			; 0,1,2,3 zulaessig
  784 F2F7  B0          	OR B  			; als Befehl kombiniert
  785 F2F8  D3 C0       	OUT (FLO),A 		; und ausfuehren
  786 F2FA  76          	HALT  			; bis INT dort warten
  787                   
  788                   ;------------------------------------------------------------------------------
  789                   ; Floppy-Kernroutinen
  790                   
  791                   ; hl=adresse, d=track e=sektor
  792                   ; b=Befehl 0=Steprate setzen 1=read 2=write
  793                   ; c=Laufwerkscode
  794                   ;   aufgebaut wie Statusregister
  795                   ; 7    6    5    4    3    2    1    0
  796                   ; sso  mot  min  dens d    d    d    d
  797                   ; sso  = seitenauswahl 1=seite 1
  798                   ; mot  = motor on code std=0
  799                   ; min  = 1 bei Minilaufwerken
  800                   ; dens = 1 bei Single Dense Aufzeichnung
  801                   ; d=binaerer Laufwerkscode
  802                   ;   normalerweise nur 1,2,4,8 moeglich
  803                   ;   Kombinationen moeglich, wenn binaere
  804                   ;   Dekodierung beim Laufwerk verwendet wird
  805                   
  806 F2FB  78          softex:	LD A,B
  807 F2FC  B7          	OR A
  808 F2FD  20 08       	JR NZ, SOFT1  		; dann Steprate in Register D (0..3)
  809 F2FF  7A          	LD A,D   		; (+80h =SSO verwenden und pruefen).
  810 F300  E6 83       	AND 83H  		; Bit 7=SSO-Flag bei Zugriffen wichtig,
  811 F302  32 F3FA     	LD (STEPRATE),A		; die die zweite Seite verwenden.
  812 F305  AF          	XOR A
  813 F306  C9          	RET
  814                   
  815 F307  AF          soft1:	XOR A
  816 F308  32 F401     	LD (FEHZA),A 		; Fehlerzahl 0
  817 F30B  79          	LD A,C
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  15
MON80V2 Z80

  818 F30C  32 F402     	LD (CCODE),A 		; Drive-Code
  819 F30F  E6 0F       	AND 0FH 		; fuer Vergleich
  820 F311  4F          	LD C,A  		; wieder zurueck
  821 F312  3A F403     	LD A,(DRVAT)
  822 F315  FE FF       	CP 0FFH 		; ungueltig, dann setzen noetig
  823 F317  28 14       	JR Z,NOTDEF
  824 F319  E6 0F       	AND 0FH 		; nur Laufwerksnummer relevant
  825 F31B  B9          	CP C  			; Vergleich ob Laufwerkewechsel
  826 F31C  CA F35B     	JP Z,NURSEEK 		; nur Seek noetig
  827 F31F  E5          	PUSH HL
  828 F320  C5          	PUSH BC
  829 F321  21 F404     	LD HL,DRVTAB 		; Basisadresse
  830 F324  4F          	LD C,A
  831 F325  06 00       	LD B,0  		; alten Laufwerktrack merken
  832 F327  09          	ADD HL,BC
  833 F328  DB C1       	IN A,(FLO+1) 		; Tracknr
  834 F32A  77          	LD (HL),A 		; und dort ablegen
  835 F32B  C1          	POP BC
  836 F32C  E1          	POP HL
  837                   	
  838 F32D              notdef:				; Drive nur laden
  839 F32D  E5          	PUSH HL
  840 F32E  C5          	PUSH BC
  841 F32F  3A F402     	LD A,(CCODE) 		; neues Laufwerk
  842 F332  E6 0F       	AND 0FH 		; nur Laufwerkscode
  843 F334  4F          	LD C,A
  844 F335  06 00       	LD B,0
  845 F337  21 F404     	LD HL,DRVTAB 		; Tabellenstart
  846 F33A  09          	ADD HL,BC 		; hl zeigt auf Laufwerkstrack
  847 F33B  7E          	LD A,(HL)
  848 F33C  D3 C1       	OUT (FLO+1),A 		; und ins Register des FDs
  849 F33E  C1          	POP BC
  850 F33F  E1          	POP HL
  851 F340  3A F402     	LD A,(CCODE)
  852 F343  32 F403     	LD (DRVAT),A 		; ist nun neues Laufwerk
  853 F346  C5          	PUSH BC
  854 F347  01 00FA     	LD BC,1000*3/12		; ca 1ms warten
  855 F34A  CD F2CC     	CALL DELAY
  856 F34D  3A F402     	LD A,(CCODE) 		; Dann neues Laufwerk ansprechen
  857 F350  D3 C4       	OUT (FLO+4),A
  858 F352  01 0B65     	LD BC,2917		; ca 35ms .. 15ms
  859 F355  CD F2CC     	CALL DELAY		; um head-load-Zeit zu beruecksichtigen 
  860 F358  C1          	POP BC  		; alte Codes zurueck
  861 F359  18 06       	JR NUR1 		; Immer auf ready pruefen, da
  862                   				; head down sein kann und dennoch
  863                   				; nicht ready
  864                   
  865 F35B              nurseek:
  866 F35B  DB C4       	IN A,(FLO+4) 		; wenn head down dann kein dummyseek
  867 F35D  E6 20       	AND 20H
  868 F35F  20 0D       	JR NZ,NODUM
  869 F361              nur1:				; immer einsprung
  870 F361  3A F402     	LD A,(CCODE)
  871 F364  4F          	LD C,A
  872 F365  CD F3F0     	CALL SEEKEX 		; seek selekt dummy nur fuer readytest
  873 F368  DB C0       	IN A,(FLO)		; test Status
  874 F36A  E6 80       	AND 80H 		; fuer Ready
  875 F36C  20 F3       	JR NZ,NUR1		; Wiederhole solange bis Laufwerk READY
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  16
MON80V2 Z80

  876 F36E              nodum:				; Einsprung head down ok
  877 F36E  DB C1       	IN A,(FLO+1) 		; nun pruefen of Tracks gleich sind
  878 F370  FE FF       	CP 0FFH 		; nicht definiert
  879 F372  28 0F       	JR Z,TRY1 		; dann zuerst RESTORE
  880 F374  BA          	CP D  			; oder schon auf dem Track
  881 F375  CA F3A2     	JP Z,SK11 		; ja dann nur lesen,schreiben
  882 F378              	TRY:  			; SEEK ausfuehren
  883 F378  3A F402     	LD A,(CCODE)
  884 F37B  4F          	LD C,A
  885 F37C  CD F3F0     	CALL SEEKEX 		; und Track anfahren Reg retten
  886 F37F  E6 90       	AND 10010000B 		; Fehlermaske
  887 F381  28 1F       	JR Z,SK11 		; ja dann R/W moeglich
  888 F383              try1:				; Laufwerk normieren und RSTORE
  889 F383  3A F402     	LD A,(CCODE)
  890 F386  4F          	LD C,A
  891 F387  E5          	PUSH HL
  892 F388  D5          	PUSH DE
  893 F389  C5          	PUSH BC
  894 F38A  CD F2EA     	CALL RSTORE
  895 F38D  C1          	POP BC
  896 F38E  D1          	POP DE
  897 F38F  E1          	POP HL
  898 F390  3A F401     	LD A,(FEHZA) 		; Fehler erhoehen
