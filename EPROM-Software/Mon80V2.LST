  994                   ;==============================================================================
  995                   ; IDE Karten Interface f|r CF-Karte
  996                   ;
  997                   ; Subroutine to read one IDE/ATA Disk sector (256 bytes)
  998                   ; Address to place data passed in HL
  999                   ; LBA bits 0 to 7 passed in C, bits 8 to 15 passed in B
 1000                   ; LBA bits 16 to 23 passed in E
 1001                   ;
 1002                   
 1003 F588              IDERD:
 1004 F588  DB 1F       IDERD1:	IN	A,(IDESTAT)	; check status
 1005 F58A  E6 80       	AND	80H		; check BSY bit
 1006 F58C  C2 F588     	JP	NZ,IDERD1	; loop until not busy
 1007                   
 1008 F58F  DB 1F       IDERD2:	IN	A,(IDESTAT)	; check	status
 1009 F591  E6 40       	AND	40H		; check DRDY bit
 1010 F593  CA F58F     	JP	Z,IDERD2	; loop until ready
 1011                   
 1012 F596  3E 01       	LD	A,01H		; number of sectors = 1
 1013 F598  D3 1A       	OUT	(SECCND),A	; sector count register
 1014 F59A  79          	LD	A,C
 1015 F59B  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1016 F59D  78          	LD	A,B
 1017 F59E  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1018 F5A0  7B          	LD	A,E
 1019 F5A1  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1020 F5A3  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1021 F5A5  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1022 F5A7  3E 20       	LD	A,20H		; Read sector command
 1023 F5A9  D3 1F       	OUT	(IDESTAT),A
 1024                   
 1025 F5AB              IDERD3:	; WAIT FOR DRQ SET
 1026 F5AB  DB 1F       	IN	A,(IDESTAT)	; read status
 1027 F5AD  E6 08       	AND	08H		; DRQ bit
 1028 F5AF  CA F5AB     	JP	Z,IDERD3	; loop until bit set
 1029                   	
 1030 F5B2              IDERD4:	; WAIT FOR BUSY CLEay
 1031 F5B2  DB 1F       	IN	A,(IDESTAT)
 1032 F5B4  E6 80       	AND	80H
 1033 F5B6  C2 F5B2     	JP	NZ,IDERD4
 1034                   	
 1035 F5B9  DB 1F       	IN	A,(IDESTAT)	; clear INTRQ
 1036                   
 1037 F5BB              IDERD5: ; READ LOOP
 1038 F5BB  DB 18       	IN	A,(IDEDATA)	; get data
 1039 F5BD  77          	LD	(HL),A
 1040 F5BE  23          	INC	HL
 1041 F5BF  DB 1F       	IN	A,(IDESTAT)	; check status
 1042 F5C1  E6 08       	AND	08H		; DRQ bit
 1043 F5C3  C2 F5BB     	JP	NZ,IDERD5	; loop until cleared
 1044                   	
 1045 F5C6  C9          	RET
 1046                   			
 1047                   ;------------------------------------------------------------------------------
 1048                   ;
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  19
