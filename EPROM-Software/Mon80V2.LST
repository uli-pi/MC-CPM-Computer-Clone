  299                   ;------------------------------------------------------------------------------
  300                   ; Console Status main routine
  301                   
  302 F0EF  3A F14C     CONSTS:	LD A,(IOBYT)
  303 F0F2  E6 03       	AND 03h
  304 F0F4  20 09       	JR NZ,CONS2
  305                   	
  306 F0F6  DB 21       CONS1:	IN A,(U_STS)
  307 F0F8  E6 02       	AND U_RXB
  308 F0FA  C8          	RET Z
  309                   	
  310 F0FB  3E FF       	LD A,0FFH
  311 F0FD  B7          	OR A
  312 F0FE  C9          	RET
  313                   
  314 F0FF  C3 F149     CONS2:	JP USERCSTS	; user csts
