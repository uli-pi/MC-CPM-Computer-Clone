  809 F317  28 14       	JR Z,NOTDEF
  810 F319  E6 0F       	AND 0FH 			; nur Laufwerksnummer relevant
  811 F31B  B9          	CP C  			; Vergleich ob Laufwerkewechsel
  812 F31C  CA F35B     	JP Z,NURSEEK 		; nur Seek noetig
  813 F31F  E5          	PUSH HL
  814 F320  C5          	PUSH BC
