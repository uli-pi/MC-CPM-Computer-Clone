 1034                   ;==============================================================================
 1035                   ; IDE/CF card interface
 1036                   ;
 1037                   ; Read one IDE/CF card sector (256 bytes)
 1038                   ;
 1039                   ; Address for data in HL
 1040                   ; LBA bits 0 to 7 passed in C
 1041                   ; LBA bits 8 to 15 passed in B
 1042                   ; LBA bits 16 to 23 passed in E
 1043                   
 1044 F588              IDERD:
 1045 F588  DB 1F       IDERD1:	IN	A,(IDESTAT)	; check status
 1046 F58A  E6 80       	AND	80H		; check BSY bit
 1047 F58C  C2 F588     	JP	NZ,IDERD1	; loop until not busy
 1048                   
 1049 F58F  DB 1F       IDERD2:	IN	A,(IDESTAT)	; check	status
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  19
MON80V2 Z80

 1050 F591  E6 40       	AND	40H		; check DRDY bit
 1051 F593  CA F58F     	JP	Z,IDERD2	; loop until ready
 1052                   
 1053 F596  3E 01       	LD	A,01H		; number of sectors = 1
 1054 F598  D3 1A       	OUT	(SECCND),A	; sector count register
 1055 F59A  79          	LD	A,C
 1056 F59B  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1057 F59D  78          	LD	A,B
 1058 F59E  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1059 F5A0  7B          	LD	A,E
 1060 F5A1  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1061 F5A3  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1062 F5A5  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1063 F5A7  3E 20       	LD	A,20H		; Read sector command
 1064 F5A9  D3 1F       	OUT	(IDESTAT),A
 1065                   
 1066 F5AB              IDERD3:	; wait for drq set
 1067 F5AB  DB 1F       	IN	A,(IDESTAT)	; read status
 1068 F5AD  E6 08       	AND	08H		; DRQ bit
 1069 F5AF  CA F5AB     	JP	Z,IDERD3	; loop until bit set
 1070                   	
 1071 F5B2              IDERD4:	; wait for busy clear
 1072 F5B2  DB 1F       	IN	A,(IDESTAT)
 1073 F5B4  E6 80       	AND	80H
 1074 F5B6  C2 F5B2     	JP	NZ,IDERD4
 1075                   	
 1076 F5B9  DB 1F       	IN	A,(IDESTAT)	; clear INTRQ
 1077                   
 1078 F5BB              IDERD5: ; read loop
 1079 F5BB  DB 18       	IN	A,(IDEDATA)	; get data
 1080 F5BD  77          	LD	(HL),A
 1081 F5BE  23          	INC	HL
 1082 F5BF  DB 1F       	IN	A,(IDESTAT)	; check status
 1083 F5C1  E6 08       	AND	08H		; DRQ bit
 1084 F5C3  C2 F5BB     	JP	NZ,IDERD5	; loop until cleared
 1085                   	
 1086 F5C6  C9          	RET
