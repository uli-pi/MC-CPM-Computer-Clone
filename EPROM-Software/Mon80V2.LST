  995 F332  E6 0F       	AND 0FH 		; nur Laufwerkscode
  996 F334  4F          	LD C,A
  997 F335  06 00       	LD B,0
  998 F337  21 F404     	LD HL,DRVTAB 		; Tabellenstart
  999 F33A  09          	ADD HL,BC 		; HL zeigt auf Laufwerkstrack
 1000 F33B  7E          	LD A,(HL)
 1001 F33C  D3 C1       	OUT (FLO+1),A 		; und ins Register des FDs
 1002 F33E  C1          	POP BC
 1003 F33F  E1          	POP HL
 1004 F340  3A F402     	LD A,(DRVCOD)
 1005 F343  32 F403     	LD (CURDRV),A 		; ist nun neues Laufwerk
 1006 F346  C5          	PUSH BC
 1007 F347  01 00FA     	LD BC,1000*3/12		; ca 1ms warten
 1008 F34A  CD F2CC     	CALL DELAY
 1009 F34D  3A F402     	LD A,(DRVCOD) 		; Dann neues Laufwerk ansprechen
 1010 F350  D3 C4       	OUT (FLO+4),A		; -> REG4-Latch
 1011 F352  01 0B65     	LD BC,2917		; ca 35ms .. 15ms
 1012 F355  CD F2CC     	CALL DELAY		; um headload-Zeit zu beruecksichtigen 
 1013 F358  C1          	POP BC  		; alte Codes zurueck
 1014 F359  18 06       	JR EXFL4 		; Immer auf ready pruefen, da
 1015                   				; head down sein kann und dennoch nicht ready
 1016                   
 1017 F35B              EXFL3:	; seek only
 1018 F35B  DB C4       	IN A,(FLO+4)
 1019 F35D  E6 20       	AND 20H
 1020 F35F  20 0D       	JR NZ,EXFL5		; -> head down, no dummy seek
 1021                   
 1022 F361              EXFL4:	; repeat seek command (ready test only)
 1023 F361  3A F402     	LD A,(DRVCOD)
 1024 F364  4F          	LD C,A
 1025 F365  CD F3F0     	CALL EXSEEK 		; seek select dummy nur fuer ready-test
 1026 F368  DB C0       	IN A,(FLO)		; test Status
 1027 F36A  E6 80       	AND 80H 		; fuer Ready
 1028 F36C  20 F3       	JR NZ,EXFL4		; repeat until ready
 1029                   
 1030 F36E              EXFL5:	; entry head down ok
 1031 F36E  DB C1       	IN A,(FLO+1) 		; nun pruefen ob Tracks gleich sind
 1032 F370  FE FF       	CP 0FFH 		; nicht definiert
 1033 F372  28 0F       	JR Z,EXFL7 		; dann zuerst RESTORE
 1034                   
 1035 F374  BA          	CP D  			; oder schon auf dem Track
 1036 F375  CA F3A2     	JP Z,EXFL9 		; -> ja dann nur lesen/schreiben
 1037                   
 1038 F378              EXFL6:	; loop seek
 1039 F378  3A F402     	LD A,(DRVCOD)
 1040 F37B  4F          	LD C,A
 1041 F37C  CD F3F0     	CALL EXSEEK 		; und Track anfahren Reg retten
 1042 F37F  E6 90       	AND 10010000B 		; Fehlermaske
 1043 F381  28 1F       	JR Z,EXFL9 		; -> ja dann R/W moeglich
 1044                   	
 1045 F383              EXFL7:	; Laufwerk normieren und RSTORE
 1046 F383  3A F402     	LD A,(DRVCOD)
 1047 F386  4F          	LD C,A
 1048 F387  E5          	PUSH HL
 1049 F388  D5          	PUSH DE
 1050 F389  C5          	PUSH BC
 1051 F38A  CD F2EA     	CALL RSTORE		; track 0
 1052 F38D  C1          	POP BC
