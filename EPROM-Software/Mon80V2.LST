 1249 F5C9  E6 80       	AND	80H		; check BSY bit
 1250 F5CB  C2 F5C7     	JP	NZ,IDEWR1	; loop until not busy
 1251                   
 1252 F5CE  DB 1F       IDEWR2:	IN	A,(IDESTAT)	; check status
 1253 F5D0  E6 40       	AND	40H		; check DRDY bit
 1254 F5D2  CA F5CE     	JP	Z,IDEWR2	; loop until ready
 1255                   
 1256 F5D5  3E 01       	LD	A,01H		; number of sectors = 1
 1257 F5D7  D3 1A       	OUT	(SECCND),A	; sector count register
 1258 F5D9  79          	LD	A,C
 1259 F5DA  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1260 F5DC  78          	LD	A,B
 1261 F5DD  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1262 F5DF  7B          	LD	A,E
 1263 F5E0  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1264 F5E2  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1265 F5E4  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1266 F5E6  3E 30       	LD	A,30H		; Write sector command
 1267 F5E8  D3 1F       	OUT	(IDESTAT),A
 1268                   	
 1269 F5EA              IDEWR3:	; wait for drq set
 1270 F5EA  DB 1F       	IN	A,(IDESTAT)	; read status
 1271 F5EC  E6 08       	AND	08H		; DRQ bit
 1272 F5EE  CA F5EA     	JP	Z,IDEWR3	; loop until bit set			
 1273                   
 1274 F5F1              IDEWR4:	; write loop
 1275 F5F1  7E          	LD	A,(HL)
 1276 F5F2  D3 18       	OUT	(IDEDATA),A	; write data
 1277 F5F4  23          	INC	HL
 1278 F5F5  DB 1F       	IN	A,(IDESTAT)	; read status
 1279 F5F7  E6 08       	AND	08H		; check DRQ bit
 1280 F5F9  C2 F5F1     	JP	NZ,IDEWR4	; write until bit cleared
 1281                   
 1282 F5FC              IDEWR5:	; wait for busy clear
 1283 F5FC  DB 1F       	IN	A,(IDESTAT)
 1284 F5FE  E6 80       	AND	80H
