  443                   ; Floppy Interface Paket Rev 1.0   841031
  444                   ; (C) 1984 Muenchen, Rolf-Dieter Klein
  445                   
  446                   ; Routinen fuer MC-Kompatibilitaet
  447                   ; wie floppy, jedoch Drive-Codierung anders
  448                   ; nur fuer bestehende BIOS-Routinen gedacht
  449                    
  450                   ; bei Maxi wird die Seite 1 mit Seitenpruefung auf 0
  451                   ; angesprochen, bei Mini mit Seitenpruefung auf 1.
  452                   ; nur fuer SD
  453                   
  454                   ; c=0,1,2,3
  455                   ; 	0,2 gekoppelt  1,3 gekoppelt					
  456                   
  457 F1A9  CD F1AF     maxi:	CALL SETCOD
  458 F1AC  C3 F213     	JP FLOP		; sso-flag auf 0 setzen, jedoch stepflag
  459                   			; gueltig wenn bit 7 gesetzt.
