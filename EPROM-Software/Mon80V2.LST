  173                   ; IO Routinen
  174                   ;==============================================================================
  175                   ; Output 0-terminated string, address in HL
  176                   
  177 F074  DB 21       WRSTR:	IN  A,(U_STS)	; read status
  178 F076  E6 01       	AND U_TXB	; check TxRDY bit
  179 F078  CA F074     	JP Z,WRSTR	; wait if not set
