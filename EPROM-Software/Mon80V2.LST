 1008                   ;==============================================================================
 1009                   ; IDE Karten Interface f|r CF-Karte
 1010                   ;
 1011                   ; Subroutine to read one IDE/ATA Disk sector (256 bytes)
 1012                   ; Address to place data passed in HL
 1013                   ; LBA bits 0 to 7 passed in C, bits 8 to 15 passed in B
 1014                   ; LBA bits 16 to 23 passed in E
 1015                   ;
 1016                   
 1017 F588              IDERD:
 1018 F588  DB 1F       IDERD1:	IN	A,(IDESTAT)	; check status
 1019 F58A  E6 80       	AND	80H		; check BSY bit
 1020 F58C  C2 F588     	JP	NZ,IDERD1	; loop until not busy
 1021                   
 1022 F58F  DB 1F       IDERD2:	IN	A,(IDESTAT)	; check	status
 1023 F591  E6 40       	AND	40H		; check DRDY bit
 1024 F593  CA F58F     	JP	Z,IDERD2	; loop until ready
 1025                   
 1026 F596  3E 01       	LD	A,01H		; number of sectors = 1
 1027 F598  D3 1A       	OUT	(SECCND),A	; sector count register
 1028 F59A  79          	LD	A,C
 1029 F59B  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1030 F59D  78          	LD	A,B
 1031 F59E  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1032 F5A0  7B          	LD	A,E
 1033 F5A1  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1034 F5A3  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1035 F5A5  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1036 F5A7  3E 20       	LD	A,20H		; Read sector command
 1037 F5A9  D3 1F       	OUT	(IDESTAT),A
 1038                   
 1039 F5AB              IDERD3:	; WAIT FOR DRQ SET
 1040 F5AB  DB 1F       	IN	A,(IDESTAT)	; read status
 1041 F5AD  E6 08       	AND	08H		; DRQ bit
 1042 F5AF  CA F5AB     	JP	Z,IDERD3	; loop until bit set
 1043                   	
 1044 F5B2              IDERD4:	; WAIT FOR BUSY CLEay
 1045 F5B2  DB 1F       	IN	A,(IDESTAT)
 1046 F5B4  E6 80       	AND	80H
 1047 F5B6  C2 F5B2     	JP	NZ,IDERD4
 1048                   	
 1049 F5B9  DB 1F       	IN	A,(IDESTAT)	; clear INTRQ
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  19
MON80V2 Z80

 1050                   
