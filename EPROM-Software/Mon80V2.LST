  497 F17F  E6 8F       	AND 10001111B
  498 F181  4F          	LD C,A
  499 F182  CD F186     	CALL TSTFRM
  500 F185  C9          	RET  		; ok or error (carry=1)
  501                   
  502                   ;------------------------------------------------------------------------------
  503                   ; TSTFRM
  504                   
  505 F186  3A F587     TSTFRM:	LD A,(FLOTYP)
  506 F189  FE 01       	CP 1
  507 F18B  C2 F194     	JP NZ,TSTF1	; -> FLO2
  508                   
  509                   	; FLO1
  510 F18E  79          	LD A,C
  511 F18F  EE 10       	XOR 10H		; if FLO1 invert density bit
  512 F191  C3 F195     	JP TSTF2
  513                   	
  514 F194              TSTF1:	; FLO2
  515 F194  79          	LD A,C
  516                   
  517 F195  D3 C4       TSTF2:	OUT (FLO+4),A 	; set REG4-Latch
  518 F197  3E 0F       	LD A,0FH 	; RSTORE command with Verify
  519 F199  D3 C0       	OUT (FLO),A 	; to controller
  520                   	
  521 F19B              TSTF3:	; wait for INT
  522 F19B  DB C4       	IN A,(FLO+4)
  523 F19D  E6 40       	AND 40H 	; Bit 6 pruefen
  524 F19F  28 FA       	JR Z,TSTF3 	; -> wait
  525                   	
  526 F1A1  DB C0       	IN A,(FLO) 	; read status, clear interrupt
  527 F1A3  E6 98       	AND  10011000B 	; mask critical bits
  528 F1A5  37          	SCF
  529 F1A6  C0          	RET NZ  	; return with carry se (error)
  530                   	
