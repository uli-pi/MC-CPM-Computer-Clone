  125                   ; Start of Monitor program, ROM address 0F000h
  126                   
  127 001D              ROMSTRT:
  128                   	; Start address of Monitor in ROM
  129                   	; label must be located before .PHASE
  130                   
  131                   	.PHASE 0F000H	; monitor start address in RAM
  132                   
  133 F000  C3 F071     	JP INIT
  134 F003  C3 F084     	JP CONIN	; Console In
  135 F006  C3 F097     	JP READIN	; Reader In (<- SIO B)
  136 F009  C3 F0AD     	JP CONOUT	; Console Out
  137 F00C  C3 F0C1     	JP PUNOUT	; Punch Out (-> SIO B)
  138 F00F  C3 F0D8     	JP LSTOUT	; List Out (-> SIO B)
  139 F012  C3 F0EF     	JP CONSTS	; Get console status, 0FFh in A, if character available
  140 F015  C3 F102     	JP IOGET	; Get iobyte, current configuration in A
  141 F018  C3 F106     	JP IOSET	; Set iobyte, new configuration in C
  142 F01B  C3 F10B     	JP MEMCHK	; High memory in B, low memory in A
  143                   
  144 F01E              TRAP:	; trap/breakpoint entry
  145                   
  146 F01E  C3 F06E     	JP RSTRT
  147 F021  C3 F213     	JP FLOP	 	; new floppy interface rev 1.0
  148 F024  C3 F1A9     	JP MAXI		; FLOPPY EXEC VEKTOR SOFT (old)
  149 F027  C3 F1E4     	JP MINI		; FLOPPY EXEC VEKTOR MINI (old)
  150 F02A  C3 F588     	JP IDERD	; Read IDE sector
  151 F02D  C3 F5C7     	JP IDEWR	; Write IDE Sector
  152 F030  C3 F6CA     	JP COLD		; Monitor Cold Start (no Hardware init)
  153 F033  C3 F6FB     	JP WARM		; Monitor Warm Start
  154 F036  C3 F074     	JP WRSTR	; gibt einen 0-terminierten String aus
  155                   
  156 F039  F13A        TABPTR:	DEFW TABSTART 	; Start of user jump table
  157 F03B  FE30        ENDPTR:	DEFW LASTMON 	; End address of Monitor
  158 F03D  F606        FREPTR:	DEFW FREEMEM 	; End of Monitor driver section. The area behind it can be overwritten by CP/M.
  159                   
  160                   	; Jump table for compatibility to FLOMON (NDR-Klein-Computer)
  161                   	
  162 F03F    000D      	DEFS 13 	; f033,34,35,36,37,38,39,3a,3b,3c,3d,3e,3f
  163                   			; BASIS F040h
  164 F04C  C3 F06A     	JP ILLEGAL 	; loeschen alle seiten
  165 F04F  C3 F06A     	JP ILLEGAL     	; loeschen unsichtbar
  166 F052  C3 F06A     	JP ILLEGAL 	; moveto hl=x de=y
  167 F055  C3 F06A     	JP ILLEGAL 	; drawto hl=x de=y
  168 F058  C3 F06A     	JP ILLEGAL 	; c=schreibseite 0,1,2,3
  169 F05B  C3 F06A     	JP ILLEGAL 	; c=leseseite    0,1,2,3
  170 F05E  C3 F06A     	JP ILLEGAL      ; c=rmwmode      0=norm 1=rmw
  171 F061  C3 F06A     	JP ILLEGAL 	; warten bis gdp fertig
  172 F064  C3 F06A     	JP ILLEGAL      ; c=befehl fuer gdp  ACHTUNG in C-Register nicht A
  173 F067  C3 F06A     	JP ILLEGAL 	; hl=quelle,de=ziel,c=bank quelle, b=bank ziel
  174                   			; carry wenn bankram auf f000h nicht da ist
  175                   
  176                   
  177                   ; End of area of tables and fixed addresses, that are used by CP/M BIOS, UFORMAT etc.
  178                   
  179                   ;------------------------------------------------------------------------------
  180                   
