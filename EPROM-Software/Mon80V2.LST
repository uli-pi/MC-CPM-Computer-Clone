  212                   
  213 F084  3A F14C     CONIN:	LD A,(IOBYT)
  214 F087  E6 03       	AND 00000011b		; console mask
  215 F089  20 09       	JR NZ,CONI2		; -> user device
  216                   
  217 F08B  DB 21       CONI1:	IN A,(U_STS)
  218 F08D  E6 02       	AND U_RXB
  219 F08F  28 FA       	JR Z,CONI1
  220 F091  DB 20       	IN A,(U_DAT)
  221 F093  C9          	RET
  222                   
  223 F094  C3 F13A     CONI2:	JP USERCI  		; user CI
  224                   
