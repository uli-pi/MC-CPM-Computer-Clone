  559 F1E9  CD F1CA     	CALL SCODB 	; coding 2
  560 F1EC  F1          	POP AF
  561 F1ED  E6 40       	AND 40H 	; dd,sd 
  562 F1EF  C2 F1F9     	JP NZ,MINI3
  563                   	
  564                   	; IF Z=0 SD
  565 F1F2  79          	LD A,C
  566 F1F3  F6 30       	OR 00110000B 	; SD MINI
  567 F1F5  4F          	LD C,A
  568                   	; ELSE
  569 F1F6  C3 F1FD     	JP MINI4
  570                   
  571 F1F9              mini3:	; DD
  572 F1F9  79          	LD A,C
  573 F1FA  F6 20       	OR 00100000B 	; DD MINI
  574 F1FC  4F          	LD C,A
  575                   
  576 F1FD  3E 02       mini4:	LD A,2  	; sso-flag setzen
  577 F1FF  C3 F214     	JP FLOP1 	; ok ausfuehren
