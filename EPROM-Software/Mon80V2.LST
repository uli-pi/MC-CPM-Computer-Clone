  415                   ; testet mini,sd =11
  416                   ;        mini,dd =10
  417                   ;        maxi,sd =01
  418                   ;        maxi,dd =00
  419                   
  420 F156  F3          getfl:	DI  		; ohne Interrupts
  421 F157  3E D0       	LD A,0D0H
  422 F159  D3 C0       	OUT (FLO),A 	; Stop Controller
  423 F15B  DB C0       	IN A,(FLO) 	; Ints loeschen
  424 F15D  79          	LD A,C
