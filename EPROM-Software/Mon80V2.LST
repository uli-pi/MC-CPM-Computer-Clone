 1049                   ; Subroutine to write one IDE/ATA Disk sector (256 bytes)
 1050                   ; Address of data to write to disk passed in HL
 1051                   ; LBA bits 0 to 7 passed in C, bits 8 to 15 passed in B
 1052                   ; LBA bits 16 to 23 passed in E
 1053                   
 1054 F5C7              IDEWR:
 1055 F5C7  DB 1F       IDEWR1:	IN	A,(IDESTAT)	; check status
 1056 F5C9  E6 80       	AND	80H		; check BSY bit
 1057 F5CB  C2 F5C7     	JP	NZ,IDEWR1	; loop until not busy
 1058                   
 1059 F5CE  DB 1F       IDEWR2:	IN	A,(IDESTAT)	; check status
 1060 F5D0  E6 40       	AND	40H		; check DRDY bit
 1061 F5D2  CA F5CE     	JP	Z,IDEWR2	; loop until ready
 1062                   
 1063 F5D5  3E 01       	LD	A,01H		; number of sectors = 1
 1064 F5D7  D3 1A       	OUT	(SECCND),A	; sector count register
 1065 F5D9  79          	LD	A,C
 1066 F5DA  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1067 F5DC  78          	LD	A,B
 1068 F5DD  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1069 F5DF  7B          	LD	A,E
 1070 F5E0  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1071 F5E2  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1072 F5E4  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1073 F5E6  3E 30       	LD	A,30H		; Write sector command
 1074 F5E8  D3 1F       	OUT	(IDESTAT),A
 1075                   	
 1076 F5EA              IDEWR3:	; WAIT FOR DRQ SET
 1077 F5EA  DB 1F       	IN	A,(IDESTAT)	; read status
 1078 F5EC  E6 08       	AND	08H		; DRQ bit
 1079 F5EE  CA F5EA     	JP	Z,IDEWR3	; loop until bit set			
 1080                   
 1081 F5F1              IDEWR4:	; WRITE LOOP
 1082 F5F1  7E          	LD	A,(HL)
 1083 F5F2  D3 18       	OUT	(IDEDATA),A	; write data
 1084 F5F4  23          	INC	HL
 1085 F5F5  DB 1F       	IN	A,(IDESTAT)	; read status
 1086 F5F7  E6 08       	AND	08H		; check DRQ bit
 1087 F5F9  C2 F5F1     	JP	NZ,IDEWR4	; write until bit cleared
 1088                   
 1089 F5FC              IDEWR5:	; WAIT FOR BUSY CLEAr
 1090 F5FC  DB 1F       	IN	A,(IDESTAT)
 1091 F5FE  E6 80       	AND	80H
 1092 F600  C2 F5FC     	JP	NZ,IDEWR5
 1093                   
 1094 F603  DB 1F       	IN	A,(IDESTAT)	; clear INTRQ
 1095 F605  C9          	RET
