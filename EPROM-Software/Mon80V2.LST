  362                   ;------------------------------------------------------------------------------
  363                   ; prueft den Speicherbereich und gibt die hoechste verfuegbare Zelle an
  364                   ; MEMCHK IN B HIGH IN A LOW MEMORY
  365                   
  366 F10B  E5          MEMCHK:	PUSH HL
  367 F10C  CD F118     	CALL MEMSIZ
  368 F10F  7D          	LD A,L
  369 F110  D6 3C       	SUB 3CH
  370 F112  30 01       	JR NC,MEMCK1
  371                   
  372 F114  25          	DEC H
  373                   	
  374 F115  44          MEMCK1:	LD B,H
  375 F116  E1          	POP HL
  376 F117  C9          	RET
  377                   
  378                   ;------------------------------------------------------------------------------
  379                   ; Detect end of memory from 0000h to EFFFh
  380                   
  381 F118  C5          MEMSIZ:	PUSH BC
  382                   
  383                   	; entry point
  384 F119              MEMSIZB:
  385 F119  21 FFFF     	LD HL,-1
  386                   
  387 F11C  24          MEMS1:	INC H
  388 F11D  7E          	LD A,(HL)
  389 F11E  2F          	CPL
  390 F11F  77          	LD (HL),A
  391 F120  BE          	CP (HL)
  392 F121  2F          	CPL
  393 F122  77          	LD (HL),A
  394 F123  20 F7       	JR NZ,MEMS1
  395                   
  396 F125  24          MEMS2:	INC H
  397 F126  7C          	LD A,H
  398 F127  FE F0       	CP 0F0H		; ALL RAM
  399 F129  28 08       	JR Z,MEMS3 	; READY 0F000H
  400                   	
  401 F12B  7E          	LD A,(HL) 	; max 0F000h, da dort Monitor startet
  402 F12C  2F          	CPL
  403 F12D  77          	LD (HL),A
  404 F12E  BE          	CP (HL)
  405 F12F  2F          	CPL
  406 F130  77          	LD (HL),A
  407 F131  28 F2       	JR Z,MEMS2
  408                   
  409 F133  25          MEMS3:	DEC H
  410 F134  01 FFDD     	LD BC,EXIT-ENDX
  411 F137  09          	ADD HL,BC
  412 F138  C1          	POP BC
  413 F139  C9          	RET
