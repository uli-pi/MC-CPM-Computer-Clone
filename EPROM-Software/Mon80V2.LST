  702 F28E  C9          	RET 			; Code belassen
  703                   	
  704                   ;------------------------------------------------------------------------------
  705                   
  706 F28F              rdflp:				; einen Sektor lesen
  707                   				; e=sektor nr
  708 F28F  79          	LD A,C
  709 F290  D3 C4       	OUT (FLO+4),A 		; erst mal Dichtecode setzen und Seite
  710 F292  7B          	LD A,E
  711 F293  D3 C2       	OUT (FLO+2),A 		; ins Sektorregister
  712 F295  0E C3       	LD C,FLO+3 		; Adresse Datenport dann nach c
  713 F297  CD F269     	CALL SETUP 		; Register A vorbereiten
  714 F29A  C6 88       	ADD A,88H 		; Lese-Befehl, sidesel=0
  715 F29C  D3 C0       	OUT (FLO),A 		; Befehl ausfuehren
  716 F29E              rd1:
  717 F29E  DB C4       	IN A,(FLO+4) 		; DRQ schon da ?
  718 F2A0  07          	RLCA  			; bit7 = drq bit6 = int
  719 F2A1  D2 F29E     	JP NC,RD1 		; bis drq=1 da ist
  720 F2A4  ED A2       	INI  			; dann Transport moeglich
  721 F2A6  C3 F29E     	JP RD1  		; und alles wiederholen bis INT
  722                   
  723                   ;------------------------------------------------------------------------------
  724                   
  725 F2A9              wrflp:				; Floppy-Sektor schreiben
  726 F2A9  79          	LD A,C
  727 F2AA  D3 C4       	OUT (FLO+4),A 		; erst mal Seite anwaehlen und Dichte
  728 F2AC  7B          	LD A,E  		; Sektorregister setzen
  729 F2AD  D3 C2       	OUT (FLO+2),A
  730 F2AF  0E C3       	LD C,FLO+3		; Adresse Datenport laden
  731 F2B1  CD F269     	CALL SETUP		; E-Code in A laden
  732 F2B4  C6 A8       	ADD A,0A8H		; Befehl Schreibe-Sektor
  733 F2B6  D3 C0       	OUT (FLO),A 		; und Befehl ausfuehren
  734 F2B8              wr1:
  735 F2B8  DB C4       	IN A,(FLO+4)		; warten bis DRQ da
  736 F2BA  07          	RLCA
  737 F2BB  D2 F2B8     	JP NC,WR1 		; dann Wert ausgeben
  738 F2BE  ED A3       	OUTI  			; mit Blockbefehl
  739 F2C0  C3 F2B8     	JP WR1  		; verlassen nur durch INT
  740                   
  741                   ;------------------------------------------------------------------------------
  742                   
  743 F2C3              wawa:				; Warteschleife fuer einige ms
  744 F2C3  C5          	PUSH BC 		; pro Schleife ca 6ys bei 4MHz
  745 F2C4  01 01F4     	LD BC,500 		; 500*6ys Dauer
  746 F2C7  CD F2CC     	CALL DELAY
  747 F2CA  C1          	POP BC
  748 F2CB  C9          	RET
  749                   	
  750                   ;------------------------------------------------------------------------------
  751                   
  752 F2CC  0B          delay:	DEC BC
  753 F2CD  78          	LD A,B
  754 F2CE  B1          	OR C
  755 F2CF  C2 F2CC     	JP NZ,DELAY
  756 F2D2  C9          	RET
  757                   
  758                   ;------------------------------------------------------------------------------
  759                   
