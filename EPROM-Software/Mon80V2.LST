  499                   	; FLO1
  500 F18E  79          	LD A,C
  501 F18F  EE 10       	XOR 10H		; if FLO1 invert density bit
  502 F191  C3 F195     	JP TSTF2
  503                   	
  504 F194              TSTF1:	; FLO2
  505 F194  79          	LD A,C
  506                   
  507 F195  D3 C4       TSTF2:	OUT (FLO+4),A 	; set REG4-Latch
  508 F197  3E 0F       	LD A,0FH 	; RSTORE command with Verify
  509 F199  D3 C0       	OUT (FLO),A 	; to controller
  510                   	
  511 F19B              TSTF3:	; wait for INT
  512 F19B  DB C4       	IN A,(FLO+4)
  513 F19D  E6 40       	AND 40H 	; Bit 6 pruefen
  514 F19F  28 FA       	JR Z,TSTF3 	; -> wait
  515                   	
  516 F1A1  DB C0       	IN A,(FLO) 	; read status, clear interrupt
  517 F1A3  E6 98       	AND  10011000B 	; mask critical bits
  518 F1A5  37          	SCF
  519 F1A6  C0          	RET NZ  	; return with carry se (error)
  520                   	
  521 F1A7  AF          	XOR A
  522 F1A8  C9          	RET  		; return with carry clear (no error)
