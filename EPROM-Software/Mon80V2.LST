    2                   	
    3                   	.Z80
    4                   ;---------------------------------------------------------------
    5                   ; Monitor fuer MC-Computer Platine SYS-80 und SYS-80s
    6                   ; Assembliert mit Z80ASM von SLR Systems wegen der langen
    7                   ; Label die mit einigen anderen Assemblern nicht moeglich sind.
    8                   ;
    9                   ; Erstellt 05/2026 von U. Haumann
   10                   ; Enthaelt weitgehend Routinen aus RDK Monitor 1.1 850129
   11                   ; V7.2 851216, sowie Teile aus dem Monitor von Donn Stewart 
   12                   ; fuer den "CPU-Ville" Z80 Computer.
   13                   ; Treiber fuer Serielle Schnittstelle auf CPU-Platine mit UART 8251
   14                   ; implementiert.
   15                   ; Flo1 und Flo2 waehlber auf Hardware Basis Adresse 0C0h.
   16                   ; Der Mointor erwartet 64KB Ram Memory. Er darf selbst nicht
   17                   ; groesser als 4KB werden, es sein denn man schiebt die MON_ADR
   18                   ; und CCP weiter nach unten. Der CPM Bereich verkleinert sich dann.
   19                   ; Der Monitor kopiert sich nach Reset an das Speicherende
   20                   ; auf den Wert in MON_ADR und gibt den unteren RAM Bereich frei.
   21                   ; Dies wird auf der SYS CPU Platine mit einem Lesebefehl auf
   22                   ; Adresse 7000h erreicht. Das Eprom ist dann ausgeblendet.
   23                   ; Somit steht der Speicher durchgaengig ab 0000h bis zu MON_ADR
   24                   ; zur Verfuehgung.
   25                   ; Das CPM BIOS fuer den MC-Computer ueberschreibt den Monitorbereich
   26                   ; ab FC00h. Alle relevanten Teile f|r den Betrieb des Rechners 
   27                   ; muessen vor FC00h plaziert werden.
   28                   
   29                   ; 06/2026 Ueberarbeitet von Detlef Gerhardt
   30                   ; komplette Ueberarbeitung der Labels und sukzessive Kommentierung des Quellcodes
   31                   ; um nach und nach moeglichst viele Routinen zu verstehen.
   32                   ; Diese Version ist bis auf die Versionsnummer noch binaerkompatibel zu Version 8.0v1
   33                   ; --- Work in progress ---
   34                   
   35                   ;------------------------------------------------------------------------------
   36                   ; Constants
   37                   
   38         0000      FALSE	EQU 0
   39         0001      TRUE	EQU 1
   40         000D      CR 	EQU 0DH
   41         000A      LF 	EQU 0AH
   42         0007      BELL	EQU 7
   43         00FF      RUB 	EQU 0FFH
   44         0000      FIL 	EQU 0
   45         0007      MAX	EQU 7
   46         001B      ESC	EQU 1BH
   47                   
   48         0038      RST7	EQU 38H		; der Vektor RST7 wird fuer Breakpoints gebraucht
   49                   
   50                   ;------------------------------------------------------------------------------
   51                   ; I/O addresses
   52                   
   53                   ; SYS80S = TRUE:  serial port of SYS-80S card ist used for console
   54                   ; SYS80S = FALSE: serial port SIO A at OUT-80 card is used for console
   55                   
   56                   ; OUT-80 card SIO B is used for reader, punch and lister
   57                   
   58         0001      SYS80S	EQU TRUE
   59                   
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page   2
MON80V2 Z80

   60                   ; Addresses of serial port UART 8251 at SYS-80s CPU card
   61         0020      SU_DAT	EQU 020H	; UART 8251 Daten
   62         0021      SU_STS	EQU 021H	; UART 8251 Control
   63         0002      SU_RXB	EQU 002h	; RX Ready Bit UART 8251
   64         0001      SU_TXB	EQU 001h	; TX Ready Bit UART 8251
   65                   
   66                   ; Addresses of serial port MC Computer OUT-80 card with SIO
   67         00F0      SA_DAT	EQU 0F0H	; SIO A Daten
   68         00F1      SA_STS	EQU 0F1H	; SIO A Control
   69         00F2      SB_DAT	EQU 0F2H	; SIO B Daten
   70         00F3      SB_STS	EQU 0F3H	; SIO B Control
   71         0001      S_RXB	EQU 01h		; SIO RX Ready Bit
   72         0004      S_TXB	EQU 04h		; SIO TX Ready Bit
   73                   
   74         0001      	IF SYS80S
   75                   
   76                   ; Console is redirected to UART on SYS-80s
   77         0020      U_DAT	EQU SU_DAT
   78         0021      U_STS	EQU SU_STS
   79         0002      U_RXB	EQU SU_RXB
   80         0001      U_TXB	EQU SU_TXB
   81                   
   82                   	ELSE
   90                   	ENDIF
   91                   
   92                   
   93                   ; Address of IDE Port CF-80 card
   94                   
   95         0018      IDEDATA	EQU 018h	; IDE Data Register
   96         001A      SECCND	EQU 01Ah	; Sector Count Register
   97         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
   98         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
   99         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
  100         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
  101         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
  102                   
  103                   ;------------------------------------------------------------------------------
  104                   
  105         0000      	ORG 0000h		; start address in ROM
  106                   
  107                   	; Copy Monitor from address ROMSTRT in ROM to address F000 in RAM
  108                   
  109 0000  31 FFFF     BEGIN:	LD SP,0FFFFh 		; set Stack to end of memory
  110 0003  3E C9       	LD A,0C9h 		; place RET command at F000h
  111 0005  32 F000     	LD (0F000h),A 		; 
  112 0008  CD F000     	CALL 0F000h 		; and call it
  113                   
  114 000B  3B          OFFS:	DEC SP  		; get return address from Stack to calculate
  115 000C  3B          	DEC SP  		; Monitor location in ROM
  116 000D  D1          	POP DE
  117 000E  21 0012     	LD HL,ROMSTRT-OFFS	; offset from BEG to ROMSTRT
  118 0011  19          	ADD HL,DE		; actual Montor address in ROM as source address in HL
  119 0012  11 F000     	LD DE,0F000h 		; dest address in DE
  120 0015  01 0FFF     	LD BC,0FFFh 		; length in BC (4KB - 1)
  121 0018  ED B0       	LDIR  			; copy
  122 001A  C3 F000     	JP 0F000h 		; jump to Monitor in RAM
  123                   
  124                   ;------------------------------------------------------------------------------
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page   3
