 1165 F5F4  23          	INC	HL
 1166 F5F5  DB 1F       	IN	A,(IDESTAT)	; read status
 1167 F5F7  E6 08       	AND	08H		; check DRQ bit
 1168 F5F9  C2 F5F1     	JP	NZ,IDEWR4	; write until bit cleared
