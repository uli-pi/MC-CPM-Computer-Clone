  372                   ;==============================================================================
  373                   ; FLO2 floppy routines
  374                   
  375                   ; Autobestimmung des Formats
  376                   ; in C ist danach der gueltige ; Laufwerkscode,
  377                   ; Vorgabe ist in C die Laufwerksnummer und ggf. Seite.
  378                   ; testet mini,sd =11
  379                   ;        mini,dd =10
  380                   ;        maxi,sd =01
  381                   ;        maxi,dd =00
  382                   
  383 F156  F3          getfl:	DI  		; ohne Interrupts
  384 F157  3E D0       	LD A,0D0H
  385 F159  D3 C0       	OUT (FLO0),A 	; Stop Controller
  386 F15B  DB C0       	IN A,(FLO0) 	; Ints loeschen
  387 F15D  79          	LD A,C
  388 F15E  E6 8F       	AND 8FH 	; nur Drivecode ok
  389 F160  4F          	LD C,A
  390 F161  CD F2C3     	CALL WAWA
  391 F164  79          	LD A,C
  392 F165  F6 30       	OR 00110000B	; mini sd vorgeben		
  393 F167  4F          	LD C,A
  394 F168  CD F186     	CALL GET1FL
  395 F16B  D0          	RET NC  	; kein Fehler, no carry
  396 F16C  79          	LD A,C
  397 F16D  E6 AF       	AND 10101111B
  398 F16F  4F          	LD C,A
  399 F170  CD F186     	CALL GET1FL
  400 F173  D0          	RET NC
  401 F174  79          	LD A,C
  402 F175  E6 8F       	AND 10001111B
  403 F177  F6 10       	OR  00010000B
  404 F179  4F          	LD C,A
  405 F17A  CD F186     	CALL GET1FL
  406 F17D  D0          	RET NC
  407 F17E  79          	LD A,C
  408 F17F  E6 8F       	AND 10001111B
  409 F181  4F          	LD C,A
  410 F182  CD F186     	CALL GET1FL
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   8
