  579                   ;==============================================================================
  580                   ; Floppy-Unterprogramme fuer FLO2
  581                   ; verwendet 1797 als Controller
  582                   ; Version 1.0   840506
  583                   ; Rolf-Dieter Klein (C) 1984 Muenchen
  584                   ;
  585                   ; Die Routinen ermoeglichen sowohl den Anschluss von Mini-,Mikro- als auch
  586                   ; von Maxi-Laufwerken. Die Routinen muessen im RAM stehen, da die Buffer
  587                   ; am Ende stehen. Alle Buffer sind jedoch gesammelt.
  588                   
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  11
MON80V2 Z80

  589                   ; FLO4    als Leseport
  590                   ;
  591                   ; 7 6 5 4 3 2 1 0
  592                   ;
  593                   ; DRQ   INTRQ   headld x      x x x x
  594                   ; 0=request
  595                   ;      0=request
  596                   ;  1=head down
  597                   ;
  598                   
  599                   ; FLO4    als Schreibport
  600                   ;
  601                   ; 7 6 5 4 3 2 1 0
  602                   ;
  603                   ; sso moton mini dense d c b a
  604                   ;
  605                   ; 1=Seite 1
  606                   ; 0=Motor an
  607                   ;  1=Minilaufwerk
  608                   ;   1=Single Dense
  609                   ;    -------------------------
  610                   ;      1=Laufwerk an
  611                   
  612         00C0      FLO	EQU 0C0H 		; Basisadresse Floppy-Controller
  613                   ;FLO0	EQU 0C0H   	
  614                   ;FLO1	EQU 0C1H
  615                   ;FLO2	EQU 0C2H
  616                   ;FLO3	EQU 0C3H
  617                   ;FLO4	EQU 0C4H 		; Port fuer Zusatzstatus etc.
  618                   
  619                   ;------------------------------------------------------------------------------
  620                   ; Bei einem Interrupt wird an diese Stelle gesprungen
  621                   ; Der Interrupt erfolgt vom Floppy-Controller
  622                   
  623 F202              INTEX:	; Das INT-Program arbeitet nicht als Unterprogramm
  624 F202  F1          	POP AF  		; alte Ret-Adresse vernichten
  625 F203  DB C0       	IN A,(FLO) 		; Status lesen und INT loeschen
  626 F205  FB          	EI  			; Interrupt wieder freigeben
  627 F206  ED 4D       	RETI  			; zurueck zum vorherigen Aufrufer
  628                   
  629                   ;------------------------------------------------------------------------------
  630                   
  631 F208              iniflp:				; Floppy Routinen Init
  632 F208  3E 02       	LD A,2  		; 3= langsamste Steprate
  633 F20A  32 F3FA     	LD (STEPRATE),A		; einstellen, kein SSO
  634 F20D  3E FF       	LD A,0FFH
  635 F20F  32 F403     	LD (CURDRV),A 		; Drive ungueltig
  636 F212  C9          	RET 
  637                   
  638                   ;------------------------------------------------------------------------------
  639                   
  640         0038      INTVEK	EQU 38h 		; Interruptziel
  641                   
  642 F213              FLOP:				; Haupteingang der Floppy-Routinen
  643 F213  AF          	XOR A  			; sso-Flag auf 0 setzen
  644 F214              flop1:				; a=sso flag, nur 2 zulaessig
  645 F214  32 F3FB     	LD (SSOFLAG),A 		; ok setzen hier moeglich
  646                   				; HL = Ziel oder Quelladresse
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  12
MON80V2 Z80

  647                   				; E = Sektor D= Track
  648                   				; C = Laufwerkscode + Dichtecode + Seite
  649                   				; B = 0 dann Steprate setzen + SSO-Flag
  650                   				;   = 1 dann lesen
  651                   				;   = 2 dann schreiben
  652                   
  653 F217  F5          cflo1:	PUSH AF			; entscheiden FLO1 oder FLO2
  654 F218  3A F587     	LD A,(FLOC0)
  655 F21B  FE 01       	CP 1  
  656 F21D  C2 F226     	JP NZ,CFLO2		; -> FLO2
  657                   	
  658                   	; FLO1
  659 F220  79          	LD A,C
  660 F221  E6 BF       	AND 10111111B 		; kein autowait 
  661 F223  EE 10       	XOR 10H 		; invertieren Dichtebit fuer FLO1
  662 F225  4F          	LD C,A
  663                   
  664 F226  F1          CFLO2:	POP AF
  665 F227  ED 73 F3FC  	LD (SP0),SP 		; save user-stack, maybe to deep for BDOS
  666 F22B  31 F478     	LD SP,TSTACK 		;
  667                   
  668 F22E  3E D0       	LD A,0D0H
  669 F230  D3 C0       	OUT (FLO),A 		; reset floppy controller
  670                   	
  671                   	; set interrupt vector to INTEX
  672 F232  3A 0038     	LD A,(INTVEK)
  673 F235  32 F3FE     	LD (SAVINT),A
  674 F238  3E C3       	LD A,0C3H 		; JP-Befehl
  675 F23A  32 0038     	LD (INTVEK),A
  676 F23D  E5          	PUSH HL
  677 F23E  2A 0039     	LD HL,(INTVEK+1)
  678 F241  22 F3FF     	LD (SAVINT+1),HL
  679 F244  21 F202     	LD HL,INTEX 		; set to JP INTEX
  680 F247  22 0039     	LD (INTVEK+1),HL
  681 F24A  E1          	POP HL
  682                   	
  683 F24B  DB C0       	IN A,(FLO)		; Status - Port
  684 F24D  ED 56       	IM 1  			; set interrupt mode 1 ->  execure at 38h
  685 F24F  FB          	EI  			; Interrupt freigeben
  686 F250  CD F2FB     	CALL SOFTEX
  687 F253  F3          	DI  			; disable interrupt
  688                   	
  689                   	; restore interrupt vector
  690 F254  F5          	PUSH AF 		; Status
  691 F255  3A F3FE     	LD A,(SAVINT)
  692 F258  32 0038     	LD (INTVEK),A 		; zurueckspeichern
  693 F25B  E5          	PUSH HL
  694 F25C  2A F3FF     	LD HL,(SAVINT+1)
  695 F25F  22 0039     	LD (INTVEK+1),HL
  696 F262  E1          	POP HL
  697 F263  F1          	POP AF
  698 F264  ED 7B F3FC  	LD SP,(SP0) 		; restore user-stack
  699                   	
  700 F268  C9          	RET
  701                   
  702                   ;------------------------------------------------------------------------------
  703                   ; Diverse Unterprogramme
  704                   ;------------------------------------------------------------------------------
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  13
MON80V2 Z80

  705                   
  706 F269              SETUP:				; testet ob der Kopf noch
  707                   				; geladen ist und setzt die
  708 F269  06 00       	LD B,0  		; Flag fuer SSO-Bit
  709 F26B  3A F402     	LD A,(DRVCOD) 		; wenn Bit 7 gesetzt, dann abfragen
  710 F26E  E6 80       	AND 80H
  711 F270  28 11       	JR Z,SETUP2 		; Seite 0, immer mit SSO=0
  712                   	
  713 F272  3A F3FA     	LD A,(STEPRATE) 	; jetzt pruefen ob flags da
  714 F275  E6 80       	AND 80H 		; <>0, dann SSO setzen, wenn seite 1
  715 F277  28 04       	JR Z,SETUP1 		; =0, dann code 0, oder SSOFLAG
  716                   	
  717 F279  06 02       	LD B,2  		; SSO setzen 
  718 F27B  18 06       	JR SETUP2
  719                   
  720 F27D              SETUP1:	; pruefen ob SSO-Flag
  721 F27D  3A F3FB     	LD A,(SSOFLAG) 		; ok, 2=Flag
  722 F280  E6 02       	AND 2  			; SSO-Bit
  723 F282  47          	LD B,A  		; 0,2 erlaubt 
  724                   
  725 F283              SETUP2:	; entsprechenden Bits
  726 F283  DB C4       	IN A,(FLO+4) 		; Status Port
  727 F285  E6 20       	AND 20H 		; Head-Load Bit
  728 F287  20 04       	JR NZ,SETUP3 		; =1 dann Kopf auf Diskette
  729                   	
  730 F289  78          	LD A,B
  731 F28A  F6 04       	OR 4  			; sonst Bitmaske fuer headdown
  732 F28C  C9          	RET
  733                   
  734 F28D              SETUP3:	; noset
  735 F28D  78          	LD A,B
  736 F28E  C9          	RET 			; Code belassen
  737                   	
  738                   ;------------------------------------------------------------------------------
  739                   ; Read one sector
  740                   ; sector number in E
  741                   
  742 F28F  79          RDFLP:	LD A,C
  743 F290  D3 C4       	OUT (FLO+4),A 		; erst mal Dichtecode setzen und Seite
  744 F292  7B          	LD A,E
  745 F293  D3 C2       	OUT (FLO+2),A 		; ins Sektorregister
  746 F295  0E C3       	LD C,FLO+3 		; Adresse Datenport dann nach c
  747 F297  CD F269     	CALL SETUP 		; Register A vorbereiten
  748 F29A  C6 88       	ADD A,88H 		; Lese-Befehl, sidesel=0
  749 F29C  D3 C0       	OUT (FLO),A 		; Befehl ausfuehren
  750                   
  751 F29E              RDFLP1:	; wait for DRQ
  752 F29E  DB C4       	IN A,(FLO+4) 		; DRQ schon da ?
  753 F2A0  07          	RLCA  			; bit7 = drq, bit6 = int
  754 F2A1  D2 F29E     	JP NC,RDFLP1 		; bis drq=1 da ist
  755                   	
  756 F2A4  ED A2       	INI  			; IN (C) -> (HL), HL++
  757 F2A6  C3 F29E     	JP RDFLP1  		; verlassen nur durch INT
  758                   
  759                   ;------------------------------------------------------------------------------
  760                   ; Write one sector
  761                   
  762 F2A9  79          WRFLP:	LD A,C
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  14
MON80V2 Z80

  763 F2AA  D3 C4       	OUT (FLO+4),A 		; erst mal Seite anwaehlen und Dichte
  764 F2AC  7B          	LD A,E  		; Sektorregister setzen
  765 F2AD  D3 C2       	OUT (FLO+2),A
  766 F2AF  0E C3       	LD C,FLO+3		; Adresse Datenport laden
  767 F2B1  CD F269     	CALL SETUP		; E-Code in A laden
  768 F2B4  C6 A8       	ADD A,0A8H		; Befehl Schreibe-Sektor
  769 F2B6  D3 C0       	OUT (FLO),A 		; und Befehl ausfuehren
  770                   
  771 F2B8              WRFLP1:	; wait for DRQ
  772 F2B8  DB C4       	IN A,(FLO+4)
  773 F2BA  07          	RLCA
  774 F2BB  D2 F2B8     	JP NC,WRFLP1
  775                   	
  776 F2BE  ED A3       	OUTI  			; (HL) -> OUT (C), HL++
  777 F2C0  C3 F2B8     	JP WRFLP1  		; verlassen nur durch INT
  778                   
  779                   ;------------------------------------------------------------------------------
  780                   ; delay: 4 ms at 4 MHz
  781                   
  782 F2C3  C5          WAWA:	PUSH BC 		; pro Schleife ca 6us bei 4MHz
  783 F2C4  01 01F4     	LD BC,500 		; 500*6us Dauer
  784 F2C7  CD F2CC     	CALL DELAY
  785 F2CA  C1          	POP BC
  786 F2CB  C9          	RET
  787                   
  788                   ;------------------------------------------------------------------------------
  789                   ; delay: 6 microseconds at 4 MHz
  790                   
  791 F2CC  0B          DELAY:	DEC BC
  792 F2CD  78          	LD A,B
  793 F2CE  B1          	OR C
  794 F2CF  C2 F2CC     	JP NZ,DELAY
  795                   	
  796 F2D2  C9          	RET
  797                   
  798                   ;------------------------------------------------------------------------------
  799                   ; Seek to track
  800                   ; C=Drive D=Track E=Sector
  801                   
  802 F2D3  CD F2C3     SEEK:	CALL WAWA 		; short delay
  803                   
  804 F2D6  79          	LD A,C
  805 F2D7  D3 C4       	OUT (FLO+4),A 		; drive code, density and side
  806 F2D9  7B          	LD A,E
  807 F2DA  D3 C2       	OUT (FLO+2),A 		; Sector
  808 F2DC  7A          	LD A,D
  809 F2DD  D3 C3       	OUT (FLO+3),A 		; track
  810 F2DF  06 1C       	LD B,1CH 		; seek command
  811 F2E1  3A F3FA     	LD A,(STEPRATE)
  812 F2E4  E6 03       	AND 3  			; 0,1,2,3 zulaessig
  813 F2E6  B0          	OR B  			; 
  814 F2E7  D3 C0       	OUT (FLO),A 		; execute Seek together with steprate
  815                   
  816 F2E9  76          	HALT  			; wait for INT
  817                   
  818                   ;------------------------------------------------------------------------------
  819                   ; Kopf auf Spur 0 stellen
  820                   			
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  15
MON80V2 Z80

  821 F2EA  CD F2C3     RSTORE:	CALL WAWA		; short delay
  822                   
  823 F2ED  79          	LD A,C  		; Laufwerkscode (drive)
  824 F2EE  D3 C4       	OUT (FLO+4),A 		; mit Dichtecode etc. ausgeben
  825                   	
  826 F2F0  06 08       	LD B,8  		; nur Head-load, kein verify
  827 F2F2  3A F3FA     	LD A,(STEPRATE)
  828 F2F5  E6 03       	AND 3  			; 0,1,2,3 zulaessig
  829 F2F7  B0          	OR B  			; als Befehl kombiniert
  830 F2F8  D3 C0       	OUT (FLO),A 		; und ausfuehren
  831                   	
  832 F2FA  76          	HALT  			; wait for INT
  833                   
  834                   ;------------------------------------------------------------------------------
  835                   ; Floppy Kernal Routines
  836                   
  837                   ; HL=Address, d=Track e=Sector
  838                   ; b=Command (0=set dteprate, 1=read, 2=write)
  839                   ; c=drive code
  840                   ;   aufgebaut wie Statusregister
  841                   ;   7    6    5    4    3    2    1    0
  842                   ;   sso  mot  min  dens d    d    d    d
  843                   ;   sso  = seitenauswahl (1=seite 1)
  844                   ;   mot  = motor on code (std=0)
  845                   ;   min  = 1 bei Minilaufwerken
  846                   ;   dens = 1 bei Single Dense Aufzeichnung
  847                   ; d=binary drive code
  848                   ;   normalerweise nur 1,2,4,8 moeglich
  849                   ;   Kombinationen moeglich, wenn binaere
  850                   ;   Dekodierung beim Laufwerk verwendet wird
  851                   
  852 F2FB  78          SOFTEX:	LD A,B			; B = steprate
  853 F2FC  B7          	OR A
  854 F2FD  20 08       	JR NZ,SOFT1
  855                   
  856                   	; set new steprate (0..3 in D, SSO in bit 7)
  857 F2FF  7A          	LD A,D   		; (+80h =SSO verwenden und pruefen).
  858 F300  E6 83       	AND 83h  		; Bit 7=SSO-Flag bei Zugriffen wichtig
  859 F302  32 F3FA     	LD (STEPRATE),A		; die die zweite Seite verwenden.
  860 F305  AF          	XOR A
  861 F306  C9          	RET
  862                   
  863 F307  AF          SOFT1:	XOR A
  864 F308  32 F401     	LD (ERRCNT),A 		; Fehlerzahl 0
  865 F30B  79          	LD A,C
  866 F30C  32 F402     	LD (DRVCOD),A 		; Drive-Code
  867 F30F  E6 0F       	AND 0FH 		; fuer Vergleich
  868 F311  4F          	LD C,A  		; wieder zurueck
  869 F312  3A F403     	LD A,(CURDRV)
  870 F315  FE FF       	CP 0FFH 		; ungueltig, dann setzen noetig
  871 F317  28 14       	JR Z,NOTDEF
  872                   	
  873 F319  E6 0F       	AND 0FH 		; nur Laufwerksnummer relevant
  874 F31B  B9          	CP C  			; Vergleich ob Laufwerkewechsel
  875 F31C  CA F35B     	JP Z,NURSEEK 		; nur Seek noetig
  876 F31F  E5          	PUSH HL
  877 F320  C5          	PUSH BC
  878 F321  21 F404     	LD HL,DRVTAB 		; Basisadresse
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  16
MON80V2 Z80

  879 F324  4F          	LD C,A
  880 F325  06 00       	LD B,0  		; alten Laufwerktrack merken
  881 F327  09          	ADD HL,BC
  882 F328  DB C1       	IN A,(FLO+1) 		; Tracknr
  883 F32A  77          	LD (HL),A 		; und dort ablegen
  884 F32B  C1          	POP BC
  885 F32C  E1          	POP HL
  886                   
  887 F32D              notdef:				; Drive nur laden
  888 F32D  E5          	PUSH HL
  889 F32E  C5          	PUSH BC
  890 F32F  3A F402     	LD A,(DRVCOD) 		; neues Laufwerk
  891 F332  E6 0F       	AND 0FH 		; nur Laufwerkscode
  892 F334  4F          	LD C,A
  893 F335  06 00       	LD B,0
  894 F337  21 F404     	LD HL,DRVTAB 		; Tabellenstart
  895 F33A  09          	ADD HL,BC 		; hl zeigt auf Laufwerkstrack
  896 F33B  7E          	LD A,(HL)
  897 F33C  D3 C1       	OUT (FLO+1),A 		; und ins Register des FDs
  898 F33E  C1          	POP BC
  899 F33F  E1          	POP HL
  900 F340  3A F402     	LD A,(DRVCOD)
  901 F343  32 F403     	LD (CURDRV),A 		; ist nun neues Laufwerk
  902 F346  C5          	PUSH BC
  903 F347  01 00FA     	LD BC,1000*3/12		; ca 1ms warten
  904 F34A  CD F2CC     	CALL DELAY
  905 F34D  3A F402     	LD A,(DRVCOD) 		; Dann neues Laufwerk ansprechen
  906 F350  D3 C4       	OUT (FLO+4),A
  907 F352  01 0B65     	LD BC,2917		; ca 35ms .. 15ms
  908 F355  CD F2CC     	CALL DELAY		; um headload-Zeit zu beruecksichtigen 
  909 F358  C1          	POP BC  		; alte Codes zurueck
  910 F359  18 06       	JR NUR1 		; Immer auf ready pruefen, da
  911                   				; head down sein kann und dennoch
  912                   				; nicht ready
  913                   
  914 F35B              nurseek:
  915 F35B  DB C4       	IN A,(FLO+4) 		; wenn head down dann kein dummyseek
  916 F35D  E6 20       	AND 20H
  917 F35F  20 0D       	JR NZ,NODUM
  918                   
  919 F361              nur1:				; immer einsprung
  920 F361  3A F402     	LD A,(DRVCOD)
  921 F364  4F          	LD C,A
  922 F365  CD F3F0     	CALL SEEKEX 		; seek selekt dummy nur fuer readytest
  923 F368  DB C0       	IN A,(FLO)		; test Status
  924 F36A  E6 80       	AND 80H 		; fuer Ready
  925 F36C  20 F3       	JR NZ,NUR1		; Wiederhole solange bis Laufwerk READY
  926                   
  927 F36E              nodum:				; Einsprung head down ok
  928 F36E  DB C1       	IN A,(FLO+1) 		; nun pruefen of Tracks gleich sind
  929 F370  FE FF       	CP 0FFH 		; nicht definiert
  930 F372  28 0F       	JR Z,TRY1 		; dann zuerst RESTORE
  931 F374  BA          	CP D  			; oder schon auf dem Track
  932 F375  CA F3A2     	JP Z,RDWR 		; ja dann nur lesen,schreiben
  933 F378              	TRY:  			; SEEK ausfuehren
