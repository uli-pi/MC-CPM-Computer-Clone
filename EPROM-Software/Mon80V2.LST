  464 F1B0  E6 03       	AND 3  		; muss Bereich 0..3 sein
  465 F1B2  FE 00       	CP 0  		; 0 seite 0
  466 F1B4  20 03       	JR NZ,MAX1
  467                   	
  468 F1B6  0E 11       	LD C,00010001B 	; LW 1
