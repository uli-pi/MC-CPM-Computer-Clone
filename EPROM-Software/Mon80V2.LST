  876                   
  877 F35B              nurseek:
  878 F35B  DB C4       	IN A,(FLO+4) 		; wenn head down dann kein dummyseek
  879 F35D  E6 20       	AND 20H
  880 F35F  20 0D       	JR NZ,NODUM
  881                   
  882 F361              nur1:				; immer einsprung
  883 F361  3A F402     	LD A,(DRVCOD)
  884 F364  4F          	LD C,A
  885 F365  CD F3F0     	CALL SEEKEX 		; seek selekt dummy nur fuer readytest
  886 F368  DB C0       	IN A,(FLO)		; test Status
  887 F36A  E6 80       	AND 80H 		; fuer Ready
  888 F36C  20 F3       	JR NZ,NUR1		; Wiederhole solange bis Laufwerk READY
  889                   
