    2                   	
    3                   	.Z80
    4                   ;---------------------------------------------------------------
    5                   ; Monitor fuer MC-Computer Platine SYS-80 und SYS-80s
    6                   ; Assembliert mit Z80ASM von SLR Systems wegen der langen
    7                   ; Label die mit einigen anderen Assemblern nicht moeglich sind.
    8                   ;
    9                   ; Erstellt 05/2026 von U. Haumann
   10                   ; Enthaelt weitgehend Routinen aus RDK Monitor 1.1 850129
   11                   ; V7.2 851216, sowie Teile aus dem Monitor von Donn Stewart 
   12                   ; fuer den "CPU-Ville" Z80 Computer.
   13                   ; Treiber fuer Serielle Schnittstelle auf CPU-Platine mit UART 8251
   14                   ; implementiert.
   15                   ; Flo1 und Flo2 waehlber auf Hardware Basis Adresse 0C0h.
   16                   ; Der Mointor erwartet 64KB Ram Memory. Er darf selbst nicht
   17                   ; groesser als 4KB werden, es sein denn man schiebt die MON_ADR
   18                   ; und CCP weiter nach unten. Der CPM Bereich verkleinert sich dann.
   19                   ; Der Monitor kopiert sich nach Reset an das Speicherende
   20                   ; auf den Wert in MON_ADR und gibt den unteren RAM Bereich frei.
   21                   ; Dies wird auf der SYS CPU Platine mit einem Lesebefehl auf
   22                   ; Adresse 7000h erreicht. Das Eprom ist dann ausgeblendet.
   23                   ; Somit steht der Speicher durchgaengig ab 0000h bis zu MON_ADR
   24                   ; zur Verfuehgung.
   25                   ; Das CPM BIOS fuer den MC-Computer ueberschreibt den Monitorbereich
   26                   ; ab FC00h. Alle relevanten Teile f|r den Betrieb des Rechners 
   27                   ; muessen vor FC00h plaziert werden.
   28                   
   29                   ; 06/2026 Ueberarbeitet von Detlef Gerhardt
   30                   ; komplette Ueberarbeitung der Labels und sukzessive Kommentierung des Quellcodes
   31                   ; um nach und nach moeglichst viele Routinen zu verstehen.
   32                   ; Diese Version ist bis auf die Versionsnummer noch binaerkompatibel zu Version 8.0v1
   33                   ; --- Work in progress ---
   34                   
   35                   ;------------------------------------------------------------------------------
   36                   ; Mapping of REG-Latch
   37                   
   38                   ; Bit0 = Drive Select 1
   39                   ; Bit1 = Drive Select 1
   40                   ; Bit2 = Drive Select 3
   41                   ; Bit3 = Drive Select 4
   42                   ; Bit4 = FDC9239 Dens (0=DD, 1=SS)
   43                   ; Bit5 = FDC9239 Mini (0=Maxi, 1=Mini)
   44                   ; Bit6 = Motor On (Jumper)
   45                   ; Bit7 = Side Select (Jumper)
   46                   
   47                   ;------------------------------------------------------------------------------
   48                   ; Constants
   49                   
   50         0000      FALSE	EQU 0
   51         0001      TRUE	EQU 1
   52         000D      CR 	EQU 0DH
   53         000A      LF 	EQU 0AH
   54         0007      BELL	EQU 7
   55         00FF      RUB 	EQU 0FFH
   56         0000      FIL 	EQU 0
   57         0007      MAX	EQU 7
   58         001B      ESC	EQU 1BH
   59                   
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page   2
MON80V2 Z80

   60         0038      RST7	EQU 38H		; der Vektor RST7 wird fuer Breakpoints gebraucht
   61                   
   62                   ;------------------------------------------------------------------------------
   63                   ; I/O addresses
   64                   
   65                   ; SYS80S = TRUE:  serial port of SYS-80S card ist used for console
   66                   ; SYS80S = FALSE: serial port SIO A at OUT-80 card is used for console
   67                   
   68                   ; OUT-80 card SIO B is used for reader, punch and lister
   69                   
   70         0001      SYS80S	EQU TRUE
   71                   
   72                   ; Addresses of serial port UART 8251 at SYS-80s CPU card
   73         0020      SU_DAT	EQU 020H	; UART 8251 Daten
   74         0021      SU_STS	EQU 021H	; UART 8251 Control
   75         0002      SU_RXB	EQU 002h	; RX Ready Bit UART 8251
   76         0001      SU_TXB	EQU 001h	; TX Ready Bit UART 8251
   77                   
   78                   ; Addresses of serial port MC Computer OUT-80 card with SIO
   79         00F0      SA_DAT	EQU 0F0H	; SIO A Daten
   80         00F1      SA_STS	EQU 0F1H	; SIO A Control
   81         00F2      SB_DAT	EQU 0F2H	; SIO B Daten
   82         00F3      SB_STS	EQU 0F3H	; SIO B Control
   83         0001      SI_RXB	EQU 01h		; SIO RX Ready Bit
   84         0004      SI_TXB	EQU 04h		; SIO TX Ready Bit
   85                   
   86         0001      	IF SYS80S
   87                   
   88                   ; Console is redirected to UART on SYS-80s
   89         0020      CO_DAT	EQU SU_DAT
   90         0021      CO_STS	EQU SU_STS
   91         0002      CO_RXB	EQU SU_RXB
   92         0001      CO_TXB	EQU SU_TXB
   93                   
   94                   	ELSE
  102                   	ENDIF
  103                   
  104                   ; Reader port (SIO B)
  105         00F2      RE_DAT	EQU SB_DAT
  106         00F3      RE_STS	EQU SB_STS
  107         0001      RE_RXB	EQU SI_RXB
  108         0004      RE_TXB	EQU SI_TXB
  109                   
  110                   ; Punch port (SIO B)
  111         00F2      PU_DAT	EQU SB_DAT
  112         00F3      PU_STS	EQU SB_STS
  113         0001      PU_RXB	EQU SI_RXB
  114         0004      PU_TXB	EQU SI_TXB
  115                   
  116                   ; List port (SIO B)
  117         00F2      LI_DAT	EQU SB_DAT
  118         00F3      LI_STS	EQU SB_STS
  119         0001      LI_RXB	EQU SI_RXB
  120         0004      LI_TXB	EQU SI_TXB
  121                   
  122                   
  123                   ; Address of IDE-80 CF-Adapter card
  124                   
