  133                   ; Address of IDE-80 CF-Adapter card
  134                   
  135         0018      IDEDATA	EQU 018h	; IDE Data Register
  136         001A      SECCND	EQU 01Ah	; Sector Count Register
  137         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
  138         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
  139         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
  140         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
  141         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
  142                   
  143                   ;------------------------------------------------------------------------------
  144                   
  145         0000      	ORG 0000h		; start address in ROM
  146                   
  147                   	; Copy Monitor from address ROMSTRT in ROM to address F000 in RAM
  148                   
  149 0000  31 FFFF     BEGIN:	LD SP,0FFFFh 		; set Stack to end of memory
  150 0003  3E C9       	LD A,0C9h 		; place RET command at F000h
  151 0005  32 F000     	LD (0F000h),A 		; 
  152 0008  CD F000     	CALL 0F000h 		; and call it
  153                   
  154 000B  3B          OFFS:	DEC SP  		; get return address from Stack to calculate
  155 000C  3B          	DEC SP  		; Monitor location in ROM
  156 000D  D1          	POP DE
  157 000E  21 0012     	LD HL,ROMSTRT-OFFS	; offset from BEG to ROMSTRT
  158 0011  19          	ADD HL,DE		; actual Montor address in ROM as source address in HL
  159 0012  11 F000     	LD DE,0F000h 		; dest address in DE
  160 0015  01 0FFF     	LD BC,0FFFh 		; length in BC (4KB - 1)
  161 0018  ED B0       	LDIR  			; copy
  162 001A  C3 F000     	JP 0F000h 		; jump to Monitor in RAM
  163                   
  164                   ;------------------------------------------------------------------------------
  165                   ; Start of Monitor program, ROM address 0F000h
  166                   
  167 001D              ROMSTRT:
  168                   	; Start address of Monitor in ROM
  169                   	; label must be located before .PHASE
  170                   
  171                   	.PHASE 0F000H	; monitor start address in RAM
  172                   
  173 F000  C3 F071     	JP INIT
  174 F003  C3 F084     	JP CONIN	; Console In
  175 F006  C3 F097     	JP READIN	; Reader In (<- SIO B)
  176 F009  C3 F0AD     	JP CONOUT	; Console Out
  177 F00C  C3 F0C1     	JP PUNOUT	; Punch Out (-> SIO B)
  178 F00F  C3 F0D8     	JP LSTOUT	; List Out (-> SIO B)
  179 F012  C3 F0EF     	JP CONSTS	; Get console status, 0FFh in A, if character available
  180 F015  C3 F102     	JP IOGET	; Get iobyte, current configuration in A
  181 F018  C3 F106     	JP IOSET	; Set iobyte, new configuration in C
  182 F01B  C3 F10B     	JP MEMCHK	; High memory in B, low memory in A
