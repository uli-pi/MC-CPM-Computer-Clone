 1173                   ;==============================================================================
 1174                   ; IDE/CF card interface
 1175                   ;
 1176                   ; Read one IDE/CF card sector (256 bytes)
 1177                   ;
 1178                   ; Address for data in HL
 1179                   ; LBA bits 0 to 7 passed in C
 1180                   ; LBA bits 8 to 15 passed in B
 1181                   ; LBA bits 16 to 23 passed in E
 1182                   
 1183 F588              IDERD:
 1184 F588  DB 1F       IDERD1:	IN	A,(IDESTAT)	; check status
 1185 F58A  E6 80       	AND	80H		; check BSY bit
 1186 F58C  C2 F588     	JP	NZ,IDERD1	; loop until not busy
 1187                   
 1188 F58F  DB 1F       IDERD2:	IN	A,(IDESTAT)	; check	status
 1189 F591  E6 40       	AND	40H		; check DRDY bit
 1190 F593  CA F58F     	JP	Z,IDERD2	; loop until ready
 1191                   
 1192 F596  3E 01       	LD	A,01H		; number of sectors = 1
 1193 F598  D3 1A       	OUT	(SECCND),A	; sector count register
 1194 F59A  79          	LD	A,C
 1195 F59B  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1196 F59D  78          	LD	A,B
 1197 F59E  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1198 F5A0  7B          	LD	A,E
 1199 F5A1  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1200 F5A3  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1201 F5A5  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1202 F5A7  3E 20       	LD	A,20H		; Read sector command
 1203 F5A9  D3 1F       	OUT	(IDESTAT),A
 1204                   
 1205 F5AB              IDERD3:	; wait for drq set
 1206 F5AB  DB 1F       	IN	A,(IDESTAT)	; read status
 1207 F5AD  E6 08       	AND	08H		; DRQ bit
 1208 F5AF  CA F5AB     	JP	Z,IDERD3	; loop until bit set
 1209                   	
 1210 F5B2              IDERD4:	; wait for busy clear
 1211 F5B2  DB 1F       	IN	A,(IDESTAT)
 1212 F5B4  E6 80       	AND	80H
 1213 F5B6  C2 F5B2     	JP	NZ,IDERD4
 1214                   	
 1215 F5B9  DB 1F       	IN	A,(IDESTAT)	; clear INTRQ
 1216                   
 1217 F5BB              IDERD5: ; read loop
 1218 F5BB  DB 18       	IN	A,(IDEDATA)	; get data
 1219 F5BD  77          	LD	(HL),A
 1220 F5BE  23          	INC	HL
 1221 F5BF  DB 1F       	IN	A,(IDESTAT)	; check status
 1222 F5C1  E6 08       	AND	08H		; DRQ bit
 1223 F5C3  C2 F5BB     	JP	NZ,IDERD5	; loop until cleared
 1224                   	
 1225 F5C6  C9          	RET
 1226                   			
"MC CPM-Computer Mon80V2"       			    Z80ASM 1.32 Page  22
MON80V2 Z80

 1227                   ;------------------------------------------------------------------------------
 1228                   ; Write one IDE/CF-card sector (256 bytes)
 1229                   ;
 1230                   ; Address of data in HL
 1231                   ; LBA bits 0 to 7 passed in C
 1232                   ; LBA bits 8 to 15 passed in B
 1233                   ; LBA bits 16 to 23 passed in E
 1234                   
 1235 F5C7              IDEWR:
 1236 F5C7  DB 1F       IDEWR1:	IN	A,(IDESTAT)	; check status
 1237 F5C9  E6 80       	AND	80H		; check BSY bit
 1238 F5CB  C2 F5C7     	JP	NZ,IDEWR1	; loop until not busy
 1239                   
 1240 F5CE  DB 1F       IDEWR2:	IN	A,(IDESTAT)	; check status
 1241 F5D0  E6 40       	AND	40H		; check DRDY bit
 1242 F5D2  CA F5CE     	JP	Z,IDEWR2	; loop until ready
 1243                   
 1244 F5D5  3E 01       	LD	A,01H		; number of sectors = 1
 1245 F5D7  D3 1A       	OUT	(SECCND),A	; sector count register
 1246 F5D9  79          	LD	A,C
 1247 F5DA  D3 1B       	OUT	(LBA7),A	; lba bits 0 - 7
 1248 F5DC  78          	LD	A,B
 1249 F5DD  D3 1C       	OUT	(LBA15),A	; lba bits 8 - 15
 1250 F5DF  7B          	LD	A,E
 1251 F5E0  D3 1D       	OUT	(LBA23),A	; lba bits 16 - 23
 1252 F5E2  3E E0       	LD	A,11100000B	; LBA mode, select drive 0
 1253 F5E4  D3 1E       	OUT	(IDEHEAD),A	; drive/head register
 1254 F5E6  3E 30       	LD	A,30H		; Write sector command
 1255 F5E8  D3 1F       	OUT	(IDESTAT),A
 1256                   	
 1257 F5EA              IDEWR3:	; wait for drq set
 1258 F5EA  DB 1F       	IN	A,(IDESTAT)	; read status
 1259 F5EC  E6 08       	AND	08H		; DRQ bit
 1260 F5EE  CA F5EA     	JP	Z,IDEWR3	; loop until bit set			
 1261                   
 1262 F5F1              IDEWR4:	; write loop
 1263 F5F1  7E          	LD	A,(HL)
 1264 F5F2  D3 18       	OUT	(IDEDATA),A	; write data
 1265 F5F4  23          	INC	HL
 1266 F5F5  DB 1F       	IN	A,(IDESTAT)	; read status
 1267 F5F7  E6 08       	AND	08H		; check DRQ bit
 1268 F5F9  C2 F5F1     	JP	NZ,IDEWR4	; write until bit cleared
 1269                   
 1270 F5FC              IDEWR5:	; wait for busy clear
 1271 F5FC  DB 1F       	IN	A,(IDESTAT)
 1272 F5FE  E6 80       	AND	80H
 1273 F600  C2 F5FC     	JP	NZ,IDEWR5
 1274                   
 1275 F603  DB 1F       	IN	A,(IDESTAT)	; clear INTRQ
 1276 F605  C9          	RET
