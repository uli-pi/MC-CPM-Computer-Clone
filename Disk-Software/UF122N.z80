	JP .L71
.L72:
	CP 2
	JP NZ,.L73
	in a,(flob0)
;1 	endif
.L73:
.L71:
	and 44h
	ret

fmt::
	call setup 	; Dichte einstellen etc., auf Port FLO4
	ld a,(user)
;1 	if a=0  	; FLO 2
	OR A
	JP NZ,.L74
	ld hl,formtab 	; Startadresse 
	ld c,flo3 	; Datenport
	ld a,(sidesel) 	; Side-Flag setzen, fuer SSO-Ausgang
	and 80h 	; wenn Sideflag auf 80h gesetzt wird
	rlca  	; bit 0
	rlca  	; bit 1
	and 00000010b 	; 1=Seite 1
	or 0f4h 	; Formatier-Befehl+nicht documentierter
	out (flo0),a 	; Side-Select-Befehl fuer SSO
fmtlp::
	in a,(flo4) 	; drq int head
	rlca  	; bit 7 ins carryŠ	jp nc,fmtlp 	; 0=warten 1=fertig i
	outi  	; und Byte ausgeben
	jp fmtlp 	; durch INT wird die Routine gestoppt.
;1 	elseif a=1 	; FLO1 maxi
	JP .L75
.L74:
	CP 1 
	JP NZ,.L76
	ld hl,formtab 	; Startadresse 
	ld c,floa3 	; Datenport
	ld a,(sidesel) 	; Side-Flag setzen, fuer SSO-Ausgang
	and 80h 	; wenn Sideflag auf 80h gesetzt wird
	rlca  	; bit 0
	rlca  	; bit 1
	and 00000010b 	; 1=Seite 1
	or 0f4h 	; Formatier-Befehl+nicht documentierter
	out (floa0),a 	; Side-Select-Befehl fuer SSO
famtlp::
	in a,(floa4) 	; drq int head
	rlca  	; bit 7 ins carry
	jp nc,famtlp 	; 0=warten 1=fertig i
	outi  	; und Byte ausgeben
	jp famtlp 	; durch INT wird die Routine gestoppt.
;1 	elseif a=2 	; FLO1 mini
	JP .L75
.L76:
	CP 2 
	JP NZ,.L77
	ld hl,formtab 	; Startadresse 
	ld c,flob3 	; Datenport
	ld a,(sidesel) 	; Side-Flag setzen, fuer SSO-Ausgang
	and 80h 	; wenn Sideflag auf 80h gesetzt wird
	rlca  	; bit 0
	rlca  	; bit 1
	and 00000010b 	; 1=Seite 1
	or 0f4h 	; Formatier-Befehl+nicht documentierter
	out (flob0),a 	; Side-Select-Befehl fuer SSO
fbmtlp::
	in a,(flob4) 	; drq int head
	rlca  	; bit 7 ins carry
	jp nc,fbmtlp 	; 0=warten 1=fertig i
	outi  	; und Byte ausgeben
	jp fbmtlp 	; durch INT wird die Routine gestoppt.
;1 	endif
.L77:
