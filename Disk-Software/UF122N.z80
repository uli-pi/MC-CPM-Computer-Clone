	.z80
		;*********************************************************************
		;* Universal Formatierer fuer Mini/Maxi                              *
		;* Rev 1.22 (C) 1984 Rolf-Dieter Klein / JS                          *
		;* FLO2-Baugruppe / MC/ NDR/                                         *
		;* FLO1-Baugruppe MC                                                 *
		;* 31.05.2026 *dg* Quellcode der Version 1.22 aus COM-Datei          *
		:                  wiederhergestellt                                 *
		;*********************************************************************
	flo0 equ 0c0h 	; FLO2-Mini/Maxi.
	flo1 equ 0c1h
	flo2 equ 0c2h
	flo3 equ 0c3h
	flo4 equ 0c4h
		;
	floa0 equ 040h 	; FLO1-Maxi
	floa1 equ 041h
	floa2 equ 042h
	floa3 equ 043h
	floa4 equ 044h
		;
	flob0 equ 030h 	; FLO1-Mini
	flob1 equ 031h
	flob2 equ 032h
	flob3 equ 033h
	flob4 equ 034h
		;
		; arbeitet unabhaengig vom CP/M - Betriebsystem.
	jp start 	; Hauptprogr.

co::	jp 0f009h 	; Ausgabe eines Zeichens in C

ci::	; v1.22
	call 0f003h 	; Eingabe eines Zeichens nach A
	and 7Fh
	ret

int::
	pop af  	; spez. Int-Routine
	in a,(floa0)
	in a,(flob0)
	in a,(flo0) 	; Status flo ist wichtig
	ei
	reti  	; ok fertig

format::		; Universal Formatierer
	ld hl,fmsg 
	call print
	in a,(floa0) 	; ggf. bei gemischtem Betrieb auch
	in a,(flob0)   	; andere Ports loeschen
	in a,(flo0) 	; alle Interrupts loeschen
		;
	im 1  	; Mode 1, RST-7 verwenden
	ld a,0c3h 	; Sprungvektor setzen
	ld (38h),a
	ld hl,int
	ld (39h),hl 	; auf Interruptroutine
		; 
	call rstore 	; Auf Spur 0 bringen
		;
	xor a
	ld (akttrk),a  	; Start bei Spur 0
	ld a,(spuren) 	; Anzahl Spuren
	ld b,a
loop::
	push bc
	call ecmachk 	; falls Spur 0, und ecma70
	call gentrack 	; Spur generieren
	call form 	; und formatierenŠ	call errchk
	ld a,(kopf)
;1 	if a=1  	; Seite 1 auch
	CP 1  
	JP NZ,.L1
	ld a,(laufwerk) 	; Rueckseite setzen
	or 80h  	; aber kein Side-sel
	ld (laufwerk),a
	ld a,(sideflag)
;2 	if a<>0
	OR A
	JP Z,.L2
	ld a,80h
	ld (sidesel),a 	; setzen
;2 	endif
.L2:
	call gentrack
	call form
	call errchk
	ld a,(laufwerk)
	and 7fh
	ld (laufwerk),a   
	xor a
	ld (sidesel),a
;1 	endif
.L1:
	ld a,(akttrk)
	inc a
	ld (akttrk),a
	ld b,a
	ld a,(spuren)
;1 	if a<>b
	CP b
	JP Z,.L3
	call stepin
;1 	endif
.L3:
	ld c,'F'
	call co 	; Meldung FFFFF ausgeben bei jeder Spur ein F
	pop bc
	djnz loop
		; Verify
	ld hl,vmsg
	call print
	call rstore
	xor a
	ld (akttrk),a  	; Start bei Spur 0
	ld a,(spuren) 	; Anzahl Spuren
	ld b,a
loop1::
	push bc
	call ecmachk
	call verify
	ld a,(kopf)
;1 	if a=1
	CP 1
	JP NZ,.L4
	ld a,(laufwerk)
	or 80h
	ld (laufwerk),a
	ld a,(sideflag)
;2 	if a<>0
	OR A
	JP Z,.L5Š	ld a,80h
	ld (sidesel),a 	; setzen
;2 	endif
.L5:
	call verify
	ld a,(laufwerk)
	and 7fh
	ld (laufwerk),a 
	xor a
	ld (sidesel),a 	; wieder Seite 0
;1 	endif
.L4:
	ld a,(akttrk)
	inc a
	ld (akttrk),a
	ld b,a
	ld a,(spuren)
;1 	if a<>b
	CP b
	JP Z,.L6
	call stepin
;1 	endif
.L6:
	ld c,'V' 
	call co 	; VVVVV fuer Verify
	pop bc
	djnz loop1
	call rstore 	; und am Schluss auf 0 zurueck
	ret

ecmachk:
	ld a,(ecma)
	or a
	ret z  	; 0=kein ECMA70 Format
	xor a
	ld (minimax),a 	; immer Minilaufwerk
	ld a,(akttrk) 	; = Spur 0, dann SD-Formatieren
;1 	if a=0
	OR A
	JP NZ,.L7
	ld hl,128
	ld (anzbyte),hl
	ld a,0 	; erste Spur einfache Dichte
	ld (dichte),a 	;
	ld a,0
	ld (kopf),a 	; 16 x SD , 40 Spuren
	ld a,16
	ld (sektoren),a
	ld a,27
	ld (gaplen),a
	ld a,40
	ld (spuren),a
;1 	else
	JP .L8
.L7:
	ld hl,256 	; rest DD
	ld (anzbyte),hl
	ld a,1
	ld (dichte),a 	; DD
	ld a,0
	ld (kopf),a 	; nur einseitig
	ld a,16 	; Sektorenzahl
	ld (sektoren),a
	ld a,54
	ld (gaplen),a 	; STD GapŠ	ld a,40 	; und 40 Spuren
	ld (spuren),a
;1 	endif
.L8:
	ret
errchk:		; allgemeine Fehlerpruefroutine
	or a
	ret z  	; =0, Status ok
		; Track, Spur ausgeben
	push af 	; Fehlercode retten
	ld hl,tkmsg
	call print
	ld a,(akttrk)
	ld l,a
	ld h,0 
	call printhl
	ld hl,skmsg
	call print
	ld a,(aktsek)
	ld l,a
	ld h,0
	call printhl
	call crlf
		;
	pop af  	; Fehlercode zurueck
	bit 2,a
	ld hl,f0msg 	; error
;1 	if nz
	JP Z,.L9
	ld hl,f2msg
;1 	endif
.L9:
	bit 3,a
;1 	if nz
	JP Z,.L10
	ld hl,f3msg
;1 	endif
.L10:
	bit 4,a
;1 	if nz
	JP Z,.L11
	ld hl,f4msg
;1 	endif
.L11:
	bit 5,a
;1 	if nz
	JP Z,.L12
	ld hl,f5msg
;1 	endif
.L12:
	bit 6,a
;1 	if nz
	JP Z,.L13
	ld hl,f6msg
;1 	endif
.L13:
;1 	if nz
	JP Z,.L14
	ld hl,f6msg 	; dominant ist Fehler, Writeprot.
;1 	endif
.L14:
	call print
;1 	repeat
.L15:
	call ci
;1 	until a in ['W','w']
	CP 'W'
	JP Z,.L16
	CP 'w'Š	JP NZ,.L15
.L16:
	jp start 	; Stack adjust nicht noetig 
printhl:		; dezimale Ausgabe
	xor a
	push af
aus1:
	ld a,16
	ld bc,10 	; div 10
	ld de,0 	; Rest
	ex de,hl
divlp:
	push af
	sla e
	rl d
	rl l
	rl h
	set 0,e
	xor a
	sbc hl,bc
;1 	if c
	JP NC,.L17
	add hl,bc
	res 0,e
;1 	endif
.L17:
	pop af
	dec a
	jr nz,divlp
	ex de,hl 	; hl=erg, de=rest
		;
	ld a,e
	or 30h
	push af
	ld a,h
	or l
	jr nz,aus1
aus2:
	pop af
	or a
	ret z
	ld c,a
	call co
	jr aus2
gentrack::		; neue Spur erzeugen
	ld ix,formtab 	; Startadresse Formattabelle 
		; header ausgeben
	ld a,(dichte) 	; je nach dichte
;1 	if a=0
	OR A
	JP NZ,.L18
	ld b,16
	ld c,0ffh 	; fuellbyte 
;1 	else
	JP .L19
.L18:
	ld b,32 	; bei doppelter Dichte
	ld c,04eh
;1 	endif
.L19:
;1 	do b
.L20:
	ld (ix+0),c
	inc ix
;1 	enddo  	; Header wird abgelegt
	DEC BŠ	JP NZ,.L20
		; Sektorenschleife
	ld a,1
	ld (aktsek),a 	; aktueller Sektor
	ld a,(sektoren)
	ld b,a
;1 	do b
.L21:
	push bc
		; ID-Feld aufbereiten
	ld a,(dichte)
;2 	if a=0 	; SD
	OR A
	JP NZ,.L22
;3 	do b,6
	LD b,6
.L23:
	ld (ix+0),0
	inc ix
;3 	enddo
	DEC B
	JP NZ,.L23
	ld (ix+0),0feh 	; ID-Adress-Mark
	inc ix
	ld a,(akttrk)
	ld (ix+0),a  	; Track 0..n
	inc ix
	ld a,(sidesel) 	; fuer Side-Flag
	and 80h  	;
;3 	if a=0
	OR A
	JP NZ,.L24
	ld (ix+0),0  	; Seite 0
;3 	else
	JP .L25
.L24:
	ld (ix+0),1  	; Seite 1
;3 	endif
.L25:
	inc ix
	ld a,(aktsek)
	ld (ix+0),a  	; Sektor 1..n
	inc ix
	ld hl,(anzbyte) 	; 128,256,512,1024
	ld a,h  	; 0,1,2,4 da 80h,100h,200h,400h
;3 	if a=4
	CP 4
	JP NZ,.L26
	ld a,3
;3 	endif
.L26:
	ld (ix+0),a  	; 0,1,2,3 Laengenkennung
	inc ix
	ld (ix+0),0f7h 	; und CRC erzeugen
	inc ix
;3 	do b,11
	LD b,11
.L27:
	ld (ix+0),0ffh
	inc ix
;3 	enddo
	DEC B
	JP NZ,.L27
;3 	do b,6
	LD b,6
.L28:
	ld (ix+0),0
	inc ixŠ;3 	enddo
	DEC B
	JP NZ,.L28
	ld (ix+0),0fbh 	; Data Mark
	inc ix
;2 	else  	; DD
	JP .L29
.L22:
;3 	do b,12
	LD b,12
.L30:
	ld (ix+0),0
	inc ix
;3 	enddo
	DEC B
	JP NZ,.L30
;3 	do b,3
	LD b,3
.L31:
	ld (ix+0),0f5h
	inc ix
;3 	enddo
	DEC B
	JP NZ,.L31
	ld (ix+0),0feh 	; ID-Adress-Mark
	inc ix
	ld a,(akttrk)
	ld (ix+0),a  	; Track 0..n
	inc ix
	ld a,(sidesel) 	; fuer Side-Sel SSO
	and 80h
;3 	if a=0
	OR A
	JP NZ,.L32
	ld (ix+0),0  	; Seite 0
;3 	else
	JP .L33
.L32:
	ld (ix+0),1  	; Seite 1
;3 	endif
.L33:
	inc ix
	ld a,(aktsek)
	ld (ix+0),a  	; Sektor 1..n
	inc ix
	ld hl,(anzbyte) 	; 128,256,512,1024
	ld a,h  	; 0,1,2,4 da 80h,100h,200h,400h
;3 	if a=4
	CP 4
	JP NZ,.L34
	ld a,3
;3 	endif
.L34:
	ld (ix+0),a  	; 0,1,2,3 Laengenkennung
	inc ix
	ld (ix+0),0f7h 	; und CRC erzeugen
	inc ix
;3 	do b,22
	LD b,22
.L35:
	ld (ix+0),04eh
	inc ix
;3 	enddo
	DEC B
	JP NZ,.L35
;3 	do b,12
	LD b,12
.L36:
	ld (ix+0),0Š	inc ix
;3 	enddo
	DEC B
	JP NZ,.L36
;3 	do b,3
	LD b,3
.L37:
	ld (ix+0),0f5h
	inc ix
;3 	enddo
	DEC B
	JP NZ,.L37
	ld (ix+0),0fbh 	; Data Mark
	inc ix
;2 	endif
.L29:
		; Datenblock ablegen
	ld a,(filler) 	; Datenbyte
	ld c,a
	ld hl,(anzbyte) 	; 128,256,512,1024
;2 	do hl
.L38:
	ld (ix+0),c
	inc ix
;2 	enddo
	DEC HL
	LD A,H
	OR L
	JP NZ,.L38
		;
	ld (ix+0),0f7h 	; CRC ablegen danach
	inc ix
	ld a,(dichte)
;2 	if a=0
	OR A
	JP NZ,.L39
	ld c,0ffh  	; Datenbyte SD
;2 	else
	JP .L40
.L39:
	ld c,04eh  	; Datenbyte DD
;2 	endif
.L40:
	ld a,(gaplen)
	ld b,a  	; Gap 3 ablegen
;2 	do b
.L41:
	ld (ix+0),c
	inc ix
;2 	enddo
	DEC B
	JP NZ,.L41
		; alle Sektoren
	ld a,(aktsek)
	inc a
	ld (aktsek),a 	; neue Sektorennummer
	pop bc
;1 	enddo
	DEC B
	JP NZ,.L21
		; fuellen bis ende
	ld a,(dichte)
;1 	if a=0  	; SD
	OR A
	JP NZ,.L42
	ld c,0ffh 	; Gap 4
;1 	else  	; DDŠ	JP .L43
.L42:
	ld c,04eh
;1 	endif
.L43:
;1 	do hl,1000 	; Sicherheitshalber grosse Zahl
	LD hl,1000 
.L44:
	ld (ix+0),c   	; damit bis zum Indexpuls
	inc ix 	; keine Fremdbytes kommen
;1 	enddo
	DEC HL
	LD A,H
	OR L
	JP NZ,.L44
	ret
verify::		; pruefen einer Spur
	call wai  	; Head Settle Time
	ld a,1   	; beruecksichtigen
	ld (aktsek),a
	ld a,(sektoren)
	ld b,a
;1 	do b
.L45:
	push bc
	call read  	; einfach einlesen
	call errchk  	; =0 dann ok, sonst Meldung ausgeben
	ld a,(aktsek)
	inc a
	ld (aktsek),a
	pop bc
;1 	enddo
	DEC B
	JP NZ,.L45
	ret

wai::
	push bc 	; Warteschleife 40ms.. 10ms
	ld bc,0d05h
lp3::
	dec bc
	ld a,c
	or b
	jp nz,lp3
	pop bc
	ret
rstore::		; Auf Spur 0 bringen
	ld a,(user)
	or a  	; FLO2
	jp nz,rastore
	ld hl,250 	; Versuche max
r1st:
	push  hl
	in a,(flo0)
	call wai
	ei  	; Jetzt Int erlaubt
	call rexec
	di
	pop hl
	in a,(flo0) 	; Status pruefen
	and 80h 	; <>0 dann nicht ready
	jp z,r2st
	dec hl
	ld a,h
	or l  	; Anzahl versucheŠ	jr nz,r1st
		; FEHLER
	ld hl,rmsg
	call print
;1 	repeat
.L46:
	call ci
;1 	until a in ['W','w']
	CP 'W'
	JP Z,.L47
	CP 'w'
	JP NZ,.L46
.L47:
	jp start
rastore:
	cp 1  	; FLO1-Maxi
	jp nz,rbstore
	ld hl,250 	; Versuche max
ra1st:
	push  hl
	in a,(floa0)
	call wai
	ei  	; Jetzt Int erlaubt
	call raexec
	di
	pop hl
	in a,(floa0) 	; Status pruefen
	and 80h 	; <>0 dann nicht ready
	jp z,r2st
	dec hl
	ld a,h
	or l  	; Anzahl versuche
	jr nz,ra1st
		; FEHLER
	ld hl,rmsg
	call print
;1 	repeat
.L48:
	call ci
;1 	until a in ['W','w']
	CP 'W'
	JP Z,.L49
	CP 'w'
	JP NZ,.L48
.L49:
	jp start
rbstore:
	ld hl,250 	; Versuche max
rb1st:
	push  hl
	in a,(flob0)
	call wai
	ei  	; Jetzt Int erlaubt
	call rbexec 	; rev 1.2
	di
	pop hl
	in a,(flob0) 	; Status pruefen
	and 80h 	; <>0 dann nicht ready
	jp z,r2st
	dec hl
	ld a,h
	or l  	; Anzahl versuche
	jr nz,rb1st
		; FEHLER
	ld hl,rmsgŠ	call print
;1 	repeat
.L50:
	call ci
;1 	until a in ['W','w']
	CP 'W'
	JP Z,.L51
	CP 'w'
	JP NZ,.L50
.L51:
	jp start

r2st:		; fertig
	ret

rexec::		; Ausfuehrung
	call setup
	ld a,0bh 	; Rstore ohne Verify
	out (flo0),a
	halt  	; ueber INT zurueck

raexec::		; Ausfuehrung
	call setup
	ld a,0bh 	; Rstore ohne Verify
	out (floa0),a
	halt  	; ueber INT zurueck

rbexec::		; Ausfuehrung
	call setup
	ld a,0bh 	; Rstore ohne Verify
	out (flob0),a
	halt  	; ueber INT zurueck

stepin::		; Step ausfuehren
	call wai 	; aber erst nach Delay, sonst
	ei     	; gehen Tracks verloren
	call stpexec
	di
	ret

stpexec::
	call setup 	; Laufwerk und Dichte
	ld a,(user)
;1 	if a=0
	OR A
	JP NZ,.L52
	ld a,5bh
	out (flo0),a 	; Step ohne Verify
;1 	elseif a=1
	JP .L53
.L52:
	CP 1
	JP NZ,.L54
	ld a,5bh
	out (floa0),a
;1 	elseif a=2
	JP .L53
.L54:
	CP 2
	JP NZ,.L55
	ld a,5bh 
	out (flob0),a
;1 	endif
.L55:
.L53:
	halt 
Šread:
	ld b,2
read1:
	push bc
	ei
	call readex
	di
	pop bc  	; Fehlerzaehler
	ld a,(user)
;1 	if a=0
	OR A
	JP NZ,.L56
	in a,(flo0) 	; Status beim Lesen pruefen
;1 	elseif a=1
	JP .L57
.L56:
	CP 1
	JP NZ,.L58
	in a,(floa0)
;1 	elseif a=2
	JP .L57
.L58:
	CP 2
	JP NZ,.L59
	in a,(flob0)
;1 	endif
.L59:
.L57:
	and 00111100b 	; =0 dann ok
	ret z
	djnz read1 	; max Retry
	ret
readex:
	call setup 	; Dichtecode setzen, Head ist down.
	ld a,(user)
;1 	if a=0
	OR A
	JP NZ,.L60
	ld a,(aktsek)
	out (flo2),a 	; Sektor definieren
	ld hl,formtab 	; dorthin Daten legen 
	ld c,flo3 	; Datenport
	ld a,(sidesel) 	; fuer Side-Control
	and 80h
	rlca  	; bit 0
	rlca  	; bit 1
	and 00000010b 	; 1=Seite 1
	add a,88h 	; kein Delay abwarten, head ist down
	out (flo0),a 	; und Befehl geben
red1:
	in a,(flo4)
	rlca
	jp nc,red1 	; warten bis DRQ-da ist
	ini  	; Daten ablegen
	jp red1 	; bis alle Daten gelesen, dann Interrupt 
;1 	elseif a=1 	; flo 1 maxi
	JP .L61
.L60:
	CP 1 
	JP NZ,.L62
	ld a,(aktsek)
	out (floa2),a 	; Sektor definieren
	ld hl,formtab 	; dorthin Daten legen 
	ld c,floa3 	; Datenport
	ld a,(sidesel) 	; fuer Side-Control
	and 80hŠ	rlca  	; bit 0
	rlca  	; bit 1
	and 00000010b 	; 1=Seite 1
	add a,88h 	; kein Delay abwarten, head ist down
	out (floa0),a 	; und Befehl geben
raed1:
	in a,(floa4)
	rlca
	jp nc,raed1 	; warten bis DRQ-da ist
	ini  	; Daten ablegen
	jp raed1 	; bis alle Daten gelesen, dann Interrupt 
;1 	elseif a=2 	; flo1 Mini
	JP .L61
.L62:
	CP 2 
	JP NZ,.L63
	ld a,(aktsek) 
	out (flob2),a 	; Sektor definieren
	ld hl,formtab 	; dorthin Daten legen 
	ld c,flob3 	; Datenport
	ld a,(sidesel) 	; fuer Side-Control
	and 80h
	rlca  	; bit 0
	rlca  	; bit 1
	and 00000010b 	; 1=Seite 1
	add a,88h 	; kein Delay abwarten, head ist down
	out (flob0),a 	; und Befehl geben
rbed1:
	in a,(flob4)
	rlca
	jp nc,rbed1 	; warten bis DRQ-da ist
	ini  	; Daten ablegen
	jp rbed1 	; bis alle Daten gelesen, dann Interrupt 
;1 	endif
.L63:
.L61:
	ret 

setup::
	push bc
	ld a,(laufwerk) 	; Laufwerkscode
	ld b,a 
	ld a,(dichte)
;1 	if a=0   	; SD
	OR A
	JP NZ,.L64
	ld a,b
	or 10h
	ld b,a
;1 	endif
.L64:
	ld a,(minimax)
;1 	if a=0   	; Mini
	OR A
	JP NZ,.L65
	ld a,b
	or 20h
	ld b,a
;1 	endif
.L65:
	ld a,(user)
;1 	if a=0   	; FLO2
	OR A
	JP NZ,.L66
	; v1.22
	LD A,(flotyp)
	CP 01h
	JP NZ,L0653
	
	ld a,b  	; OK Code fertig
	XOR 10h
	JP L0654
L0653:
	LD a,b
L0654:
	pop bc
	out (flo4),a	;
;1 	elseif a=1  	; MAXI
	JP .L67
.L66:
	CP 1  
	JP NZ,.L68
	ld a,b
	pop bc
	xor 10h  	; DENSE invertiert bei FLO1
	out (floa4),a
;1 	elseif a=2
	JP .L67
.L68:
	CP 2
	JP NZ,.L69
	ld a,b
	pop bc
