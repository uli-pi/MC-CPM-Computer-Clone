form::		; Formatieren einer Spur.
	call wai
	ei
	call fmt
	di
	ld a,(user)
;1 	if a=0
	OR A
	JP NZ,.L70
	in a,(flo0) 	; pruefen auf Schreibschutz, Datalost
;1 	elseif a=1
	JP .L71
.L70:
	CP 1
	JP NZ,.L72
	in a,(floa0)
