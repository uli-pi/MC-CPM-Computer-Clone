	JP NZ,.L190
	ld hl,teinseitig
	call printŠ;2 	else  	; rueckseite
	JP .L191
.L190:
	ld a,(sideflag)
;3 	if a=0 	; ohne sso
	OR A
	JP NZ,.L192
	ld hl,trueckseite
;3 	else  	; sso
	JP .L193
.L192:
	ld hl,truecksso
;3 	endif
.L193:
	call print
;2 	endif
.L191:
;1 	endif
.L189:
	call crlf 
	call crlf
		; Kapazitaet ausrechnen
	ld hl,tkap
	call print
	ld a,(sektoren)
	ld l,a
	ld h,0
	ld a,(spuren)
	ld e,a
	ld d,0
	call mulhlde 	; sektoren*tracks
	ld a,(kopf)
;1 	if a=1
	CP 1
	JP NZ,.L194
	ld de,2
	call mulhlde 	; wenn zweiseitig, dann doppelt
;1 	endif
.L194:
	ld de,(anzbyte) 	; de=1024,512,256,128
		; de=400h,200h,100h,80h
;1 	if d=0
	LD A,d
	OR A
	JP NZ,.L195
;2 	do b,3 	; div 8
	LD b,3 
.L196:
	sra h
	rr l
;2 	enddo
	DEC B
	JP NZ,.L196
;1 	elseif d=1
	JP .L197
.L195:
	LD A,d
	CP 1
	JP NZ,.L198
	sra h  	; div 4
	rr l
	sra h
	rr l
;1 	elseif d=2
	JP .L197
.L198:
	LD A,d
	CP 2
	JP NZ,.L199
	sra h  	; div 2Š	rr l
;1 	elseif d=4
	JP .L197
.L199:
	LD A,d
	CP 4
	JP NZ,.L200
	nop  	; hl = KBytes
;1 	endif
.L200:
.L197:
	call printhl 	; ausgeben
	ld hl,tkap1
	call print
	call crlf
	ret

mulhlde:		; fuer Kapazitaetsbestimmung
		; hl*de -> hl
	ld a,16
	push de
	pop bc
	ld de,0
	ex de,hl
mullp:
	push af
	bit 0,e
;1 	if nz
	JP Z,.L201
	add hl,bc
;1 	endif
.L201:
	sra h
	rr l
	rr d
	rr e
	pop af
	dec a
	jr nz,mullp
	ex de,hl 	; nur lsb nach hl
	ret

crlf:
	ld hl,tcrlf
	call print
	ret
tkap:
	defb 'Speicherkapazitaet :  ',0
tkap1:
	defb ' KBytes',0
tmini:
	defb 'Mini-Laufwerk  ',0
tmaxi:
	defb 'Maxi-Laufwerk  ',0
