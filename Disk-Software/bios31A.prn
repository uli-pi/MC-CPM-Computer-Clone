                
                	MACLIB DISKDEF	; LOAD DEFINTION FOR DISKS
                
                ;*************************************************
                ; VERSION 3.1A   VERSION 80 SPUR-LAUFWERK        *
                ; GEBOOTET WIRD VOM 80 SPUR-LAUFWERK             *
                ; A,B SIND DIE BEIDEN 80 SPUR LAUFWERKE          *
                ; C,D IST EIN 8ZOLL LW, C=VORDERSEITE,D=RUECKS.  *
                ; E IST RAM-FLOPPY                               *
                ; (C) 1984 ROLF-DIETER KLEIN     841220          *
                ;                                                *
                ; 24.06.2026 *DG* KOMMENTARE HINZUGEFUEGT        *
                ;                 BINAER IDENTISCH ZUR ORIGIAL-  *
                ;                 VERSION                        *
                ;                                                *
                ; ************************************************
                		
                
 0016 =         VERS	EQU 22	; CP/M VERSION
 FFFF =         TRUE	EQU 0FFFFH
 0000 =         FALSE	EQU NOT TRUE
 FFFF =         TEST	EQU TRUE
 000D =         CR	EQU 0DH		; ZEILENR|CKLAUF
 000A =         LF	EQU 0AH		; ZEILENVORSCHUB
                
                
 003C =         MSIZE 	EQU 60		; SPEICHERGROESSE, HIER 60K
                
 A000 =         BIAS	EQU (MSIZE-20)*1024	; MIN=20K
 D400 =         CCP	EQU 3400H+BIAS	; START DES CCP
 DC06 =         BDOS	EQU CCP+806H	; DORT BEGINNT DAS BDOS
 EA00 =         BIOS	EQU CCP+1600H	; UND DORT DAS BIOS
                
 D400 =         CPMB	EQU CCP		; START CP/M-BOOT
                
 1600 =         CPML	EQU BIOS-CPMB	; LAENGE DES CP/MS
 002C =         NSECTS	EQU CPML/128	; ANZAHL DER BELEGTEN SEKTOREN
                
                
 EA00           	ORG BIOS	; START OF BIOS
                
                
 0004 =         CDISK	EQU 0004H	; ADDRESS FOR LAST USED DRIVE
 0080 =         BUFF	EQU 0080H	; BUFFER ADDRESS
 0005 =         RETRY	EQU 5		; FEHLERVERSUCHE BEI BOOT ETC.
                
                ;-----------------------------------------------------------------------------
                
                ; VEKTORTABELLE DER BIOS-EINSPRUENGE
                
 EA00 C3F1EA    	JMP BOOT	; KALT-START
                	
 EA03 C313EB    WBOOTE:	JMP WBOOT	; WARM-START, BEI CTRL-C
 EA06 C3E8EA    	JMP CONST	; CONSOL STATUS, ERGEBNIS IN A
 EA09 C3EBEA    	JMP CONIN	; CONSOL EINGABE, NACH A	
 EA0C C309F0    	JMP CONOUT	; CONSOL AUSGABE VON C
 EA0F C30FF0    	JMP LIST	; AUSGABE AUF DEN DRUCKER, VON C
 EA12 C30CF0    	JMP PUNCH	; AUSGABE AUF PO, C-REGISTER
 EA15 C306F0    	JMP READER	; EINGABE NACH RI, A-REGISTER
                
 EA18 C3B1EB    	JMP HOME	; LAUFWERK NUR TRACK 0
 EA1B C3B6EB    	JMP SELDSK	; SELECT DRIVE, RETURNS DISK PARAMETER HEADER BLOCK IN HL
 EA1E C3CCEB    	JMP SETTRK	; SPUR AUSWAEHLEN
 EA21 C3D1EB    	JMP SETSEC	; SEKTOR AUSWAEHLEN
 EA24 C3EDEB    	JMP SETDMA      ; ADRESSE FESTLEGEN                     
 EA27 C300EC    	JMP READ	; SEKTOR LESEN
 EA2A C376EC    	JMP WRITE	; SEKTOR SCHREIBEN
 EA2D C3AEEB    	JMP LISTST	; DRUCKER FERTIG ?
 EA30 C3D6EB    	JMP SECTRAN	; SECOR TRANSLATION (SKEW ONLY)
                
                ;-----------------------------------------------------------------------------
                
                	; SIZE OF DISKS A AND B
                	; TRUNC(5 LOGICAL SECTORS * 1024 LOGICAL SECTOR SIZE * (2*80 TRACKS - 4 OFFSET) / 2048 BLOCK SIZE) - 1 
                	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = CA. 780 K
 0185 =         SIZEAB	EQU 389
                 
                	; TRACK OFFSET FOR DISK A AND B
 0004 =         OFFSAB	EQU 4
                
                	DISKS 5		; 5 LAUFWERKE DEFINIERT	
 EA33+=         DPBASE	EQU	$	;BASE OF DISK PARAMETER BLOCKS
 EA33+00000000  DPE0:	DW	XLT0,0000H	;TRANSLATE TABLE
 EA37+00000000  	DW	0000H,0000H	;SCRATCH AREA
 EA3B+04EE83EA  	DW	DIRBUF,DPB0	;DIR BUFF,PARM BLOCK
 EA3F+B5EE84EE  	DW	CSV0,ALV0	;CHECK, ALLOC VECTORS
 EA43+00000000  DPE1:	DW	XLT1,0000H	;TRANSLATE TABLE
 EA47+00000000  	DW	0000H,0000H	;SCRATCH AREA
 EA4B+04EE83EA  	DW	DIRBUF,DPB1	;DIR BUFF,PARM BLOCK
 EA4F+26EFF5EE  	DW	CSV1,ALV1	;CHECK, ALLOC VECTORS
 EA53+A1EA0000  DPE2:	DW	XLT2,0000H	;TRANSLATE TABLE
 EA57+00000000  	DW	0000H,0000H	;SCRATCH AREA
 EA5B+04EE92EA  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
 EA5F+85EF66EF  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
 EA63+A1EA0000  DPE3:	DW	XLT3,0000H	;TRANSLATE TABLE
 EA67+00000000  	DW	0000H,0000H	;SCRATCH AREA
 EA6B+04EE92EA  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
 EA6F+B4EF95EF  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
 EA73+00000000  DPE4:	DW	XLT4,0000H	;TRANSLATE TABLE
 EA77+00000000  	DW	0000H,0000H	;SCRATCH AREA
 EA7B+04EEBBEA  	DW	DIRBUF,DPB4	;DIR BUFF,PARM BLOCK
 EA7F+DBEFC4EF  	DW	CSV4,ALV4	;CHECK, ALLOC VECTORS
                
                	; DISK A
                	DISKDEF 0,0,39,0,2048,SIZEAB,256,256,OFFSAB
 EA83+=         DPB0	EQU	$		;DISK PARM BLOCK
 EA83+2800      	DW	40		;SEC PER TRACK
 EA85+04        	DB	4		;BLOCK SHIFT
 EA86+0F        	DB	15		;BLOCK MASK
 EA87+00        	DB	0		;EXTNT MASK
 EA88+8401      	DW	388		;DISK SIZE-1
 EA8A+FF00      	DW	255		;DIRECTORY MAX
 EA8C+F0        	DB	240		;ALLOC0
 EA8D+00        	DB	0		;ALLOC1
 EA8E+4000      	DW	64		;CHECK SIZE
 EA90+0400      	DW	4		;OFFSET
 0000+=         XLT0	EQU	0		;NO XLATE TABLE
                
                			; *** DISKDEF BEDEUTUNG DER PARAMETER***
                			; 0 = NUMMER DES LAUFWERKS
                			; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
                			; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
                			; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
                			;     VERSETZEN ABSPEICHERN DER SEKTOREN
                			; 2048 = GROESSE EINES BLOCKS
                			; SIZEAB = ZAHL DER MAX. MOEGLICHEN BLOECKE
                			; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
                			; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
                			; OFFSAB = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
                
                	; DISK B (SAME AS DISK A)
                	DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
 EA83+=         DPB1	EQU	DPB0	;EQUIVALENT PARAMETERS
 0031+=         ALS1	EQU	ALS0	;SAME ALLOCATION VECTOR SIZE
 0040+=         CSS1	EQU	CSS0	;SAME CHECKSUM VECTOR SIZE
 0000+=         XLT1	EQU	XLT0	;SAME TRANSLATE TABLE
                
                	; DISK C
                	DISKDEF 2,1,26,6,1024,243,64,64,2 ; 8 ZOLL DEFINITION
 EA92+=         DPB2	EQU	$		;DISK PARM BLOCK
 EA92+1A00      	DW	26		;SEC PER TRACK
 EA94+03        	DB	3		;BLOCK SHIFT
 EA95+07        	DB	7		;BLOCK MASK
 EA96+00        	DB	0		;EXTNT MASK
 EA97+F200      	DW	242		;DISK SIZE-1
 EA99+3F00      	DW	63		;DIRECTORY MAX
 EA9B+C0        	DB	192		;ALLOC0
 EA9C+00        	DB	0		;ALLOC1
 EA9D+1000      	DW	16		;CHECK SIZE
 EA9F+0200      	DW	2		;OFFSET
 EAA1+=         XLT2	EQU	$		;TRANSLATE TABLE
 EAA1+01        	DB	1		
 EAA2+07        	DB	7		
 EAA3+0D        	DB	13		
 EAA4+13        	DB	19		
 EAA5+19        	DB	25		
 EAA6+05        	DB	5		
 EAA7+0B        	DB	11		
 EAA8+11        	DB	17		
 EAA9+17        	DB	23		
 EAAA+03        	DB	3		
 EAAB+09        	DB	9		
 EAAC+0F        	DB	15		
 EAAD+15        	DB	21		
 EAAE+02        	DB	2		
 EAAF+08        	DB	8		
 EAB0+0E        	DB	14		
 EAB1+14        	DB	20		
 EAB2+1A        	DB	26		
 EAB3+06        	DB	6		
 EAB4+0C        	DB	12		
 EAB5+12        	DB	18		
 EAB6+18        	DB	24		
 EAB7+04        	DB	4		
 EAB8+0A        	DB	10		
 EAB9+10        	DB	16		
 EABA+16        	DB	22		
                
                	; DISK D (SAME AS DISK C)
                	DISKDEF 3,2	; LAUFWERK 3 WIE LAUFWERK 2 DEFINIERT
 EA92+=         DPB3	EQU	DPB2	;EQUIVALENT PARAMETERS
 001F+=         ALS3	EQU	ALS2	;SAME ALLOCATION VECTOR SIZE
 0010+=         CSS3	EQU	CSS2	;SAME CHECKSUM VECTOR SIZE
 EAA1+=         XLT3	EQU	XLT2	;SAME TRANSLATE TABLE
                
                	DISKDEF 4,0,14,0,1024,180,64,64,0 ; RAM FLOPPY 60K,120K,180K
 EABB+=         DPB4	EQU	$		;DISK PARM BLOCK
 EABB+0F00      	DW	15		;SEC PER TRACK
 EABD+03        	DB	3		;BLOCK SHIFT
 EABE+07        	DB	7		;BLOCK MASK
 EABF+00        	DB	0		;EXTNT MASK
 EAC0+B300      	DW	179		;DISK SIZE-1
 EAC2+3F00      	DW	63		;DIRECTORY MAX
 EAC4+C0        	DB	192		;ALLOC0
 EAC5+00        	DB	0		;ALLOC1
 EAC6+1000      	DW	16		;CHECK SIZE
 EAC8+0000      	DW	0		;OFFSET
 0000+=         XLT4	EQU	0		;NO XLATE TABLE
                
                ; ENDEF AM SCHLUSS NICHT VERGESSEN
                
                ;-----------------------------------------------------------------------------
                ; CP/M MESSAGE AFTER COLD START
                
 EACA 1A        SIGNON:	DB 26
 EACB 0D0A57656C	DB CR,LF,'Welcome to 60 K CP/M 2.2'
 EAE5 0D0A00    	DB CR,LF,0
                
                ;-----------------------------------------------------------------------------
                ; MONITOR ROUTINES AND ADDRESSES
                
                			; DIESE ROUTINE LIEFERT DEN STATUS DER
 EAE8 C312F0    CONST:	JMP 0F012H	; EINGABETASTATUR. WURDE EIN ZEICHEN
                			; EINGEGEBEN, SO LIEFERT DIE ROUTINE 0FFH. 
                	
 EAEB CD03F0    CONIN:	CALL 0F003H    ; DIE ROUTINE HOLT EIN ZEICHEN VON DER
                                        ; TASTATUR AB UND SETZT DAS HOECHSTE BIT
                                        ; (PARITY BIT) AUF NULL
 EAEE E67F      	ANI 7FH
 EAF0 C9        	RET
                
 F01E =         MON80	EQU 0F01EH	; NEUSTART DES MONITORS
                
 F01E =         RMON80  EQU 0F01EH
                
 F009 =         CONOUT	EQU 0F009H     ; ROUTINE ZUR AUSGABE EINES ZEICHENS IM
                                        ; C-REGISTER AN DIE KONSOLE. DAZU SPRUNG 
                                        ; IN DEN MONITOR IM EPROM
                
 F00F =         LIST	EQU 0F00FH     ; ADRESSE FUER DEN SPRUNG IN DIE AUSGABEROUTINE,
                                        ; UM EIN ZEICHEN IM C-REGISTER AN DIE DRUCKER-
                                        ; SCHNITTSTELLE ZU LIEFERN
                
 F00C =         PUNCH	EQU 0F00CH     ; ADRESSE FUER DEN SPRUNG IN DIE AUSGABEROUTINE,
                                        ; UM EIN ZEICHEN IM C-REGISTER AN DIE STANZ-
                                        ; SCHNITTSTELLE ZU LIEFERN
                
 F006 =         READER	EQU 0F006H     ; ADRESSE FUER DEN SPRUNG IN DIE EINGABEROUTINE,
                                        ; UM EIN ZEICHEN VON LESER-KANAL ZU HOLEN,
                                        ; UND DAS ZEICHEN IM A-REGISTER ABZULIEFERN (RI)	
                
                ;-----------------------------------------------------------------------------
                ; COLD BOOT
                
 EAF1 310001    BOOT:	LXI SP,BUFF+80H	; OUTPUT START MESSAGE
 EAF4 21CAEA    	LXI H,SIGNON
 EAF7 CDF3EB    	CALL PRMSG
                	
 EAFA AF        	XRA A		; CLEAR LAST USED DRIVE
 EAFB 320400    	STA CDISK
                	
                	; SEKTORENBUFFER IST LEER
 EAFE AF        	XRA A		; KEIN SCHREIBVORGANG MEHR AKTUELL
 EAFF 32F3ED    	STA MWRTFLG	; DAHER AUF 0 SETZEN
 EB02 3EFF      	MVI A,0FFH	; LAUFWERK IST UNDEFINIERT
 EB04 32F4ED    	STA MDRVAKT	; NACH DEM BOOTEN
                
 EB07 2113EB    	LXI H,WBOOT	; DISABLE MONITOR ENTRY
 EB0A 2234F0    	SHLD 0F033H+1	; <- WBOOT
 EB0D 2237F0    	SHLD 0F036H+1	; <- WBOOT
 EB10 C36CEB    	JMP GOCPM	; START CP/M
                
                ;-----------------------------------------------------------------------------
                ; WARM BOOT
                
 EB13 3AF3ED    WBOOT:	LDA MWRTFLG	; WENN NOCH EIN ALTER TRACK ZUM
 EB16 B7        	ORA A		; SCHREIBEN DA, DANN ZURUECK DAMIT.
 EB17 CA1DEB    	JZ NOTBAC	; SONST WEITER.
                	
 EB1A CDC8ED    	CALL PUTTRK	; NORMALERWEISE IST SCHREIBVORGANG
                			; NACH EINEM DIREKTORYZUGRIFF ABGESCHLOSSEN
                			;
 EB1D 3EFF      NOTBAC:	MVI A,0FFH	; ALLE TRACKS UNGUELTIG, BEI DISKETTENWECHSEL WICHTIG
 EB1F 32F4ED    	STA MDRVAKT
                
 EB22 318000    	LXI SP,BUFF	; STACK ZUWEISEN
 EB25 0E05      	MVI C,RETRY	; ANZAHL DER VERSUCHE
 EB27 C5        	PUSH B		; UND DANN ANFANGEN ZU BOOTEN
 EB28 0100D4    WBOOT0:	LXI B,CPMB	; BOOT VON MINI-DISKETTE
 EB2B CDEDEB    	CALL SETDMA	; AUF DER STARTADRESSE DES CP/MS
 EB2E 0E00      	MVI C,0		; LAUFWERK A
 EB30 CDB6EB    	CALL SELDSK	; AUSWAEHLEN
 EB33 0E00      	MVI C,0		; TRACK 0
 EB35 CDCCEB    	CALL SETTRK	; UND DEN ZWEITEN PHYS. SEKTOR, (NR8 LOGISCH)
 EB38 0E08      	MVI C,8		; ENSTPRICHT NR 2 BEI 1024 BYTES
 EB3A CDD1EB    	CALL SETSEC	; WICHTIG, DA ANDERE ZAEHLWEISE
 EB3D C1        	POP B			; UND VON DA AN N SEKTOREN EINLESEN
 EB3E 062C      	MVI B,NSECTS	; ABER DAS BIOS NICHT UEBERSCHREIBEN
                				; DAMIT PATCHES LEICHT MOEGLICH SIND
 EB40 C5        RDSEC:	PUSH B		; ANZAHL MERKEN
 EB41 CD00EC    	CALL READ		; LESEN AUSFUEHREN
 EB44 C296EB    	JNZ BOOTERR	; FEHLER: DEFEKTER SEKTOR
 EB47 2AFDED    	LHLD IOD		; ZIELADRESSE LADEN
 EB4A 118000    	LXI D,128		; UM LOGISCHE SEKTORGROESSER ERHOEHEN
 EB4D 19        	DAD D			; DAZU ADDIEREN,
 EB4E 22FDED    	SHLD IOD		; UND DANN WIEDER ZURUECKSPEICHERN.
 EB51 3AFCED    	LDA IOS		; SEKTOR LADEN
 EB54 FE27      	CPI 39		; MINI 0..39 SEKTOREN A 128 BYTES
 EB56 DA63EB    	JC RD1		; SOLANGE AUF DER GLEICHEN SPUR BLEIBEN
 EB59 3AFBED    	LDA IOT		; DANN NEUE SPUR ANWAEHLEN,
 EB5C 3C        	INR A	  		; JEDOCH IM VERFAHREN 0,2,...
 EB5D 3C        	INR A			; SPUR 0, DANN SPUR 2, WEGEN BOOT.ASM
 EB5E 32FBED    	STA IOT		; DENN 1,3,5 IST DIE RUECKSEITE DES LAUFWERKS
 EB61 3EFF      	MVI A,0FFH		; 0,1,2,3.... NACH INCREMENT A=0
 EB63 3C        RD1:	INR A			; DANN 0
 EB64 32FCED    	STA IOS		; UND AUCH NEUESN SEKTOR ANWAEHLEN
 EB67 C1        	POP B			; SCHLEIFENZAEHLER ZURUECH
 EB68 05        	DCR B			; UND IMMER WEITER LESEN
 EB69 C240EB    	JNZ RDSEC		; DANACH CP/M NEU STARTEN
                	
                	;---------------------------------------------------------------------
                
 EB6C 018000    GOCPM:	LXI B,BUFF		; BUFFER AUF DEFAULT EINSTELLEN
 EB6F CDEDEB    	CALL SETDMA	; SO WIE ES CP/M BRAUCHT
 EB72 3EC3      	MVI A,JMP		; SPRUNG AUF DEN WARM-BOOT IM
 EB74 320000    	STA 0			; RAM ABLEGEN.
 EB77 2103EA    	LXI H,WBOOTE	; WARM-BOOT-ADRESSE
 EB7A 220100    	SHLD 1		; NICHT VERGESSEN
 EB7D 320500    	STA 5			; SPRUNG AUF DIE BDOS-CALL-ADRESSE
 EB80 2106DC    	LXI H,BDOS		; LEGEN UND AUCH DAS ZIEL
 EB83 220600    	SHLD 6		; DORTHIN
 EB86 323800    	STA 7*8		; RST7 DEFINIEREN, DEFAULT IST MONITOR
 EB89 211EF0    	LXI H,MON80	; DER ABER NORMALERWEISE KURZGESCHL. IST.
 EB8C 223900    	SHLD 7*8+1		
 EB8F 3A0400    	LDA CDISK		; DAS ZULETZT VERWENDETE LAUFWERK
 EB92 4F        	MOV C,A		; LADEN UND DAMIT SELEKTIEREN.
 EB93 C300D4    	JMP CPMB
                
                BOOTERR:		; IM FEHLERFALLE, BEI BAD-SEKTOR.
 EB96 C1        	POP B		; ERST MAL NOCHEINMAL VERSUCHEN
 EB97 0D        	DCR C		;
 EB98 CA9FEB    	JZ BOOTE0	; BIS HOFFNUNGSLOS, DANN FEHLERMELDUNG
                	
 EB9B C5        	PUSH B
 EB9C C328EB    	JMP WBOOT0	; TRY AGAIN
                
                BOOTE0:	; FEHLERMELDUNG AUSGEBEN UND MONITOR NEU STARTEN, BZW. WBOOT.
 EB9F 21A8EB    	LXI H,BOOTMSG
 EBA2 CDF3EB    	CALL PRMSG
 EBA5 C31EF0    	JMP MON80
                
                BOOTMSG:		; FEHLERMELDUNG
 EBA8 3F424F4F54	DB '?BOOT',0
                
                ;-----------------------------------------------------------------------------
                ; LIST STATUS (USED BY BDOS)
                ; LST-STATUS, DERZEIT KURZGESCHLOSSEN
                
                LISTST:			
 EBAE 00        	NOP
 EBAF AF        	XRA A		; GGF. HIER SPRUNG EINBAUEN.
 EBB0 C9        	RET
                
                ;-----------------------------------------------------------------------------
                ; HOME DRIVE (USED BY BDOS)
                
 EBB1 0E00      HOME:	MVI C,0		; ABER NUR ANWAEHLEN, NICHT
 EBB3 C3CCEB    	JMP SETTRK	; AUSFUEHREN
                
                ;-----------------------------------------------------------------------------
                ; SELECT DISK (USED BY BDOS)
                
 EBB6 210000    SELDSK:	LXI H,0		; UND PRUEFEN OB GUELTIG
 EBB9 79        	MOV A,C		; WENN GROESSER ALS NDISKS
 EBBA FE05      	CPI NDISKS		; DANN NICHT OK
 EBBC D0        	RNC			; NUMMER 0 BIS N-1 ERSCHEINT IN A
 EBBD 32F8ED    	STA DBANK		; DANN ZUSAETZLICH DIE
 EBC0 69        	MOV L,C		; LAUFWERKSTABELLE AUSRECHNEN
 EBC1 2600      	MVI H,0		; DAZU NUMMER MIT 16 MULTIPLIZIEREN
 EBC3 29        	DAD H	
 EBC4 29        	DAD H	
 EBC5 29        	DAD H	
 EBC6 29        	DAD H	
 EBC7 1133EA    	LXI D,DPBASE	; UND BASISADRESSE DRAUF ADDIEREN.
 EBCA 19        	DAD D
 EBCB C9        	RET
                
                ;-----------------------------------------------------------------------------
                ; SPUR MERKEN (USED BY BDOS)
                
 EBCC 21FBED    SETTRK:	LXI H,IOT		; DAZU IM SPEICHERZELLE LADEN
 EBCF 71        	MOV M,C
 EBD0 C9        	RET
                
                ;-----------------------------------------------------------------------------
                ; SECTOR MERKEN (USED BY BDOS)
                
 EBD1 21FCED    SETSEC:	LXI H,IOS		; DAZU IN SPEICHERZELLE LADEN
 EBD4 71        	MOV M,C
 EBD5 C9        	RET
                
                ;-----------------------------------------------------------------------------
                ; SECTOR TRANSLATION (USED BY BDOS)
                ; SECTOR IN C
                ; SKEW TABLE ADDRESS IN DE (OR 0)
                
 EBD6 7A        SECTRAN:MOV A,D		; WENN EIN SKEW-FAKTOR VERWENDET WIRD,
 EBD7 B3                ORA E		; WIE Z.B. BEI 8 ZOLL UEBLICH.
 EBD8 CAE5EB            JZ SECTR1	; =0, -> NO SKEW
                
 EBDB 0600      	MVI B,0		; SONST IN DE ADRESSE DER SKEW-TABELLE
 EBDD EB        	XCHG		; SKEW TABLE -> HL
 EBDE 09        	DAD B		; ADD BC
 EBDF 7E        	MOV A,M		; LOAD SKEW VALUE
 EBE0 32FCED    	STA IOS		; SAVE IN IOS 
 EBE3 6F        	MOV L,A		; AND IN L
 EBE4 C9        	RET
                
                SECTR1:	; NO SKEW
 EBE5 69        	MOV L,C		; SONST NUR EINFACHE WERT
 EBE6 79                MOV A,C		; UEBERNEHMEN, OHNE UMRECHNUNG.
 EBE7 32FCED            STA IOS		; AUCH MERKEN
 EBEA 2600              MVI H,0		; SE 0..255 MAX
 EBEC C9                RET
                
                ;-----------------------------------------------------------------------------
                ; ADRESSE FUER FLOPPY-ZUGRIFF FESTLEGEN
                
 EBED 69        SETDMA:	MOV L,C
 EBEE 60        	MOV H,B
 EBEF 22FDED    	SHLD IOD
 EBF2 C9        	RET
                
                ;-----------------------------------------------------------------------------
                ; 0-TERMINERTE TEXT AUSGABEN, ADRESSE IN HL
                
 EBF3 7E        PRMSG: 	MOV A,M
 EBF4 B7        	ORA A
 EBF5 C8        	RZ		; -> END OF TEXT
                	
 EBF6 E5        	PUSH H
 EBF7 4F        	MOV C,A
 EBF8 CD09F0    	CALL CONOUT
 EBFB E1        	POP H
 EBFC 23        	INX H
 EBFD C3F3EB    	JMP PRMSG	; -> NEXT CHAR
                
                ;=============================================================================
                ; READ AND WRITE SECTOR USING EXEC INTO MONITOR
                
                ; HL=DMA ADR
                ; DE=TRACK/SECTOR
                ; B=0 RSTORE
                ;   1 READ
                ;   2 WRITE
                ; C=DRIVE 0...3		; BEI MEXEC, EXEC
                ; BEI FEXEC IST C BEI BESTIMMT.
                
 EC00 3AF8ED    READ:	LDA DBANK	; DAZU LAUFWERK BESTIMMEN
 EC03 FE02      	CPI 2		; 
 EC05 DADBEC    	JC MINIRD	; DRIVE 0,1 -> MINI DISKS
                	
 EC08 FE04      	CPI 4		
 EC0A DA56EC    	JC MAXIREAD	; DRIVE 2,3 -> MAXI DISKS
                
                	; --- RAM DISK ---
                
 EC0D CD22EC    	CALL ADRERZ	; HL=QUELLADRESSE
 EC10 EB                XCHG		; ADRESSUMRECHNUNG DURCHFUEHREN
 EC11 2AFDED            LHLD IOD	; ZIELADRESSE LADEN
 EC14 EB                XCHG		; UND DE=ZIEL, HL=QUELLE, C=BANK QUELLE
 EC15 0600              MVI B,0		; ZIEL IST BANK 0
 EC17 CDF0ED            CALL REXEC	; UND 128 BYTES KOPIEREN, CARRY=FEHLER
 EC1A D220EC    	JNC NORERR
                	
 EC1D 3E01      	MVI A,1		; FEHLER DA, BANK NICHT VORHANDEN,
 EC1F C9        	RET		; WIRKT WIE BAD-SEKTOR
                	
 EC20 AF        NORERR:	XRA A		; SONST OK.
 EC21 C9        	RET
                
                	;---------------------------------------------------------------------
                	; CALCULATE ADDRESS FOR RAM DISK, SOURCE IN HL
                	; SEKTOR 0..E,  TRACK 0..5FH
                	; SSSSTTTT T0000000   , ADRESSE FUER RAM-FLOPPY
 EC22 3AFBED    ADRERZ:	LDA IOT		; TRACK HOLEN
 EC25 0F         	RRC 			; UND UMRECHNEN
 EC26 E60F       	ANI 0FH		; UNTERER TEIL VOM MSB
 EC28 67         	MOV H,A
 EC29 3AFCED     	LDA IOS		; DANN SEKTOR DAZU
 EC2C 07         	RLC
 EC2D 07         	RLC
 EC2E 07         	RLC
 EC2F 07         	RLC
 EC30 E6F0       	ANI 0F0H
 EC32 B4         	ORA H
 EC33 67         	MOV H,A		; DAMIT SSSSTTTT OK
 EC34 3AFBED     	LDA IOT
 EC37 0F         	RRC			; TXXXXXXX
 EC38 E680       	ANI 80H
 EC3A 6F         	MOV L,A		; T0000000
 EC3B 3AFBED     	LDA IOT		; NUN NOCH BANK BESTIMMEN, IN C UND B	
 EC3E 07         	RLC			; UND DAZU MSB-TEIL DES TRACKS VERWENDEN
 EC3F 07         	RLC			; 0MMTTTTT
 EC40 07         	RLC			; BANKNUMMER
 EC41 E603       	ANI 03H		; 000000MM
 EC43 C601      	ADI 1			; ERST AB BANK 1 STARTEN
 EC45 47         	MOV B,A		; DA BANK 0=CP/M RAM UND TPA
 EC46 4F         	MOV C,A		; OK BEIDE DEFINIERT
 EC47 C9         	RET
                
                	;---------------------------------------------------------------------
                  
                	; UMRECHNEN FUER 8ZOLL
                	; UND NEUEN FLOPPY-EINSPRUNG VERWENDEN.
                	; NACH C LADEN
                	; LW=2, DANN VORDERSEITE LW 3
                	; LW=3, DANN RUECKSEITE LW 3
                NEUBANK:
 EC48 3AF8ED    	LDA DBANK
 EC4B FE02      	CPI 2
 EC4D C253EC    	JNZ NEU1
                	
 EC50 0E14      	MVI C,00010100B	; SD,8 ZOLL, LW=3
 EC52 C9        	RET
 EC53 0E94      NEU1:	MVI C,10010100B
 EC55 C9        	RET
                
                	;---------------------------------------------------------------------
                	; READ MAXI DISK
                
                MAXIREAD:
 EC56 0605      SK1:	MVI B,RETRY	; ANZAHL DER LESEVERSUCHE
 EC58 C5        LP:	PUSH B		; DANN AUSFUEHREN
 EC59 2AFDED    	LHLD IOD		; ZIELADRESSE HOLEN
 EC5C 3AFBED    	LDA IOT		; SPURNUMMER
 EC5F 57        	MOV D,A	
 EC60 3AFCED    	LDA IOS		; SEKTORNUMMER
 EC63 5F        	MOV E,A
 EC64 0601      	MVI B,1		; LESE-BEFEHLSCODE
 EC66 CD48EC    	CALL NEUBANK	; VORHER LAUFWERKSCODE UMRECHNEN
 EC69 CDE7ED    	CALL FEXEC		; UND DANN AUSFUEHREN
 EC6C C1        	POP B			; RETRY-ZAEHLER
 EC6D C8        	RZ			; KEIN FEHLER, DANN OK ZURUECK
 EC6E 05        	DCR B			; SONST NOCHMALS PROBIEREN
 EC6F C258EC    	JNZ LP		
 EC72 3E01      	MVI A,1		; BAD SEKTOR
 EC74 B7        	ORA A
 EC75 C9        	RET
                
                ;-----------------------------------------------------------------------------
                ; WRITE SECTOR USING EXEC INTO MONITOR
                
                ; HL=DMA ADR
                ; DE=TRACK/SECTOR
                ; B=0 RSTORE
                ;   1 READ
                ;   2 WRITE
                ; C=DRIVE 0...3		; BEI MEXEC, EXEC
                ; BEI FEXEC IST C BEI BESTIMMT.
                
 EC76 3AF8ED    WRITE:	LDA DBANK	; DAZU LAUFWERKSCODE LADEN
 EC79 FE02      	CPI 2		; UND FLOPPY-TYP BESTIMMEN
 EC7B DA34ED    	JC MINIWR	; DRIVE 0,1 -> MINI DISKS
                	
 EC7E FE04      	CPI 4		; DRIVE 2,3 -> MAXI DISKS
 EC80 DA95EC    	JC MAXIWR
                	
                	; --- RAM DISK ---
                
 EC83 CD22EC    	CALL ADRERZ	; HL=QUELLADRESSE
 EC86 EB                XCHG		; UMRECHNEN
 EC87 2AFDED            LHLD IOD	; ZIEL IN BANK HL=QUELLE DIESMAL
 EC8A 0E00              MVI C,0		; QUELLE IST BANK 0, B=ZIEL, DE=ZIEL
 EC8C CDF0ED            CALL REXEC	; UND 128 BYTES KOPIEREN, CARRY=FEHLER
 EC8F D220EC    	JNC NORERR		; OK BANK WAR DA, SONST
 EC92 3E01      	MVI A,1		; FEHLER AUSGEBEN
 EC94 C9        	RET
                
                	;---------------------------------------------------------------------
                	; WRITE MAXI DISK
                
 EC95 0605      MAXIWR:	MVI B,RETRY
 EC97 C5        LPP:	PUSH B		; DAZU FEHLERZAEHLER RETTEN
 EC98 2AFDED    	LHLD IOD		; QUELLEADRESSE LADEN
 EC9B 3AFBED    	LDA IOT		; SPUR
 EC9E 57        	MOV D,A
 EC9F 3AFCED    	LDA IOS		; SEKTOR
 ECA2 5F        	MOV E,A
 ECA3 0602      	MVI B,2		; SCHREIB-BEFEHLSCODE
 ECA5 CD48EC    	CALL NEUBANK	; VORHER LAUFWERK UMRECHNEN
 ECA8 CDE7ED    	CALL FEXEC		; UND AUSFUEHREN
 ECAB C1        	POP B	
 ECAC C8        	RZ			; KEIN FEHLER, DANN ZURUECK
 ECAD 05        	DCR B			; SONST ERNEUT VERSUCHEN
 ECAE C297EC    	JNZ LPP
 ECB1 3E01      	MVI A,1		; BAD SEKTOR
 ECB3 B7        	ORA A
 ECB4 C9        	RET
                
                ;=============================================================================
                ; READ MINI DISK, 80 SPUR, DD, DS
                
                ;READ UND WRITE UNTER VERWENDUNG VON MEXEC
                ; HL=DMA ADR
                ; DE=TRACK/SECTOR
                ; B=0 RSTORE
                ;   1 READ
                ;   2 WRITE
                ; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
                ;                                          A   C    B    D
                ; 1K BUFFER IN MONITORGEBIET
                ; WIRD DADURCH TEILWEISE UEBERSCHRIEBEN
                ; BEI WARMBOOT MUSS BUFFER GELEERT WERDEN
                ; DEBLOCK WIRD AUS SICHERHEITSGRUENDEN NICHT VERWENDET
                
 FC00 =         BLKBUF	EQU 0FC00H	; MEMORY AREA OF INTERACTIVE MONITOR FOR LOGICAL SEXTOR (1K)
                
                ;-----------------------------------------------------------------------------
                ; CALCULATES PHYSICAL DRIVE FROM DBANK AND IOT -> C
                ; DBANK, IOT     C
                ;  0     F    -> 0
                ;  1     F    -> 2
                ;  0     B    -> 1
                ;  1     B    -> 3
                
                ; CALCULATES PHYSICAL SECTOR FROM LOGICAL SECTOR, IOS -> E
                ; LOGICAL SECTOR 0..39 -> PHYSICAL SECTOR 1..5
                
                ; CALCULATES LOGICAL TRACK FROM PHYSICAL TRACK, IOT -> D
                ; 0..159 -> 0..79 (MAX 127)
                
                ; ONLY FOR MINI DISKS 0 AND 1
                
                CALC:	; LOGICAL SECTOR (1K) TO PHYSICAL SECTOR (128 BYTE)
                	; 0..39 -> 0..4
 ECB5 3AFCED    	LDA IOS		; 0..39 IST DER BEREICH (LOGIC SECTOR)
 ECB8 0F        	RRC		; X000NNNN 0..15
 ECB9 0F                RRC
 ECBA 0F                RRC
 ECBB E607      	ANI 00000111B
 ECBD 3C        	INR A		; 0..4 -> 1..5
 ECBE 5F        	MOV E,A		; SAVE IN E
                
 ECBF 3AF8ED    	LDA DBANK       ; DRIVE 0->0  1->2
                			; NUR 0,1 SUI 4 ; UND TRACK UMRECHNEN , LAUFWERK 0,1
 ECC2 FE01      	CPI 1		; 0,2,4,6,8 IST VORDERSEITE 1,3,5... RUECKSEITE
 ECC4 C2C9EC    	JNZ CAL2
                
                	; DBANK=1 
 ECC7 3E02      	MVI A,2
                	
 ECC9 4F        CAL2:	MOV C,A		; PHYSICAL DRIVE
                
 ECCA 3AFBED    	LDA IOT
 ECCD 0F        	RRC		; TRACK / 2,  = PHYS TRACK, CARRY=BACKSIDE
 ECCE 57        	MOV D,A		; TRACK MERKEN
 ECCF D2D6EC    	JNC CAL3	; FRONTSIDE
                
                	; BACKSIDE, TRACK=0
 ECD2 79        	MOV A,C
 ECD3 F601      	ORI 1		; DRIVE 0 -> DRIVE 1,  DRIVE 2 -> DRIVE 3
 ECD5 4F        	MOV C,A
                	
 ECD6 7A        CAL3:	MOV A,D
 ECD7 E67F      	ANI 7FH		; BEREICH TRACK 0..79 REAL
 ECD9 57        	MOV D,A
                
                	; D=TRACK=D, E=SECTOR, C=DRIVE
 ECDA C9        	RET
                	
                ;-----------------------------------------------------------------------------
                ; READ MINI DISK
                ; DBANK, IOT, IOS,
                
 ECDB CDB5EC    MINIRD:	CALL CALC	; CALCULATE PHYSICAL DRIVE DATA
                
 ECDE 3AF4ED    	LDA MDRVAKT
 ECE1 B9        	CMP C		; COMPARE DRIVE
 ECE2 C20FED    	JNZ RLOAD	; -> DRIVE NOT EQUAL, LOAD
                	
 ECE5 3AF5ED    	LDA MTRKAKT
 ECE8 BA        	CMP D		; COMPARE TRACK
 ECE9 C20FED    	JNZ RLOAD	; -> TRACK NOT EQUAL, LOAD
                	
 ECEC 3AF6ED    	LDA MSEKAKT
 ECEF BB        	CMP E		; COMPARE SECTOR
 ECF0 C20FED    	JNZ RLOAD	; -> SECTOR NOT EQUAL, LADEN
                
                R1RD:	; OK IST SCHON IN BUFFER
 ECF3 2100FC    	LXI H,BLKBUF	; ADRESSE BERECHNEN
 ECF6 3AFCED    	LDA IOS		; 0..39   * 128 + BUFFER
 ECF9 E607      	ANI 00000111B	; 0,1,2,3,4,5,6,7
 ECFB 57        	MOV D,A
 ECFC 1E00      	MVI E,0		; SCHIEBEN MIT Z80 BEFS
 ECFE CB2A      	DB 0CBH,2AH	; SRA D
 ED00 CB1B      	DB 0CBH,1BH	; RR E   = *256/2
 ED02 19        	DAD D			; +BUFFER
 ED03 EB        	XCHG			; NACH DE IST ZIEL
 ED04 2AFDED    	LHLD IOD		; DMA ADRESSE QUELLE HIER
 ED07 EB        	XCHG			; ZIEL DE
 ED08 018000    	LXI B,128		; LAENGE
 ED0B EDB0      	DB 0EDH,0B0H	; LDIR
 ED0D AF        	XRA A
 ED0E C9        	RET			; OK ENDE
                
                RLOAD:			; NEUEN LADEN, GGF ALTEN ZURUECKSCHREIBEN
 ED0F 3AF3ED    	LDA MWRTFLG
 ED12 B7        	ORA A
 ED13 CA1CED    	JZ R1LOAD
 ED16 CDC8ED    	CALL PUTTRK	; ALTEN ZURUECKSCHREIBEN
 ED19 DAA3ED    	JC ERRIO
 ED1C CDB5EC    R1LOAD:	CALL CALC	; BERECHNEN
 ED1F 79        	MOV A,C
 ED20 32F4ED    	STA MDRVAKT
 ED23 7B        	MOV A,E
 ED24 32F6ED    	STA MSEKAKT
 ED27 7A        	MOV A,D
 ED28 32F5ED    	STA MTRKAKT
 ED2B CDA7ED    	CALL GETTRK		; NEUEN SEKTOR LESEN
 ED2E DAA3ED    	JC ERRIO		; FEHLER AUFGETRETEN
                	
 ED31 C3F3EC    	JMP R1RD		; ENDE
                
                ;-----------------------------------------------------------------------------
                ; WRITE MINI DISK 
                
 ED34 79        MINIWR:	MOV A,C
 ED35 32F7ED    	STA ALLOC		; INFORMATION 1=DIREKTORY WRITE
 ED38 CDB5EC    	CALL CALC		; FUER VERGLEICH, BERECHUNG AUSFUEHREN
 ED3B 3AF4ED    	LDA MDRVAKT		; UND WIE BEI MINIRD
 ED3E B9        	CMP C			;
 ED3F C27EED    	JNZ WLOAD
                	
 ED42 3AF5ED    	LDA MTRKAKT
 ED45 BA        	CMP D
 ED46 C27EED    	JNZ WLOAD
 ED49 3AF6ED    	LDA MSEKAKT
 ED4C BB        	CMP E
 ED4D C27EED    	JNZ WLOAD		
                	
                W1WR:	; LADEN UNNOETIG, SEKTOR SCHON IM BUFFER
 ED50 2100FC    	LXI H,BLKBUF		; ADRESSE BERECHNEN
 ED53 3AFCED    	LDA IOS			; 0..39   * 128 + BUFFER
 ED56 E607      	ANI 00000111B		; 0,1,2,3,4,5,6,7
 ED58 57        	MOV D,A
 ED59 1E00      	MVI E,0			; SCHIEBEN MIT Z80 BEFS
 ED5B CB2A      	DB 0CBH,2AH		; SRA D
 ED5D CB1B      	DB 0CBH,1BH		; RR E   = *256/2
 ED5F 19        	DAD D			; +BUFFER
 ED60 EB        	XCHG			; NACH DE IST ZIEL
 ED61 2AFDED    	LHLD IOD		; DMA ADRESSE QUELLE HIER
 ED64 018000    	LXI B,128		; LAENGE ZIEL DE
 ED67 EDB0      	DB 0EDH,0B0H		; LDIR
 ED69 3E01      	MVI A,1
 ED6B 32F3ED    	STA MWRTFLG		; NUN BESCHRIEBEN
 ED6E 3AF7ED    	LDA ALLOC		; =1 DANN ZURUECK
 ED71 FE01        	CPI 1			; WENN DIREKTORY ZUGRIFF, DANN
 ED73 C27CED    	JNZ W2WR		; GLEICH ZURUECKSCHREIBEN.
 ED76 CDC8ED    	CALL PUTTRK 
 ED79 DAA3ED    	JC ERRIO		; FALLS FEHLER, DANN BAD SEKTOR
                
 ED7C AF        W2WR:	XRA A			; KEIN FEHLER
 ED7D C9        	RET			; OK ENDE
                
                WLOAD:			; NEUEN LADEN, GGF ALTEN ZURUECKSCHREIBEN
 ED7E 3AF3ED    	LDA MWRTFLG	; 
 ED81 B7        	ORA A
 ED82 CA8BED    	JZ W1LOAD
 ED85 CDC8ED    	CALL PUTTRK	; ALTEN ZURUECKSCHREIBEN
 ED88 DAA3ED    	JC ERRIO
 ED8B CDB5EC    W1LOAD:	CALL CALC	; BERECHNEN
 ED8E 79        	MOV A,C
 ED8F 32F4ED    	STA MDRVAKT
 ED92 7B        	MOV A,E
 ED93 32F6ED    	STA MSEKAKT
 ED96 7A        	MOV A,D
 ED97 32F5ED    	STA MTRKAKT
 ED9A CDA7ED    	CALL GETTRK
 ED9D DAA3ED    	JC ERRIO
 EDA0 C350ED    	JMP W1WR
                
 EDA3 3E01      ERRIO:	MVI A,1	; FEHLER AUFGETRETEN
 EDA5 B7        	ORA A
 EDA6 C9        	RET
                
                ;-----------------------------------------------------------------------------
                ; BUFFERVERWALTUNG
                
                ; TRKAKT,SEKAKT,DRVAKT ENTHALTEN NEUE BUFFERADRESSE
                
 EDA7 AF        GETTRK:	XRA A
 EDA8 32F3ED    	STA MWRTFLG	; SEKTOR EINLESEN
                	
 EDAB 2100FC    	LXI H,BLKBUF
 EDAE 3AF6ED    	LDA MSEKAKT
 EDB1 5F        	MOV E,A
 EDB2 3AF4ED    	LDA MDRVAKT
 EDB5 F6D0      	ORI 11010000B	;LAUFWERK PHYS 0,1,2,3 DOUBLE DENSE
 EDB7 4F        	MOV C,A
 EDB8 0601      	MVI B,1		;READ, 1K DIREKT
 EDBA 3AF5ED    	LDA MTRKAKT
 EDBD 57        	MOV D,A
 EDBE CDEDED    	CALL MEXEC
 EDC1 DAC6ED    	JC ERRX
                
 EDC4 AF        	XRA A
 EDC5 C9        	RET
                
 EDC6 37        ERRX:	STC
 EDC7 C9        	RET
                
                ;-----------------------------------------------------------------------------
                ;TRKAKT,SEKAKT,DRVAKT ENTHALTEN NEUE BUFFERADRESSE
                
 EDC8 AF        PUTTRK:	XRA A			;WIRD ZURUECKGESCHRIEBEN
 EDC9 32F3ED    	STA MWRTFLG
                	
 EDCC 2100FC    	LXI H,BLKBUF
 EDCF 3AF6ED    	LDA MSEKAKT
 EDD2 5F        	MOV E,A
 EDD3 3AF4ED    	LDA MDRVAKT
 EDD6 F6D0      	ORI 11010000B	;LAUFWERK PHYS 0,1,2,3 DOUBLE DENSE
 EDD8 4F        	MOV C,A
 EDD9 0602      	MVI B,2		;WRITE	1K SEKTOR
 EDDB 3AF5ED    	LDA MTRKAKT
 EDDE 57        	MOV D,A
 EDDF CDEDED    	CALL MEXEC
 EDE2 DAC6ED    	JC ERRX
 EDE5 AF        	XRA A
 EDE6 C9        	RET
                
 EDE7 C321F0    FEXEC:	JMP 0F021H	;FLOMON NEUER VEKTOR
 EDEA C324F0    EXEC:	JMP 0F024H	;FLOMON UND MC (NOT USED)
 EDED C327F0    MEXEC:	JMP 0F027H	;FLOMON UND MC
 EDF0 C35BF0    REXEC:	JMP 0F05BH	;FLOMON RAM-FLOPPY
                
                ;-----------------------------------------------------------------------------
                
                ; RAM ZELLEN
                
 EDF3 00        MWRTFLG:	DB 0		;<>0 IST WRITEN
 EDF4 00        MDRVAKT:	DB 0		;DRIVE DAS GELADEN IST
 EDF5 00        MTRKAKT:	DB 0		;TRACK 
 EDF6 00        MSEKAKT:	DB 0		;SEKTOR
 EDF7 00        ALLOC:		DB 0		; MERKER, 1=DIREKTORY WRITE
                
                                        ; SPEICHERZELLEN FUER DAS PROGRAMM
                
 EDF8 00        DBANK:   DB 0           ; NUMMER DES SELEKTIEREN LAUFWERKS
 EDF9 80        IOPB:    DB 80H         ; IO-BYTE (NOT USED)
 EDFA 01        ION:     DB 1           ; SEKTORNUMMER (NOT USED)
 EDFB 04        IOT:     DB OFFSAB      ; NUMMER DER GEWUENSCHTEN SPUR (START VALUE IS FIRST USABLE TRACK)
 EDFC 01        IOS:     DB 1           ; NUMMER DES GEWUENSCHTEN SEKTORS
 EDFD 8000      IOD:     DW BUFF        ; DMA-ADRESSE
 EDFF 01        ALTDRV:  DB 1           ; SYSTEM-SPEICHERSTELLEN (NOT USED)
 EE00 0000      INDADR:  DW 0		; NOT USED
 EE02 0000      INDADR2: DW 0		; NOT USED
                
                          ENDEF		; END MACRO
 EE04+=         BEGDAT	EQU	$
 EE04+          DIRBUF:	DS	128	;DIRECTORY ACCESS BUFFER
 EE84+          ALV0:	DS	49
 EEB5+          CSV0:	DS	64
 EEF5+          ALV1:	DS	49
 EF26+          CSV1:	DS	64
 EF66+          ALV2:	DS	31
 EF85+          CSV2:	DS	16
 EF95+          ALV3:	DS	31
 EFB4+          CSV3:	DS	16
 EFC4+          ALV4:	DS	23
 EFDB+          CSV4:	DS	16
 EFEB+=         ENDDAT	EQU	$
 01E7+=         DATSIZ	EQU	$-BEGDAT
                
 EFEB                     END
