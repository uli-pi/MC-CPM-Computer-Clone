;3 	REPEAT
.L146:
	CALL CONIN
;3 	UNTIL A IN ['1'..'4']
	CP '4'+1
	JP NC,.L146
	CP '1'+0
	JP C,.L146
.L147:
;3 	IF A='1'
	CP '1'
	JP NZ,.L148
	LD HL,256
	LD (BYTCNT),HL
	LD A,16
	LD (SECCNT),A
	LD A,54
	LD (GAPLEN),A
;3 	ELSEIF A='2'
	JP .L149
.L148:
	CP '2'
	JP NZ,.L150
	LD HL,512
	LD (BYTCNT),HL
	LD A,9
	LD (SECCNT),A
	LD A,54
	LD (GAPLEN),A
;3 	ELSEIF A='3'
	JP .L149
.L150:
	CP '3'
	JP NZ,.L151
	LD HL,512
	LD (BYTCNT),HL
	LD A,10
	LD (SECCNT),A
	LD A,40
	LD (GAPLEN),A
;3 	ELSEIF A='4'
	JP .L149
.L151:
	CP '4'
	JP NZ,.L152
	LD HL,1024
	LD (BYTCNT),HL
	LD A,5
	LD (SECCNT),A
	LD A,54
	LD (GAPLEN),A
;3 	ENDIF
.L152:
.L149:
;2 	ENDIF
.L145:
;1 	ELSE  	; MAXI
	JP .L153
.L137:
	LD A,(DENSITY)
;2 	IF A=0 	; SD
	OR A
	JP NZ,.L154
	LD HL,MENUE5C
	CALL PRNMSG
;3 	REPEAT
.L155:
	CALL CONIN
;3 	UNTIL A IN ['1'..'2']
	CP '2'+1
	JP NC,.L155
	CP '1'+0
	JP C,.L155
.L156:
;3 	IF A='1'
	CP '1'
	JP NZ,.L157
	LD HL,128
	LD (BYTCNT),HL
	LD A,26
