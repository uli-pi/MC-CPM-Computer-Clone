;-----------------------------------------------------------------------------
; Print 0-terminated message, address in HL
	
PRNMSG:	LD A,(HL)

PRNTM1:	OR A
	JP Z,PRNTM2
	
	LD C,A
	CALL CONOUT
	INC HL
	LD A,(HL)
	JP PRNTM1

PRNTM2:	RET

;-----------------------------------------------------------------------------
; Print floppy parameters

PRNPRM:	LD C,1AH	; clear screen
	CALL CONOUT

	LD A,(MINMAX)
;1 	IF A=0  	; 0=Mini
	OR A
	JP NZ,.L171
	LD HL,TMINI
;1 	ELSE
	JP .L172
.L171:
	LD HL,TMAXI
;1 	ENDIF
.L172:
	CALL PRNMSG
	LD A,(USER)
;1 	IF A=0  	; FLO 2
	OR A
	JP NZ,.L173
	
	; V1.22
	LD A,(FLOTYP)
	OR A
	JP NZ,L0BD4
	LD HL,TFLO2
	JP L0BD7
	
L0BD4:	
	LD HL,TFLO1C
L0BD7:
;1 	ELSEIF A=1
	JP .L174
.L173:
	CP 1
	JP NZ,.L175
	LD HL,TFLO1A
;1 	ELSE A=2
	JP .L176
.L175:
	LD HL,TFLO1B
;1 	ENDIF
.L176:
.L174:
	CALL PRNMSG
	LD A,(DENSITY)
;1 	IF A=0  	; 0=SD
	OR A
	JP NZ,.L177
	LD HL,TFM
;1 	ELSE
	JP .L178
.L177:
	LD HL,TMFM
;1 	ENDIF
.L178:
	LD A,(ECMA)
;1 	IF A=1
	CP 1
	JP NZ,.L179
	LD HL,TECMA 	; Sonderfall, Ecma-Format
;1 	ENDIF
.L179:
	CALL PRNMSG
	CALL CRLF
	CALL CRLF
	LD HL,TSPUREN
	CALL PRNMSG
	LD A,(TRKCNT)
	LD L,A
	LD H,0
	CALL PRNTHL 	; Anzahl Spuren
	CALL CRLF
	LD HL,TSEKTOREN
	CALL PRNMSG
	LD A,(SECCNT)
	LD L,A
	LD H,0
	CALL PRNTHL 	; Anzahl SECCNT
	CALL CRLF
	LD HL,TBYTES
	CALL PRNMSG
	LD HL,(BYTCNT)
	CALL PRNTHL 	; Bytes pro Sektor
	CALL CRLF
		;
	LD HL,TLAUFWERK
	CALL PRNMSG
	LD A,(DRIVE)
	AND 0FH 	; 1,2,4,8
;1 	IF A=1
	CP 1
	JP NZ,.L180
	LD C,'A'
;1 	ELSEIF A=2
	JP .L181
.L180:
	CP 2
	JP NZ,.L182
	LD C,'B'
;1 	ELSEIF A=4
	JP .L181
.L182:
	CP 4
	JP NZ,.L183
	LD C,'C'
;1 	ELSEIF A=8
	JP .L181
.L183:
	CP 8
	JP NZ,.L184
	LD C,'D'
;1 	ELSE
	JP .L185
.L184:
	LD C,'?'
;1 	ENDIF
.L185:
.L181:
	CALL CONOUT
	CALL CRLF
	CALL CRLF
		; 
	LD A,(SSDS)
;1 	IF A=1  	; zweiseitig
	CP 1  
	JP NZ,.L186	; -> single-sided
	
	; double-sided
	LD A,(USESSO)
;2 	IF A=0 	; OHNE SSO
	OR A
	JP NZ,.L187	; -> SSO
	
	; no SSO
	LD HL,TZWEISEITIg
;2 	ELSE  	; MIT SSO
	JP .L188
.L187:
	LD HL,TZWEISSO
;2 	ENDIF
.L188:
	CALL PRNMSG
;1 	ELSE  	; EINSEItig
	JP .L189
.L186:
	LD A,(DRIVE) 
	AND 80H
;2 	IF Z  	; VORDERseite
	JP NZ,.L190
	LD HL,TEINSEITIG
	CALL PRNMSG
;2 	ELSE  	; RUECKSeite
	JP .L191
.L190:
	LD A,(USESSO)
;3 	IF A=0 	; OHNE Sso
	OR A
	JP NZ,.L192	; -> SSO
	
	; no SSO
	LD HL,TRUECKSEITe
;3 	ELSE  	; SSO
	JP .L193
.L192:
	LD HL,TRUECKSSO
;3 	ENDIF
.L193:
	CALL PRNMSG
;2 	ENDIF
.L191:
;1 	ENDIF
.L189:
	CALL CRLF 
	CALL CRLF
		; KAPAZItaet ausrechnen
	LD HL,TKAP
	CALL PRNMSG
	LD A,(SECCNT)
	LD L,A
	LD H,0
	LD A,(TRKCNT)
	LD E,A
	LD D,0
	CALL MULHLDE 	; sektoren*tracks
	LD A,(SSDS)
;1 	IF A=1
	CP 1
	JP NZ,.L194	; -> single-sided
	
	; double-sided
	LD DE,2
	CALL MULHLDE 	; wenn zweiseitig, dann doppelt
;1 	ENDIF
.L194:
	LD DE,(BYTCNT) 	; de=1024,512,256,128
		; DE=400h,200h,100h,80h
;1 	IF D=0
	LD A,D
	OR A
	JP NZ,.L195
;2 	DO B,3 	; DIV 8
	LD B,3 
.L196:
	SRA H
	RR L
;2 	ENDDO
	DEC B
	JP NZ,.L196
;1 	ELSEIF D=1
	JP .L197
.L195:
	LD A,D
	CP 1
	JP NZ,.L198
	SRA H  	; DIV 4
	RR L
	SRA H
	RR L
;1 	ELSEIF D=2
	JP .L197
.L198:
	LD A,D
	CP 2
	JP NZ,.L199
	SRA H  	; DIV 2
	RR L
;1 	ELSEIF D=4
	JP .L197
.L199:
	LD A,D
	CP 4
	JP NZ,.L200
	NOP  	; HL = KBytes
;1 	ENDIF
.L200:
.L197:
	CALL PRNTHL 	; ausgeben
	LD HL,TKAP1
	CALL PRNMSG
	CALL CRLF
	RET
	
;-----------------------------------------------------------------------------
; HL = HL * DE
; for capacity calculation

MULHLDE:
	LD A,16
	PUSH DE
	POP BC
	LD DE,0
	EX DE,HL

MULHL1:	PUSH AF
	BIT 0,E
	JP Z,MULHL2
	
	ADD HL,BC

MULHL2:	SRA H
	RR L
	RR D
	RR E
	POP AF
	DEC A
	JR NZ,MULHL1
	
	EX DE,HL 	; LSB to HL
	RET
	
;-----------------------------------------------------------------------------
; Print CR/LF

CRLF:	LD HL,TCRLF
	CALL PRNMSG
	RET

;-----------------------------------------------------------------------------

TKAP:	DEFB 'Speicherkapazitaet :  ',0

TKAP1:	DEFB ' KBytes',0

TMINI:	DEFB 'Mini-Laufwerk  ',0

TMAXI:	DEFB 'Maxi-Laufwerk  ',0

