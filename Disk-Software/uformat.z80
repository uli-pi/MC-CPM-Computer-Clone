; Sector settings menu

SETSEC:	LD A,(MINMAX)
;1 	IF A=0  	; Mini
	OR A
	JP NZ,.L137
	LD A,(DENSITY)
;2 	IF A=0 	; SD
	OR A
	JP NZ,.L138
	LD HL,MENUE5A
	CALL PRNMSG
;3 	REPEAT
.L139:
	CALL CONIN
;3 	UNTIL A IN ['1'..'3']
	CP '3'+1
	JP NC,.L139
	CP '1'+0
	JP C,.L139
.L140:
;3 	IF A='1'
	CP '1'
	JP NZ,.L141
	LD HL,128
	LD (BYTCNT),HL
	LD A,16
	LD (SECCNT),A
	LD A,27
	LD (GAPLEN),A
;3 	ELSEIF A='2'
	JP .L142
.L141:
	CP '2'
	JP NZ,.L143
	LD HL,128
	LD (BYTCNT),HL
	LD A,18
	LD (SECCNT),A
	LD A,10
	LD (GAPLEN),A
;3 	ELSEIF A='3'
	JP .L142
.L143:
	CP '3'
	JP NZ,.L144
	LD HL,256
	LD (BYTCNT),HL
	LD A,10
	LD (SECCNT),A
	LD A,16
	LD (GAPLEN),A
;3 	ENDIF
.L144:
.L142:
;2 	ELSE  	; DD
	JP .L145
.L138:
	LD HL,MENUE5B
