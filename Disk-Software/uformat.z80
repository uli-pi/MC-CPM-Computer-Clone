	LD A,15
	LD (SECCNT),A
	LD A,54
	LD (GAPLEN),A
;3 	ELSEIF A='4'
	JP .L163
.L165:
	CP '4'
	JP NZ,.L166
	LD HL,512
	LD (BYTCNT),HL
	LD A,16
	LD (SECCNT),A
	LD A,40
	LD (GAPLEN),A
;3 	ELSEIF A='5'
	JP .L163
.L166:
	CP '5'
	JP NZ,.L167
	LD HL,1024
	LD (BYTCNT),HL
	LD A,8
	LD (SECCNT),A
	LD A,54
	LD (GAPLEN),A
;3 	ELSEIF A='6'
	JP .L163
.L167:
