  755 E51C  CD E4B5     MINIR3:	CALL CALC	; BERECHNEN
  756                   
  757 E51F  79          	LD A,C
  758 E520  32 E5F4     	LD (CURDRV),A
  759 E523  7B          	LD A,E
  760 E524  32 E5F6     	LD (CURSEC),A
  761 E527  7A          	LD A,D
  762 E528  32 E5F5     	LD (CURTRK),A
  763 E52B  CD E5A7     	CALL GETBLK	; neuen Sektor lesen
  764 E52E  DA E5A3     	JP C,ERRIO	; Fehler aufgetreten
