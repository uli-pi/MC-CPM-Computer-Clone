  785 E54C  BB          	CP E
  786 E54D  C2 E57E     	JP NZ,MINIW3		; -> load
  787                   	
  788 E550              MINIW1:	; laden unnoetig, Sektor schon im Buffer
  789 E550  21 FC00     	LD HL,BLKBUF		; ADRESSE BERECHNEN
  790 E553  3A E5FC     	LD A,(IOS)		; 0..39   * 128 + BUFFER
  791 E556  E6 07       	AND 00000111B		; 0,1,2,3,4,5,6,7
  792 E558  57          	LD D,A
  793 E559  1E 00       	LD E,0			; SCHIEBEN MIT Z80 BEFS
  794 E55B  CB 2A       	SRA D			; SRA D
  795 E55D  CB 1B       	RR E			; RR E   = *256/2
  796 E55F  19          	ADD HL,DE		; +BUFFER
  797 E560  EB          	EX DE,HL		; NACH DE IST ZIEL
  798 E561  2A E5FD     	LD HL,(IOD)		; DMA ADRESSE QUELLE HIER
  799 E564  01 0080     	LD BC,128		; LAENGE ZIEL DE
  800 E567  ED B0       	LDIR
  801 E569  3E 01       	LD A,1
  802 E56B  32 E5F3     	LD (BLKCHG),A		; NUN BESCHRIEBEN
  803 E56E  3A E5F7     	LD A,(ISDIR)		; =1 dann zurueck
  804 E571  FE 01         	CP 1			; wenn Direktory Zugriff, dann
  805 E573  C2 E57C     	JP NZ,MINIW2		; gleich zurueckschreiben.
  806                   
  807 E576  CD E5C8     	CALL PUTBLK 
  808 E579  DA E5A3     	JP C,ERRIO		; falls Fehler, dann BAD SEKTOR
  809                   
  810 E57C  AF          MINIW2:	XOR A			; kein Fehler
  811 E57D  C9          	RET			; OK ENDE
  812                   
