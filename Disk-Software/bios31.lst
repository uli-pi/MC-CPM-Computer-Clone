  619                   	
  620 E49B  3A E5FB     	LD A,(IOT)	; Spur
  621 E49E  57          	LD D,A
  622                   	
  623 E49F  3A E5FC     	LD A,(IOS)	; Sektor
  624 E4A2  5F          	LD E,A
