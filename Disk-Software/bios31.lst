  468                   ;=============================================================================
  469                   ; Read and write sector using EXEC into monitor
  470                   
  471                   ; HL=DMA ADR
  472                   ; DE=TRACK/SECTOR
  473                   ; B=0 RSTORE
  474                   ;   1 READ
  475                   ;   2 WRITE
  476                   ; C=DRIVE 0...3		; bei MEXEC, EXEC
  477                   ; bei FEXEC ist C bei bestimmt.
  478                   
  479                   ;-----------------------------------------------------------------------------
  480                   ; Read sector
  481                   
  482 E400  3A E5F8     READ:	LD A,(DBANK)	; dazu Laufwerk bestimmen
  483 E403  FE 02       	CP 2		; 
  484 E405  DA E4DB     	JP C,MINIRD	; drive 0,1 -> Mini disks
  485                   	
  486 E408  FE 04       	CP 4		
  487 E40A  DA E456     	JP C,MAXIRD	; drive 2,3 -> Maxi disks
  488                   
  489                   	;---------------------------------------------------------------------
  490                   	; Read RAM disk
  491                   
  492 E40D  CD E422     	CALL ADRERZ	; hl=Quelladresse
  493 E410  EB                  EX DE,HL		; Adressumrechnung durchfuehren
  494 E411  2A E5FD             LD HL,(IOD)	; zieladresse laden
  495 E414  EB                  EX DE,HL		; und de=ziel, hl=quelle, c=bank quelle
  496 E415  06 00               LD B,0		; Ziel ist Bank 0
  497 E417  CD E5F0             CALL REXEC	; und 128 Bytes kopieren, carry=Fehler
  498 E41A  D2 E420     	JP NC,NORERR
  499                   	
  500 E41D  3E 01       	LD A,1		; Fehler da, Bank nicht vorhanden,
  501 E41F  C9          	RET		; wirkt wie BAD-Sektor
  502                   
  503                   	;---------------------------------------------------------------------
  504                   	
  505 E420  AF          NORERR:	XOR A		; sonst ok.
  506 E421  C9          	RET
  507                   
  508                   	;---------------------------------------------------------------------
  509                   	; Calculate address for ram disk, source in HL
  510                   	; SEKTOR 0..E,  TRAck 0..5fh
  511                   	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
  512 E422  3A E5FB     ADRERZ:	LD A,(IOT)		; Track holen
  513 E425  0F           	RRCA 			; und umrechnen
  514 E426  E6 0F        	AND 0FH		; unterer Teil vom MSB
  515 E428  67           	LD H,A
  516 E429  3A E5FC      	LD A,(IOS)		; dann Sektor dazu
  517 E42C  07           	RLCA
  518 E42D  07           	RLCA
  519 E42E  07           	RLCA
  520 E42F  07           	RLCA
  521 E430  E6 F0        	AND 0F0H
  522 E432  B4           	OR H
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  10
NBIOS10 Z80

  523 E433  67           	LD H,A		; damit sssstttt ok
  524 E434  3A E5FB      	LD A,(IOT)
  525 E437  0F           	RRCA			; txxxxxxx
  526 E438  E6 80        	AND 80H
  527 E43A  6F           	LD L,A		; t0000000
  528 E43B  3A E5FB      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
  529 E43E  07           	RLCA			; und dazu msb-Teil des Tracks verwenden
  530 E43F  07           	RLCA			; 0mmttttt
  531 E440  07           	RLCA			; Banknummer
  532 E441  E6 03        	AND 03H		; 000000mm
  533 E443  C6 01       	ADD A,1			; erst ab Bank 1 starten
  534 E445  47           	LD B,A		; da BANK 0=CP/M RAM und TPA
  535 E446  4F           	LD C,A		; ok beide definiert
  536 E447  C9           	RET
  537                   
  538                   ;-----------------------------------------------------------------------------
  539                     
  540                   ; Umrechnen fuer 8Zoll und neuen Floppy-Einsprung verwenden.
  541                   ; nach C laden
  542                   ; LW=2, dann Vorderseite LW 3
  543                   ; LW=3, dann Rueckseite LW 3
  544                   
  545 E448              NEUBANK:
  546 E448  3A E5F8     	LD A,(DBANK)
  547 E44B  FE 02       	CP 2
  548 E44D  C2 E453     	JP NZ,NEUB1
  549                   	
  550 E450  0E 14       	LD C,00010100b	; SD, LW=3 (8 Zoll)
  551 E452  C9          	RET
  552                   
  553 E453  0E 94       NEUB1:	LD C,10010100b	; SD, LW3= (8 Zoll), SSO = 1
  554 E455  C9          	RET
  555                   
  556                   ;-----------------------------------------------------------------------------
  557                   ; Read Maxi disk
  558                   
  559 E456  06 05       MAXIRD:	LD B,RETRY	; Anzahl der Leseversuche
  560                   
  561 E458              MAXIR1:	; retry loop
  562 E458  C5          	PUSH BC		; dann ausfuehren
  563 E459  2A E5FD     	LD HL,(IOD)	; Zieladresse holen
  564 E45C  3A E5FB     	LD A,(IOT)	; Spurnummer
  565 E45F  57          	LD D,A	
  566 E460  3A E5FC     	LD A,(IOS)	; Sektornummer
  567 E463  5F          	LD E,A
  568 E464  06 01       	LD B,1		; Lese-Befehlscode
  569 E466  CD E448     	CALL NEUBANK	; vorher Laufwerkscode umrechnen
  570 E469  CD E5E7     	CALL FEXEC	; und dann ausfuehren
  571 E46C  C1          	POP BC		; Retry-Zaehler
  572 E46D  C8          	RET Z		; kein Fehler, dann ok zurueck
  573 E46E  05          	DEC B		; sonst nochmals probieren
  574 E46F  C2 E458     	JP NZ,MAXIR1	; -> retry		
  575                   	
  576 E472  3E 01       	LD A,1		; BAD SEKTOR
  577 E474  B7          	OR A
  578 E475  C9          	RET
  579                   
  580                   ;-----------------------------------------------------------------------------
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  11
