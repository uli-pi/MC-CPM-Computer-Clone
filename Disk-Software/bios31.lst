  421                   ;-----------------------------------------------------------------------------
  422                   ; Sector translation (used by BDOS)
  423                   ; sector in C
  424                   ; skew table in DE (or 0)
  425                   
  426 E3D6  7A          SECTRAN:LD A,D		; wenn ein SKEW-Faktor verwendet wird,
  427 E3D7  B3                  OR E		; wie z.B. bei 8 Zoll ueblich.
  428 E3D8  CA E3E5             JP Z,SECTR1	; =0, -> no skew
  429                   
  430 E3DB  06 00       	LD B,0		; sonst in DE Adresse der Skew-Tabelle
  431 E3DD  EB          	EX DE,HL	; skew table -> HL
  432 E3DE  09          	ADD HL,BC	; add BC
  433 E3DF  7E          	LD A,(HL)	; load skew value
  434 E3E0  32 E5FC     	LD (IOS),A	; save in IOS 
  435 E3E3  6F          	LD L,A		; and in L
  436 E3E4  C9          	RET
  437                   
  438 E3E5              SECTR1:	; no skew
  439 E3E5  69          	LD L,C		; sonst nur einfache Wert
  440 E3E6  79                  LD A,C		; uebernehmen, ohne Umrechnung.
  441 E3E7  32 E5FC             LD (IOS),A	; auch merken
  442 E3EA  26 00               LD H,0		; se 0..255 max
  443 E3EC  C9                  RET
  444                   
  445                   ;-----------------------------------------------------------------------------
  446                   ; Set DMA address (used by BDOS)
  447                   ; address in BC
  448                   
  449 E3ED  69          SETDMA:	LD L,C
  450 E3EE  60          	LD H,B
  451 E3EF  22 E5FD     	LD (IOD),HL
  452 E3F2  C9          	RET
  453                   
