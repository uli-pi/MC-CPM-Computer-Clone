  839                   ; Read physical sector to BLKBUF
  840                   ; Mini disk only
  841                   ; TRKAKT,SEKAKT,DRVAKT ENTHALTEN NEUE BUFFERADRESSE
  842                   
  843 E5A7              GETBLK:	; reset buffer changed flag
  844 E5A7  AF          	XOR A		
  845 E5A8  32 E5F3     	LD (BLKCHG),A
  846                   	
