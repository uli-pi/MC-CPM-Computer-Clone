  639                   ;=============================================================================
  640                   ; Read Mini disk, 80 Spur, DD, DS
  641                   
  642                   ;READ und WRITE unter Verwendung von MEXEC
  643                   ; HL=DMA ADR
  644                   ; DE=TRACK/SECTOR
  645                   ; B=0 RSTORE
  646                   ;   1 READ
  647                   ;   2 WRITE
  648                   ; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
  649                   ;                                          A   C    B    D
  650                   ; 1K BUFFER IN MONITORGEBIET
  651                   ; WIRD DADURCH TEILWEISE UEBERSCHRIEBEN
  652                   ; BEI WARMBOOT MUSS BUFFER GELEERT WERDEN
  653                   ; DEBLOCK WIRD AUS SICHERHEITSGRUENDEN NICHT VERWENDET
  654                   
  655         FC00      BLKBUF	EQU 0FC00H	; Memory area of interactive Monitor for logical sector (1K)
  656                   
  657                   ;-----------------------------------------------------------------------------
  658                   ; Calculates physical drive from DBANK and IOT -> C
  659                   ; only for Mini disks 0 and 1
  660                   
  661                   ; DBANK, IOT     C
  662                   ;  0     F    -> 0
  663                   ;  1     F    -> 2
  664                   ;  0     B    -> 1
  665                   ;  1     B    -> 3
  666                   
  667                   ; muss fuer Minidisk C und D erweitert werden
  668                   
  669                   ; calculates physical sector from logical sector, IOS -> E
  670                   ; logical sector 0..39 -> physical sector 1..5
  671                   
  672                   ; calculates logical track from physical track, IOT -> D
  673                   ; 0..159 -> 0..79 (max 127)
  674                   
  675 E4B5              CALC:	; logical sector (1K) to physical sector (128 byte)
  676                   	; 0..39 -> 0..4
  677 E4B5  3A E5FC     	LD A,(IOS)	; 0..39 IST DER BEREICH (logic sector)
  678 E4B8  0F          	RRCA		; X000NNNN 0..15
  679 E4B9  0F                  RRCA
  680 E4BA  0F                  RRCA
  681 E4BB  E6 07       	AND 00000111b
  682 E4BD  3C          	INC A		; 0..4 -> 1..5
  683 E4BE  5F          	LD E,A		; save in E
  684                   
  685 E4BF  3A E5F8     	LD A,(DBANK)	; DRIVE 0->0  1->2
  686                   			; nur 0,1 SUI 4 ; und Track umrechnen , Laufwerk 0,1
  687 E4C2  FE 01       	CP 1		; 0,2,4,6,8 ist Vorderseite 1,3,5... Rueckseite
  688 E4C4  C2 E4C9     	JP NZ,CALC1
  689                   
  690                   	; DBANK=1 
  691 E4C7  3E 02       	LD A,2
  692                   	
  693 E4C9  4F          CALC1:	LD C,A		; physical drive
  694                   
  695 E4CA  3A E5FB     	LD A,(IOT)
  696 E4CD  0F          	RRCA		; Track / 2,  = Phys Track, carry=backside
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  13
NBIOS10 Z80

  697 E4CE  57          	LD D,A		; Track merken
  698 E4CF  D2 E4D6     	JP NC,CALC2	; frontside
  699                   
  700                   	; backside, track=0
  701 E4D2  79          	LD A,C
  702 E4D3  F6 01       	OR 1		; if backside: drive 0 -> drive 1,  drive 2 -> drive 3
  703 E4D5  4F          	LD C,A
  704                   	
  705 E4D6  7A          CALC2:	LD A,D
  706 E4D7  E6 7F       	AND 7FH		; Bereich Track 0..79 real
  707 E4D9  57          	LD D,A
  708                   
  709                   	; D=track=D, E=sector, c=drive
  710 E4DA  C9          	RET
  711                   	
  712                   ;-----------------------------------------------------------------------------
  713                   ; Read Mini disk
  714                   ; DBANK, IOT, IOS,
  715                   
  716 E4DB  CD E4B5     MINIRD:	CALL CALC	; calculate physical drive data for compare
  717                   
  718 E4DE  3A E5F4     	LD A,(CURDRV)
  719 E4E1  B9          	CP C		; compare drive
  720 E4E2  C2 E50F     	JP NZ,MINIR2	; -> drive not equal, load
  721                   	
  722 E4E5  3A E5F5     	LD A,(CURTRK)
  723 E4E8  BA          	CP D		; compare track
  724 E4E9  C2 E50F     	JP NZ,MINIR2	; -> track not equal, load
  725                   	
  726 E4EC  3A E5F6     	LD A,(CURSEC)
  727 E4EF  BB          	CP E		; compare sector
  728 E4F0  C2 E50F     	JP NZ,MINIR2	; -> sector not equal, load
  729                   
  730 E4F3              MINIR1:	; OK IST SCHON IN BUFFER
  731 E4F3  21 FC00     	LD HL,BLKBUF	; ADRESSE BERECHNEN
  732 E4F6  3A E5FC     	LD A,(IOS)	; 0..39 * 128 + BUFFER
  733 E4F9  E6 07       	AND 00000111b	; 0,1,2,3,4,5,6,7
  734 E4FB  57          	LD D,A
  735 E4FC  1E 00       	LD E,0		; SCHIEBEN MIT Z80 BEFS
  736 E4FE  CB 2A       	SRA D		; SRA D
  737 E500  CB 1B       	RR E		; RR E   = *256/2
  738 E502  19          	ADD HL,DE	; +BUFFER, pointer into BLKBUF
  739 E503  EB          	EX DE,HL	; NACH DE IST ZIEL
  740 E504  2A E5FD     	LD HL,(IOD)	; DMA ADRESSE QUELLE HIER
  741 E507  EB          	EX DE,HL	; ZIEL DE
  742 E508  01 0080     	LD BC,128	; logical sector length
  743 E50B  ED B0       	LDIR		; (IOD) <- (BLKBUF+Offset), 128 Byte
  744 E50D  AF          	XOR A
  745 E50E  C9          	RET
  746                   
  747 E50F              MINIR2:	; neuen Sektor laden, ggf. alten zurueckschreiben
  748 E50F  3A E5F3     	LD A,(BLKCHG)
  749 E512  B7          	OR A
  750 E513  CA E51C     	JP Z,MINIR3
  751                   
  752 E516  CD E5C8     	CALL PUTBLK	; ALTEN ZURUECKSCHREIBEN
  753 E519  DA E5A3     	JP C,ERRIO
  754                   	
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  14
