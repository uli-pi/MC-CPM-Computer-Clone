  626 E4A3  06 02       	LD B,2		; Schreib-Befehlscode
  627 E4A5  CD E448     	CALL NEUBANK	; vorher Laufwerk umrechnen
  628 E4A8  CD E5E7     	CALL FEXEC	; und ausfuehren
  629 E4AB  C1          	POP BC	
  630 E4AC  C8          	RET Z		; -> no error
  631                   	
  632 E4AD  05          	DEC B
  633 E4AE  C2 E497     	JP NZ,MAXIW1	; -> retry
  634                   	
