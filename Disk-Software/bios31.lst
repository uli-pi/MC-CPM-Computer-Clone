    1                   	;MACLIB DISKDEF1	; LOAD DEFINTION FOR DISKS
    2                   
    3                   ;*****************************************************************************
    4                   ; Version 1.0   Version 80 Spur-Laufwerk                                     *
    5                   ; gebootet wird vom 80 Spur-Laufwerk                                         *
    6                   ; A,B sind die beiden 80 Spur Laufwerke                                      *
    7                   ; C,D ist ein 8Zoll LW, C=Vorderseite,D=Ruecks.                              *
    8                   ; E ist RAM-Floppy                                                           *
    9                   ; (C) 1984 Rolf-Dieter Klein     841220                                      *
   10                   ;                                                                            *
   11                   ; 24.06.2026 *dg* Kommentare hinzugefuegt                                    *
   12                   ;                 Binaer identisch zur Origial-Version                       *
   13                   ; 30.06.2026 *dg* Komplette Ueberarbeitung, Floppy-Routinen aus dem Monitor  *
   14                   ;                 ins BIOS |ebernehmen                                       *
   15                   ;                                                                            *
   16                   ; ****************************************************************************
   17                   
   18                   ; modifiziert f|r 3,5K-Test-BIOS *dg* 30.06.2026
   19                   ; E200..EFFF		
   20                   
   21         0016      VERS	EQU 22		; CP/M version
   22         FFFF      TRUE	EQU 0FFFFH
   23         0000      FALSE	EQU NOT TRUE
   24         FFFF      TEST	EQU TRUE
   25         000D      CR	EQU 0DH		; Zeilenr|cklauf
   26         000A      LF	EQU 0AH		; Zeilenvorschub
   27                   
   28                   
   29         003A      MSIZE 	EQU 58		; Speichergroesse, hier 58K
   30                   
   31         9800      BIAS	EQU (MSIZE-20)*1024	; min=20K
   32         CC00      CCP	EQU 3400H+BIAS	; Start des CCP
   33         D406      BDOS	EQU CCP+806H	; dort beginnt das BDOS
   34         E200      BIOS	EQU CCP+1600H	; und dort das BIOS
   35                   
   36         CC00      CPMB	EQU CCP		; Start CP/M-Boot
   37                   
   38         1600      CPML	EQU BIOS-CPMB	; Laenge des CP/Ms
   39         002C      NSECTS	EQU CPML/128	; Anzahl der belegten Sektoren
   40                   
   41                   
   42         E200      	ORG BIOS	; Start of BIOS
   43                   
   44                   
   45         0004      CDISK	EQU 0004H	; address for last used drive
   46         0080      BUFF	EQU 0080H	; buffer address
   47         0005      RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write
   48                   
   49                   ;-----------------------------------------------------------------------------
   50                   
   51                   ; VEKTORTABELLE der BIOS-Einspruenge
   52                   
   53 E200  C3 E2F1     	JP BOOT	; Kalt-Start
   54                   	
   55 E203  C3 E313     WBOOTE:	JP WBOOT	; Warm-Start, bei CTRL-C
   56 E206  C3 E2E8     	JP CONST	; Consol Status, Ergebnis in A
   57 E209  C3 E2EB     	JP CONIN	; Consol Eingabe, nach A	
   58 E20C  C3 F009     	JP CONOUT	; Consol Ausgabe von C
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBIOS10 Z80

   59 E20F  C3 F00F     	JP LIST		; Ausgabe auf den Drucker, von C
   60 E212  C3 F00C     	JP PUNCH	; Ausgabe auf PO, C-Register
   61 E215  C3 F006     	JP READER	; Eingabe nach RI, A-Register
   62                   
   63 E218  C3 E3B1     	JP HOME		; Laufwerk nur Track 0
   64 E21B  C3 E3B6     	JP SELDSK	; Select drive, returns disk parameter header block in HL
   65 E21E  C3 E3CC     	JP SETTRK	; Spur auswaehlen
   66 E221  C3 E3D1     	JP SETSEC	; Sektor auswaehlen
   67 E224  C3 E3ED     	JP SETDMA	; Adresse festlegen                     
   68 E227  C3 E400     	JP READ		; Sektor lesen
   69 E22A  C3 E476     	JP WRITE	; Sektor schreiben
   70 E22D  C3 E3AE     	JP LISTST	; Drucker fertig ?
   71 E230  C3 E3D6     	JP SECTRAN	; sector translation (skew only)
   72                   
   73                   ;-----------------------------------------------------------------------------
   74                   
   75                   	; size of mini disks A and B
   76                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
   77                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
   78         0185      SIZEAB	EQU 389
   79                   
   80                   	; track offset for disk A and B
   81         0004      OFFSAB	EQU 4
   82                   
   83                   	;DISKS 5		; define 5 drives (A..E)
   84         0005      NDISKS	EQU	5	
   85                   
   86         E233      DPBASE	EQU	$		;BASE OF DISK PARAMETER BLOCKS
   87                   
   88 E233  0000  0000  DPE0:	DW	XLT0,0000H	;TRANSLATE TABLE
   89 E237  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
   90 E23B  E604  E283  	DW	DIRBUF,DPB0	;DIR BUFF,PARM BLOCK
   91 E23F  E6B5  E684  	DW	CSV0,ALV0	;CHECK, ALLOC VECTORS
   92                   	
   93 E243  0000  0000  DPE1:	DW	XLT1,0000H	;TRANSLATE TABLE
   94 E247  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
   95 E24B  E604  E283  	DW	DIRBUF,DPB1	;DIR BUFF,PARM BLOCK
   96 E24F  E726  E6F5  	DW	CSV1,ALV1	;CHECK, ALLOC VECTORS
   97                   	
   98 E253  E2A1  0000  DPE2:	DW	XLT2,0000H	;TRANSLATE TABLE
   99 E257  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  100 E25B  E604  E292  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
  101 E25F  E785  E766  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
  102                   	
  103 E263  E2A1  0000  DPE3:	DW	XLT3,0000H	;TRANSLATE TABLE
  104 E267  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  105 E26B  E604  E292  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
  106 E26F  E7B4  E795  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
  107                   	
  108 E273  0000  0000  DPE4:	DW	XLT4,0000H	;TRANSLATE TABLE
  109 E277  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  110 E27B  E604  E2BB  	DW	DIRBUF,DPB4	;DIR BUFF,PARM BLOCK
  111 E27F  E7DB  E7C4  	DW	CSV4,ALV4	;CHECK, ALLOC VECTORS
  112                   
  113                   	; Disk 0 (A) ---------------------------------------------------------
  114                   	
  115                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  116                   	; 0 = NUMMER DES LAUFWERKS
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBIOS10 Z80

  117                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  118                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  119                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  120                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  121                   	; 2048 = GROESSE EINES BLOCKS
  122                   	; SIZEAB = ZAHL DER MAX. MOEGLICHEN BLOECKE
  123                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  124                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  125                   	; OFFSAB = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  126                   
  127                   	; physical format: 3,5 inch/5.25 inch, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  128                   	; DISKDEF 0,0,39,0,2048,SIZEAB,256,256,OFFSAB
  129         E283      DPB0	EQU	$		;DISK PARM BLOCK
  130 E283  0028        	DW	40		;SEC PER TRACK
  131 E285  04          	DB	4		;BLOCK SHIFT
  132 E286  0F          	DB	15		;BLOCK MASK
  133 E287  00          	DB	0		;EXTNT MASK
  134 E288  0184        	DW	388		;DISK SIZE-1
  135 E28A  00FF        	DW	255		;DIRECTORY MAX
  136 E28C  F0          	DB	240		;ALLOC0
  137 E28D  00          	DB	0		;ALLOC1
  138 E28E  0040        	DW	64		;CHECK SIZE
  139 E290  0004        	DW	4		;OFFSET
  140         0000      XLT0	EQU	0		;NO XLATE TABLE
  141                   
  142                   	; Disk 1 (B), same as Disk A -----------------------------------------
  143                   	
  144                   	; DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
  145         E283      DPB1	EQU	DPB0	;EQUIVALENT PARAMETERS
  146                   ;ALS1	EQU	ALS0	;SAME ALLOCATION VECTOR SIZE
  147                   ;CSS1	EQU	CSS0	;SAME CHECKSUM VECTOR SIZE
  148         0000      XLT1	EQU	XLT0	;SAME TRANSLATE TABLE
  149                   
  150                   	; Disk 2 (C) --------------------------------------------------------
  151                   	; physical format: 8 inch, SD, SS, 128 bytes/sector, 26 sectors/track, 77 tracks
  152                   	; DISKDEF 2,1,26,6,1024,243,64,64,2 ; 8 ZOLL DEFINITION
  153                   	
  154         E292       DPB2	EQU	$		;DISK PARM BLOCK
  155 E292  001A         	DW	26		;SEC PER TRACK
  156 E294  03           	DB	3		;BLOCK SHIFT
  157 E295  07           	DB	7		;BLOCK MASK
  158 E296  00           	DB	0		;EXTNT MASK
  159 E297  00F2         	DW	242		;DISK SIZE-1
  160 E299  003F         	DW	63		;DIRECTORY MAX
  161 E29B  C0           	DB	192		;ALLOC0
  162 E29C  00           	DB	0		;ALLOC1
  163 E29D  0010         	DW	16		;CHECK SIZE
  164 E29F  0002         	DW	2		;OFFSET
  165                   	
  166         E2A1       XLT2	EQU	$		;TRANSLATE TABLE
  167 E2A1  01           	DB	1		
  168 E2A2  07           	DB	7		
  169 E2A3  0D           	DB	13		
  170 E2A4  13           	DB	19		
  171 E2A5  19           	DB	25		
  172 E2A6  05           	DB	5		
  173 E2A7  0B           	DB	11		
  174 E2A8  11           	DB	17		
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
NBIOS10 Z80

  175 E2A9  17           	DB	23		
  176 E2AA  03           	DB	3		
  177 E2AB  09           	DB	9		
  178 E2AC  0F           	DB	15		
  179 E2AD  15           	DB	21		
  180 E2AE  02           	DB	2		
  181 E2AF  08           	DB	8		
  182 E2B0  0E           	DB	14		
  183 E2B1  14           	DB	20		
  184 E2B2  1A            	DB	26		
  185 E2B3  06           	DB	6		
  186 E2B4  0C           	DB	12		
  187 E2B5  12           	DB	18		
  188 E2B6  18           	DB	24		
  189 E2B7  04           	DB	4		
  190 E2B8  0A           	DB	10		
  191 E2B9  10           	DB	16		
  192 E2BA  16           	DB	22	
  193                   
  194                   	; Disk 3 (D), same as Disk 2 -----------------------------------------
  195                   	; DISKDEF 3,2	; LAUFWERK 3 WIE LAUFWERK 2 DEFINIERT
  196         E292      DPB3	EQU	DPB2	;EQUIVALENT PARAMETERS
  197                   ;ALS3	EQU	ALS2	;SAME ALLOCATION VECTOR SIZE
  198                   ;CSS3	EQU	CSS2	;SAME CHECKSUM VECTOR SIZE
  199         E2A1      XLT3	EQU	XLT2	;SAME TRANSLATE TABLE
  200                   
  201                   	; Disk 4 (E), RAM Floppy 60K,120K,180K -------------------------------
  202                   	; DISKDEF 4,0,14,0,1024,180,64,64,0 ; RAM FLOPPY 60K,120K,180K
  203         E2BB      DPB4	EQU	$		;DISK PARM BLOCK
  204 E2BB  000F         	DW	15		;SEC PER TRACK
  205 E2BD  03           	DB	3		;BLOCK SHIFT
  206 E2BE  07           	DB	7		;BLOCK MASK
  207 E2BF  00           	DB	0		;EXTNT MASK
  208 E2C0  00B3         	DW	179		;DISK SIZE-1
  209 E2C2  003F         	DW	63		;DIRECTORY MAX
  210 E2C4  C0           	DB	192		;ALLOC0
  211 E2C5  00           	DB	0		;ALLOC1
  212 E2C6  0010         	DW	16		;CHECK SIZE
  213 E2C8  0000         	DW	0		;OFFSET
  214         0000      XLT4	EQU	0		;NO XLATE TABLE
  215                   
  216                   ;-----------------------------------------------------------------------------
  217                   ; CP/M message after cold start
  218                   
  219 E2CA  1A          SIGNON:	DB 26
  220 E2CB  0D 0A 57 65 	DB CR,LF,'Welcome to 58 K CP/M 2.2'
  221 E2E5  0D 0A 00    	DB CR,LF,0
  222                   
  223                   ;-----------------------------------------------------------------------------
  224                   ; Monitor routines and addresses
  225                   
  226 E2E8  C3 F012     CONST:	JP 0F012H	; DIESE ROUTINE LIEFERT DEN STATUS DER
  227                   			; EINGABETASTATUR. WURDE EIN ZEICHEN
  228                   			; EINGEGEBEN, SO LIEFERT DIE ROUTINE 0FFH. 
  229                   	
  230 E2EB  CD F003     CONIN:	CALL 0F003H	; DIE ROUTINE HOLT EIN ZEICHEN VON DER
  231                   			; TASTATUR AB UND SETZT DAS HOECHSTE BIT
  232                   			; (PARITY BIT) AUF NULL
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NBIOS10 Z80

  233 E2EE  E6 7F       	AND 7FH
  234 E2F0  C9          	RET
  235                   
  236         F01E      MON80	EQU 0F01EH	; Neustart des Monitors
  237                   
  238         F009      CONOUT	EQU 0F009H	; ROUTINE ZUR AUSGABE EINES ZEICHENS IM
  239                   			; C-REGISTER AN DIE KONSOLE. DAZU SPRUNG 
  240                   			; IN DEN MONITOR IM EPROM
  241                   
  242         F00F      LIST	EQU 0F00FH	; ADRESSE FUER DEN SPRUNG IN DIE AUSGABEROUTINE,
  243                   			; UM EIN ZEICHEN IM C-REGISTER AN DIE DRUCKER-
  244                   			; SCHNITTSTELLE ZU LIEFERN
  245                   
  246         F00C      PUNCH	EQU 0F00CH	; ADRESSE FUER DEN SPRUNG IN DIE AUSGABEROUTINE,
  247                   			; UM EIN ZEICHEN IM C-REGISTER AN DIE STANZ-
  248                   			; SCHNITTSTELLE ZU LIEFERN
  249                   
  250         F006      READER	EQU 0F006H	; ADRESSE FUER DEN SPRUNG IN DIE EINGABEROUTINE,
  251                   			; UM EIN ZEICHEN VON LESER-KANAL ZU HOLEN,
  252                   			; UND DAS ZEICHEN IM A-REGISTER ABZULIEFERN (RI)	
  253                   
  254                   ;-----------------------------------------------------------------------------
  255                   ; Cold boot
  256                   
  257 E2F1  31 0100     BOOT:	LD SP,BUFF+80H	; output start message
  258 E2F4  21 E2CA     	LD HL,SIGNON
  259 E2F7  CD E3F3     	CALL PRMSG
  260                   	
  261                   	; clear last used drive
  262 E2FA  AF          	XOR A
  263 E2FB  32 0004     	LD (CDISK),A
  264                   	
  265                   	; sector buffer is empty, set to BLKBUF not changed
  266 E2FE  AF          	XOR A
  267 E2FF  32 E5F3     	LD (BLKCHG),A
  268                   	
  269                   	; drive is undefined
  270 E302  3E FF       	LD A,0FFH
  271 E304  32 E5F4     	LD (CURDRV),A
  272                   
  273                   	; disable monitor entries, set to WBOOT
  274 E307  21 E313     	LD HL,WBOOT
  275 E30A  22 F034     	LD (0F033H+1),HL
  276 E30D  22 F037     	LD (0F036H+1),HL
  277 E310  C3 E36C     	JP GOCPM	; start CP/M
  278                   
  279                   ;-----------------------------------------------------------------------------
  280                   ; Warm boot
  281                   
  282 E313              WBOOT:	; write BLKBUF to disk if changed
  283 E313  3A E5F3     	LD A,(BLKCHG)
  284 E316  B7          	OR A
  285 E317  CA E31D     	JP Z,WBOO1
  286                   	
  287 E31A  CD E5C8     	CALL PUTBLK	; normalerweise ist Schreibvorgang
  288                   			; nach einem Direktoryzugriff abgeschlossen
  289                   			; ACHTUNG BUG!? PUTBLK nur f|r Mini/DD-Laufwerke
  290                   			; Bei einem anderen Laufwerk geht das wohl schief
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   6
NBIOS10 Z80

  291                   			
  292 E31D  3E FF       WBOO1:	LD A,0FFH	; alle Tracks ungueltig, bei Diskettenwechsel wichtig
  293 E31F  32 E5F4     	LD (CURDRV),A
  294                   
  295 E322  31 0080     	LD SP,BUFF	; Stack zuweisen
  296 E325  0E 05       	LD C,RETRY	; Anzahl der Versuche
  297 E327  C5          	PUSH BC		; und dann anfangen zu booten
  298                   
  299 E328              WBOO2:	; loop
  300 E328  01 CC00     	LD BC,CPMB	; Boot von MINI-Diskette
  301 E32B  CD E3ED     	CALL SETDMA	; auf der Startadresse des CP/Ms
  302 E32E  0E 00       	LD C,0		; Laufwerk A
  303 E330  CD E3B6     	CALL SELDSK	; auswaehlen
  304 E333  0E 00       	LD C,0		; Track 0
  305 E335  CD E3CC     	CALL SETTRK	; und den zweiten phys. Sektor, (Nr 8 logisch)
  306 E338  0E 08       	LD C,8		; enstpricht Nr 2 bei 1024 Bytes
  307 E33A  CD E3D1     	CALL SETSEC	; wichtig, da andere Zaehlweise
  308 E33D  C1          	POP BC		; und von da an n Sektoren einlesen
  309 E33E  06 2C       	LD B,NSECTS	; aber das BIOS nicht ueberschreiben
  310                   			; damit Patches leicht moeglich sind
  311                   
  312 E340              WBOO3:	; sector read loop
  313 E340  C5          	PUSH BC		; Anzahl merken
  314 E341  CD E400     	CALL READ	; LESEN ausfuehren
  315 E344  C2 E396     	JP NZ,BOOTERR	; Fehler: defekter Sektor
  316                   	
  317 E347  2A E5FD     	LD HL,(IOD)	; Zieladresse laden
  318 E34A  11 0080     	LD DE,128	; um logische Sektorgroesser erhoehen
  319 E34D  19          	ADD HL,DE			; dazu addieren,
  320 E34E  22 E5FD     	LD (IOD),HL	; und dann wieder zurueckspeichern.
  321 E351  3A E5FC     	LD A,(IOS)	; Sektor laden
  322 E354  FE 27       	CP 39		; Mini 0..39 Sektoren a 128 Bytes
  323 E356  DA E363     	JP C,WBOO4	; solange auf der gleichen Spur bleiben
  324                   
  325                   	; next track
  326 E359  3A E5FB     	LD A,(IOT)	; Dann neue Spur anwaehlen,
  327 E35C  3C          	INC A	  	; jedoch im Verfahren 0,2,...
  328 E35D  3C          	INC A		; SPUR 0, dann SPUR 2, wegen BOOT.ASM
  329 E35E  32 E5FB     	LD (IOT),A	; denn 1,3,5 ist die Rueckseite des Laufwerks
  330 E361  3E FF       	LD A,0FFH	; 0,1,2,3.... nach Increment A=0
  331                   	
  332 E363  3C          WBOO4:	INC A		; dann 0
  333 E364  32 E5FC     	LD (IOS),A	; und auch neuesn Sektor anwaehlen
  334 E367  C1          	POP BC		; Schleifenzaehler zuruech
  335 E368  05          	DEC B		; und immer weiter lesen
  336 E369  C2 E340     	JP NZ,WBOO3	; -> read next sector
  337                   	
  338                   	;---------------------------------------------------------------------
  339                   
  340 E36C  01 0080     GOCPM:	LD BC,BUFF	; Buffer auf Default einstellen
  341 E36F  CD E3ED     	CALL SETDMA	; so wie es CP/M braucht
  342 E372  3E C3       	LD A,0C3H	; Sprung auf den WARM-Boot im
  343 E374  32 0000     	LD (0),A	; RAM ablegen.
  344 E377  21 E203     	LD HL,WBOOTE	; Warm-Boot-Adresse
  345 E37A  22 0001     	LD (1),HL	; nicht vergessen
  346 E37D  32 0005     	LD (5),A	; Sprung auf die BDOS-CALL-Adresse
  347 E380  21 D406     	LD HL,BDOS	; legen und auch das Ziel
  348 E383  22 0006     	LD (6),HL	; dorthin
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   7
NBIOS10 Z80

  349 E386  32 0038     	LD (7*8),A	; RST7 definieren, default ist Monitor
  350 E389  21 F01E     	LD HL,MON80	; der aber normalerweise kurzgeschl. ist.
  351 E38C  22 0039     	LD (7*8+1),HL		
  352 E38F  3A 0004     	LD A,(CDISK)	; das zuletzt verwendete Laufwerk
  353 E392  4F          	LD C,A		; laden und damit selektieren.
  354 E393  C3 CC00     	JP CPMB
  355                   
  356 E396              BOOTERR:		; im Fehlerfalle, bei BAD-Sektor.
  357 E396  C1          	POP BC		; erst mal nocheinmal versuchen
  358 E397  0D          	DEC C
  359 E398  CA E39F     	JP Z,BOOTE0	; bis hoffnungslos, dann Fehlermeldung
  360                   	
  361 E39B  C5          	PUSH BC
  362 E39C  C3 E328     	JP WBOO2	; -> try again
  363                   
  364 E39F              BOOTE0:	; Fehlermeldung ausgeben und Monitor neu starten, bzw. WBOOT
  365 E39F  21 E3A8     	LD HL,ERRMSG
  366 E3A2  CD E3F3     	CALL PRMSG
  367 E3A5  C3 F01E     	JP MON80
  368                   
  369 E3A8              ERRMSG:	; Fehlermeldung
  370 E3A8  3F 42 4F 4F 	DB '?BOOT',0
  371                   
  372                   ;-----------------------------------------------------------------------------
  373                   ; List status (used by BDOS)
  374                   ; LST state, not used
  375                   
  376 E3AE  00          LISTST:	NOP
  377 E3AF  AF          	XOR A		; ggf. hier Sprung einbauen.
  378 E3B0  C9          	RET
  379                   
  380                   ;-----------------------------------------------------------------------------
  381                   ; Home drive (used by BDOS)
  382                   
  383 E3B1  0E 00       HOME:	LD C,0		; aber nur anwaehlen, nicht
  384 E3B3  C3 E3CC     	JP SETTRK	; ausfuehren
  385                   
  386                   ;-----------------------------------------------------------------------------
  387                   ; Select disk (used by BDOS)
  388                   ; drive-code in C (0..3)
  389                   
  390 E3B6  21 0000     SELDSK:	LD HL,0		; und pruefen ob gueltig
  391 E3B9  79          	LD A,C		; wenn groesser als ndisks
  392 E3BA  FE 05       	CP NDISKS	; dann nicht ok
  393 E3BC  D0          	RET NC		; Nummer 0 bis n-1 erscheint in A
  394 E3BD  32 E5F8     	LD (DBANK),A	; dann zusaetzlich die
  395 E3C0  69          	LD L,C		; Laufwerkstabelle ausrechnen
  396 E3C1  26 00       	LD H,0		; dazu Nummer mit 16 multiplizieren
  397 E3C3  29          	ADD HL,HL	
  398 E3C4  29          	ADD HL,HL	
  399 E3C5  29          	ADD HL,HL	
  400 E3C6  29          	ADD HL,HL	
  401 E3C7  11 E233     	LD DE,DPBASE	; und Basisadresse drauf addieren.
  402 E3CA  19          	ADD HL,DE
  403 E3CB  C9          	RET
