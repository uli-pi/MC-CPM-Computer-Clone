  773                   
  774 E538  CD E4B5     	CALL CALC		; calculate physical drive data for compare
  775                   	
  776 E53B  3A E5F4     	LD A,(CURDRV)		; und wie bei minird
  777 E53E  B9          	CP C			;
  778 E53F  C2 E57E     	JP NZ,MINIW3		; -> load
  779                   	
  780 E542  3A E5F5     	LD A,(CURTRK)
