  600                   
  601 E483  CD E422     	CALL ADRERZ	; hl=Quelladresse
  602 E486  EB                  EX DE,HL	; umrechnen
  603 E487  2A E5FD             LD HL,(IOD)	; ziel in BANK hl=Quelle diesmal
  604 E48A  0E 00               LD C,0		; Quelle ist Bank 0, b=Ziel, de=Ziel
  605 E48C  CD E5F0             CALL REXEC	; und 128 Bytes kopieren, carry=Fehler
  606 E48F  D2 E420     	JP NC,NORERR	; OK Bank war da, sonst
  607                   	
  608 E492  3E 01       	LD A,1		; Fehler ausgeben
  609 E494  C9          	RET
  610                   
