  581                   ; Write sector using EXEC into monitor
  582                   
  583                   ; HL=DMA ADR
  584                   ; DE=TRACK/SECTOR
  585                   ; B=0 RSTORE
  586                   ;   1 READ
  587                   ;   2 WRITE
  588                   ; C=DRIVE 0...3		; bei MEXEC, EXEC
  589                   ; bei FEXEC ist C bei bestimmt.
  590                   
  591 E476  3A E5F8     WRITE:	LD A,(DBANK)	; dazu Laufwerkscode laden
  592 E479  FE 02       	CP 2		; und Floppy-Typ bestimmen
  593 E47B  DA E534     	JP C,MINIWR	; drive 0,1 -> Mini disks
  594                   	
  595 E47E  FE 04       	CP 4		; drive 2,3 -> Maxi disks
  596 E480  DA E495     	JP C,MAXIWR
