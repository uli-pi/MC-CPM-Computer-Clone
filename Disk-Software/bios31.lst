  456                   
  457 E3F3  7E          PRMSG: 	LD A,(HL)
  458 E3F4  B7          	OR A
  459 E3F5  C8          	RET Z		; -> end of text
  460                   	
  461 E3F6  E5          	PUSH HL
  462 E3F7  4F          	LD C,A
  463 E3F8  CD F009     	CALL CONOUT
  464 E3FB  E1          	POP HL
