  233 0241  32 18C1     	LD (TRKCNT),A
  234                   
  235 0244  C9          ECMAC2:	RET
  236                   
  237                   ;-----------------------------------------------------------------------------
  238                   ; General error check routine
  239                   
  240                   ; error code in A
  241                   ;   bit 2 = CPU to slow
  242                   ;   bit 3 = CRC error
  243                   ;   bit 4 = record not found
  244                   ;   bit 5 = wrong record type
  245                   ;   bit 6 = write protected
  246                   
  247 0245  B7          ERRCHK:	OR A
  248 0246  C8          	RET Z  	; =0? -> Status ok
  249                   	
  250                   	; TRACK, Spur ausgeben
  251 0247  F5          	PUSH AF 	; save error code
  252 0248  21 1721     	LD HL,TKMSG
  253 024B  CD 0B99     	CALL PRNMSG
  254 024E  3A 18C7     	LD A,(CURTRK)
  255 0251  6F          	LD L,A
  256 0252  26 00       	LD H,0 
  257 0254  CD 02AE     	CALL PRNTHL
  258 0257  21 172C     	LD HL,SKMSG
  259 025A  CD 0B99     	CALL PRNMSG
  260 025D  3A 18C8     	LD A,(CURSEC)
  261 0260  6F          	LD L,A
  262 0261  26 00       	LD H,0
  263 0263  CD 02AE     	CALL PRNTHL
  264 0266  CD 0D50     	CALL CRLF
  265                   
  266 0269  F1          	POP AF  	; restore error code
  267                   	
  268                   	; check bit 2
  269 026A  CB 57       	BIT 2,A
  270 026C  21 16ED     	LD HL,F0MSG 	; error message
  271 026F  CA 0275     	JP Z,ERRC1	; -> bit 2 not set
  272                   	
  273                   	; bit 2, CPU too slow
  274 0272  21 167B     	LD HL,F2MSG
  275                   
  276 0275              ERRC1:	; check bit 3
  277 0275  CB 5F       	BIT 3,A
  278 0277  CA 027D     	JP Z,ERRC2	; -> bit 3 not set
  279                   
  280                   	; bit 3, CRC errror
  281 027A  21 1643     	LD HL,F3MSG
  282                   
  283 027D              ERRC2:	; check bit 4
  284 027D  CB 67       	BIT 4,A
  285 027F  CA 0285     	JP Z,ERRC3	; -> bit 4 not set
  286                   	
  287                   	; bit 4, record not found
  288 0282  21 160C     	LD HL,F4MSG
  289                   	
  290 0285              ERRC3:	; check bit 5
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   6
UFORMAT Z80

  291 0285  CB 6F       	BIT 5,A
  292 0287  CA 028D     	JP Z,ERRC4	; -> bit 5 not set
  293                   
  294                   	; bit 5, wrong record type
  295 028A  21 15D5     	LD HL,F5MSG
  296                   
  297 028D              ERRC4:	; check bit 6
  298 028D  CB 77       	BIT 6,A
  299 028F  CA 0295     	JP Z,ERRC5	; -> bit 6 not set
  300                   
  301                   	; bit 6, write protected
  302 0292  21 159E     	LD HL,F6MSG
  303                   	
  304 0295              ERRC5:	; check bit 7
  305 0295  CA 029B     	JP Z,ERRC6
  306                   	
  307                   	; bit 7, write protected
  308 0298  21 159E     	LD HL,F6MSG 	; dominant is write proteced error
  309                   
  310 029B  CD 0B99     ERRC6:	CALL PRNMSG
